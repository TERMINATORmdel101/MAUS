<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Product>MAUS</Product>
    <Description>MAUS : audit, réparation et optimisation transparente de Windows 11.</Description>
    <Copyright>Contributeurs de MAUS. Licence GPL-3.0-only.</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Version>0.5.1</Version>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <!-- Permet de compiler depuis Linux (sessions cloud) ; sans effet sous Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
