                                        <TextBox Text="{Binding Workshop.LatencyStatus, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="{x:Static app:Ui.LatencyTitle}" />
