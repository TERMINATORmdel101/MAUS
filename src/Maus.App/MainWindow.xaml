                                        <TextBlock Text="{x:Static app:Ui.UsbTestIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.DriveLabel}" MinWidth="240" Margin="0,0,12,4" ItemsSource="{Binding Workshop.RemovableDrives}" SelectedItem="{Binding Workshop.RemovableDrive}" DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4" Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartUsbCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        </WrapPanel>
                                        <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" Height="6" Margin="0,8,0,0" Maximum="100" Visibility="{Binding Workshop.UsbProgress, Converter={StaticResource PositiveToVisibility}}" Value="{Binding Workshop.UsbProgress, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.UsbStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowCpuTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowCpuTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelAqua}" BorderBrush="{DynamicResource PastelAquaStroke}">
                                    <StackPanel>
                                        <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.CoolingTestTitle}" Content="&#xE9CA;" Tag="{DynamicResource PastelAquaStroke}" Foreground="{DynamicResource PastelAquaInk}" />
                                        <TextBlock Text="{x:Static app:Ui.CoolingTestIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartCoolingCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.CoolingStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowGpuTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowGpuTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
