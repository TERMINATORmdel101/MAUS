                                    </StackPanel>
                                </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowDeviceTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowDeviceTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                    <StackPanel>
