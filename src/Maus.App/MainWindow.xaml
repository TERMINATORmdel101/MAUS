                                        <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartCombinedCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.CombinedStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

