<Window x:Class="Maus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:vm="clr-namespace:Maus.App.ViewModels"
        Title="{x:Static app:Ui.WindowTitle}"
        Width="1120" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/maus.ico">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <ComboBox DockPanel.Dock="Right" VerticalAlignment="Top" MinWidth="120"
                      ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding LanguageChoice}" DisplayMemberPath="Label"
                      AutomationProperties.Name="Language / Langue / Idioma" ToolTip="Language · Langue · Idioma" />
        <StackPanel>
            <Image Source="/Assets/maus-banner.png" Height="96" HorizontalAlignment="Left" Margin="0,0,0,6"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="MAUS" />
            <TextBlock Text="{x:Static app:Ui.Tagline}"
                       FontSize="14" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SystemSummary}" FontSize="13" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        </DockPanel>

        <!-- Lancement -->
        <DockPanel Grid.Row="1" Margin="0,16,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="{x:Static app:Ui.RunAudit}" Padding="18,8"
                    Command="{Binding RunAuditCommand}" />
            <ProgressBar DockPanel.Dock="Right" Width="180" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                         Maximum="{Binding ModuleCount, Mode=OneWay}" Value="{Binding Completed, Mode=OneWay}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <TabControl Grid.Row="2">
            <!-- Onglet 1 : modules et constats -->
            <TabItem Header="{x:Static app:Ui.TabFindings}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
                                <DockPanel Margin="2,6">
                                    <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Margin="0,4,10,0" VerticalAlignment="Top"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedModule.Header}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedModule.Summary}" Opacity="0.75" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding SelectedModule.Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                                        <Border Margin="0,0,0,10" Padding="14,10" CornerRadius="6" BorderThickness="4,1,1,1"
                                                BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Values}" FontSize="12" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Explanation}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Advice}" Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                                                           Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                    <Button Content="{x:Static app:Ui.Wanted}" Padding="10,2" FontSize="12"
                                                            ToolTip="{x:Static app:Ui.WantedTip}"
                                                            Command="{Binding AcknowledgeCommand}"
                                                            Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="{x:Static app:Ui.ReportAgain}" Padding="10,2" FontSize="12"
                                                            Command="{Binding UnacknowledgeCommand}"
                                                            Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                        </Grid>
            </TabItem>

            <!-- Onglet 2 : corrections proposées -->
            <TabItem Header="{x:Static app:Ui.TabFixes}">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding ChangesSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Border Padding="12,8" Margin="0,0,0,8" CornerRadius="6" BorderThickness="4,1,1,1" BorderBrush="#C42B1C"
                                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BlockingReason}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="{x:Static app:Ui.OneClickProfiles}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                                        <Button Content="{Binding Name}" ToolTip="{Binding Description}" Command="{Binding Command}"
                                                Padding="12,4" Margin="0,0,8,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <Expander Header="{x:Static app:Ui.YourChoices}" Margin="0,0,0,8" IsExpanded="True"
                                  Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Static app:Ui.GameBarProfile}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <ComboBox Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding GameBarOptions}" SelectedItem="{Binding GameBarChoice}" DisplayMemberPath="Label" />
                                <TextBlock Grid.Row="1" Text="{x:Static app:Ui.LaptopPower}" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding LaptopOptions}" SelectedItem="{Binding LaptopChoice}" DisplayMemberPath="Label"
                                          Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Expander>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <CheckBox Content="{x:Static app:Ui.CreateRestorePoint}"
                                  IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,4" />
                        <CheckBox Content="{x:Static app:Ui.EnableProtection}"
                                  IsChecked="{Binding EnableProtection}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="{Binding ApplyLabel}" Padding="18,8"
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply, Mode=OneWay}" />
                            <TextBlock Text="{x:Static app:Ui.VerifyNote}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
                        </DockPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{x:Static app:Ui.SaveReport}" Padding="12,4" Margin="0,0,8,0" Command="{Binding SaveReportCommand}"
                                    IsEnabled="{Binding HasAudit, Mode=OneWay}"
                                    ToolTip="{x:Static app:Ui.SaveReportTip}" />
                            <Button Content="{x:Static app:Ui.RestartExplorer}" Padding="12,4" Command="{Binding RestartExplorerCommand}"
                                    Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{x:Static app:Ui.RestartExplorerTip}" />
                        </WrapPanel>
                        <Border Padding="12,8" Margin="0,10,0,0" CornerRadius="6" BorderThickness="1" BorderBrush="#808080"
                                Visibility="{Binding HasFixReport, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding FixReport, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Changes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChangeViewModel}">
                                    <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6" BorderThickness="1" BorderBrush="#808080">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Badges}" FontSize="12" Opacity="0.7" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Gain}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasGain, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Risk}" Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                                                           Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Warning}" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="#C42B1C" TextWrapping="Wrap"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                <Expander Header="{x:Static app:Ui.TechnicalDetails}" Margin="0,4,0,0">
                                                    <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                </Expander>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Onglet 3 : historique et annulation -->
            <TabItem Header="{x:Static app:Ui.TabHistory}">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.Refresh}" Padding="12,4" Command="{Binding RefreshJournalCommand}" />
                        <TextBlock Text="{Binding JournalSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                                    <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6" BorderThickness="1" BorderBrush="#808080">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.RevertSession}" Padding="12,4"
                                                        Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert, Mode=OneWay}" />
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <Expander Header="{x:Static app:Ui.SessionChanges}" Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Changes}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SessionChangeViewModel}">
                                                            <DockPanel Margin="0,0,0,8">
                                                                <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.Revert}" Padding="10,2" FontSize="12" VerticalAlignment="Top"
                                                                        Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert, Mode=OneWay}" />
                                                                <StackPanel Margin="0,0,10,0">
                                                                    <TextBlock TextWrapping="Wrap">
                                                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                        <Run Text="  ·  " />
                                                                        <Run Text="{Binding State, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#C46A00" TextWrapping="Wrap"
                                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Pied de page : transparence sur la fabrication -->
        <TextBlock Grid.Row="3" Text="{Binding About}" FontSize="11" Opacity="0.6" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
