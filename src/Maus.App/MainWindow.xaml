<Window x:Class="Maus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:appearance="clr-namespace:Maus.App.Appearance"
        xmlns:controls="clr-namespace:Maus.App.Controls"
        xmlns:views="clr-namespace:Maus.App.Views"
        xmlns:follow="clr-namespace:Maus.App.Views.Follow"
        xmlns:vm="clr-namespace:Maus.App.ViewModels"
        xmlns:ws="clr-namespace:Maus.App.ViewModels.Workshop"
        Title="{x:Static app:Ui.WindowTitle}"
        Width="1240" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
        <!-- Cellule de texte d'un tableau : centrée dans sa ligne, comme les cellules à gabarit, et jamais coupée. -->
        <Style x:Key="GridCell" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Carte d'un constat (onglet Constats, par importance comme par module) : fond pastel et bord de la couleur du verdict. -->
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TwoColumns">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ThreeColumns">
            <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
        <!-- Alarmes des capteurs et ligne de timing : les mêmes sur plusieurs pages. -->
        <DataTemplate x:Key="SensorAlarms">
            <StackPanel>
                <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.Live.Alarms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausGold}">
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Static app:Ui.AlarmMarginsNote}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Visibility="{Binding Workshop.Live.HasSensorAlarms, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <!-- Bandeau « le PC a gelé au dernier test » : accueil et page de l'Atelier. La marge et la visibilité sont sur le ContentControl. -->
        <DataTemplate x:Key="CrashNotice">
            <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausRed}" Margin="0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.Understood}" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center"
                            Command="{Binding Workshop.DismissCrashCommand}" />
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Ui.CrashTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Workshop.CrashNotice}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimingRow" DataType="{x:Type ws:TimingRowViewModel}">
            <DockPanel Margin="0,1" ToolTip="{Binding Hint}" Background="Transparent">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="StepChip" DataType="{x:Type vm:JourneyStepRow}">
            <controls:AccessibleGroup AutomationProperties.Name="{Binding AccessibleName}">
            <Border Style="{StaticResource Chip}" Padding="8,2" Margin="0,0,6,4"
                    Background="{Binding Tone, Converter={StaticResource Pastel}}"
                    BorderBrush="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Stroke}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeNote}" Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                    <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                </StackPanel>
            </Border>
            </controls:AccessibleGroup>
            </DataTemplate>
        <DataTemplate x:Key="ChangeCard" DataType="{x:Type vm:ChangeViewModel}">
                                    <Grid Margin="0,0,0,8" appearance:Motion.EnterOnLoad="True">
                                    <Border Style="{StaticResource SoftCard}" Padding="14,10"
                                            Background="{Binding Tone, Converter={StaticResource Pastel}}"
                                            BorderBrush="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title, Mode=OneWay}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Badges}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Margin="12,1,0,0"
                                                               Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Group}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Risk}" Margin="0,4,0,0" FontStyle="Italic" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Warning}" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource PastelRoseInk}"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding ComeBackNote}" Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                                                           Visibility="{Binding HasComeBack, Converter={StaticResource BoolToVisibility}}" />
                                                <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.MoreDetails}" Margin="0,6,0,0"
                                                          IsExpanded="{Binding Source={x:Static vm:DisplayMode.Current}, Path=IsTechnician, Mode=OneWay}">
<StackPanel>
                                                <TextBlock Text="{Binding Gain}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}"
                                                           Visibility="{Binding HasGain, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
</StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <!-- Correction choisie depuis un constat : entourée de la couleur d'accentuation. -->
                                    <Border BorderThickness="2" CornerRadius="14" BorderBrush="{DynamicResource MausAccent}" IsHitTestVisible="False" appearance:Motion.BringIntoViewWhen="{Binding IsHighlighted}"
                                            Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
        <DataTemplate x:Key="FindingCard" DataType="{x:Type vm:FindingViewModel}">
            <Border appearance:Motion.Lively="True" appearance:Motion.EnterOnLoad="True" appearance:Motion.HoverLift="True" Margin="0,0,0,10" Padding="16,12" CornerRadius="12" BorderThickness="5,1,1,1"
                    Background="{Binding Status, Converter={StaticResource Pastel}}"
                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}">
                <StackPanel>
                    <TextBlock Text="{Binding Module}" FontSize="{StaticResource FontSizeNote}" FontWeight="SemiBold" Margin="0,0,0,2"
                               Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}"
                               Visibility="{Binding HasModule, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Top" BorderThickness="1" ToolTip="{Binding StatusHelp}"
                                BorderBrush="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,5,0" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" TextWrapping="Wrap" />
                    </DockPanel>
                    <!-- D'abord pourquoi ça compte, en langage courant ; le reste (valeurs, identifiant) sous « Détails techniques ». -->
                    <TextBlock Text="{x:Static app:Ui.WhyItMatters}" FontSize="{StaticResource FontSizeNote}" FontWeight="SemiBold" Margin="0,8,0,0"
                               Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}"
                               Visibility="{Binding ShowWhy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock controls:Glossary.Text="{Binding Explanation}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock controls:Glossary.Text="{Binding Advice}" Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                               Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ScreenOnlyNote}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasScreenOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                    <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6" BorderThickness="1"
                            Background="{Binding CalloutStatus, Converter={StaticResource Pastel}}"
                            BorderBrush="{Binding CalloutStatus, Converter={StaticResource Pastel}, ConverterParameter=Stroke}"
                            Visibility="{Binding HasCallout, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock controls:Glossary.Text="{Binding Callout}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenWebPage}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    ToolTip="{Binding CalloutLink, Mode=OneWay}" Command="{Binding OpenCalloutLinkCommand}"
                                    Visibility="{Binding HasCalloutLink, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding HasSideNote, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SideNote}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenWebPage}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                ToolTip="{Binding SideNoteLink, Mode=OneWay}" Command="{Binding OpenSideNoteLinkCommand}"
                                Visibility="{Binding HasSideNoteLink, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.TechnicalDetails}" Margin="0,6,0,0" Content="{Binding}"
                              IsExpanded="{Binding Source={x:Static vm:DisplayMode.Current}, Path=IsTechnician, Mode=OneWay}">
                        <Expander.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Values}" FontSize="{StaticResource FontSizeSmall}" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap"
                                               Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding AlsoIn}" FontSize="{StaticResource FontSizeSmall}" FontStyle="Italic" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}"
                                               Visibility="{Binding HasAlsoIn, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Identity}" FontSize="{StaticResource FontSizeSmall}" Opacity="{DynamicResource MutedOpacity}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ThresholdNote}" FontSize="{StaticResource FontSizeSmall}" Opacity="{DynamicResource MutedOpacity}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasThresholdNote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </Expander.ContentTemplate>
                    </Expander>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.FixThis}" Padding="14,4" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,6,0"
                                ToolTip="{x:Static app:Ui.FixThisTip}" Command="{Binding FixCommand}"
                                Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.TryMaxRefresh}" Padding="14,4" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,6,0"
                                ToolTip="{x:Static app:Ui.TryMaxRefreshTip}" Command="{Binding TryRefreshCommand}"
                                Visibility="{Binding CanTryRefresh, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenWebPage}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,6,0"
                                ToolTip="{Binding Link, Mode=OneWay}" Command="{Binding OpenLinkCommand}"
                                Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenInWindows}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,6,0"
                                Command="{Binding OpenSettingsPageCommand}"
                                Visibility="{Binding HasSettingsPage, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.Wanted}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}"
                                ToolTip="{x:Static app:Ui.WantedTip}"
                                Command="{Binding AcknowledgeCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}"
                                Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.ReportAgain}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}"
                                Command="{Binding UnacknowledgeCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}"
                                Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <!-- Raccourcis clavier (0.8.4) : Ctrl+1 à Ctrl+7 ouvrent les sept parties, dans l'ordre de la barre de gauche. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding GoToCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding GoToCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding GoToCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding GoToCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding GoToCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding GoToCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding GoToCommand}" CommandParameter="6" />
        <KeyBinding Modifiers="Control" Key="NumPad1" Command="{Binding GoToCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Control" Key="NumPad2" Command="{Binding GoToCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="NumPad3" Command="{Binding GoToCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="NumPad4" Command="{Binding GoToCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Control" Key="NumPad5" Command="{Binding GoToCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Control" Key="NumPad6" Command="{Binding GoToCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Control" Key="NumPad7" Command="{Binding GoToCommand}" CommandParameter="6" />
    </Window.InputBindings>

    <!-- Navigation à gauche (logo, parties, langue) ; la partie choisie s'affiche à droite. -->
    <Grid>
    <controls:PageTabControl Style="{DynamicResource {x:Type TabControl}}" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0" appearance:Motion.AnimateSelection="True">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Barre de navigation, légèrement teintée de la couleur d'accentuation (et de celle de la carte graphique). -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                        <Border Background="{DynamicResource MausSidebarTint}" Padding="14,16">
                            <DockPanel>
                                <!-- Logo du porteur, recadré sur les lettres (jamais redessiné) : coins arrondis et ombre légère pour qu'il se pose
                                     sur la barre, puis les quatre couleurs des lettres et ce que veut dire le nom. -->
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                                    <Border Height="100" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/maus-banner.png" Stretch="UniformToFill" />
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" />
                                        </Border.Effect>
                                    </Border>
                                    <UniformGrid Rows="1" Height="3" Margin="10,10,10,0">
                                        <Border Background="{StaticResource MausBlue}" CornerRadius="1.5" Margin="0,0,3,0" />
                                        <Border Background="{StaticResource MausRed}" CornerRadius="1.5" Margin="0,0,3,0" />
                                        <Border Background="{StaticResource MausGreen}" CornerRadius="1.5" Margin="0,0,3,0" />
                                        <Border Background="{StaticResource MausGold}" CornerRadius="1.5" />
                                    </UniformGrid>
                                </StackPanel>
                                <!-- Place réservée aux réglages du bas (langue, surveillance, paramètres), posés hors du gabarit
                                     pour rester accessibles aux lecteurs d'écran : voir la fin de la fenêtre. -->
                                <Border DockPanel.Dock="Bottom" Height="84" />
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel IsItemsHost="True" />
                        </ScrollViewer>
                                    <!-- Marque de la partie choisie : elle glisse d'une entrée à l'autre. -->
                                    <Border x:Name="PART_NavMark" HorizontalAlignment="Left" VerticalAlignment="Top" Width="3" Height="20" CornerRadius="1.5" Margin="-6,0,0,0"
                                            Background="{DynamicResource MausAccent}" IsHitTestVisible="False" Visibility="Hidden" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Border>
                    <DockPanel Grid.Column="1" Margin="28,22,28,12">
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding About}" FontSize="{StaticResource FontSizeNote}" Opacity="{DynamicResource MutedOpacity}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <!-- Mode limité (demande du porteur, 29/10/2026) : les options qui ont besoin des droits administrateur sont
                             grisées ; « Toutes les fonctionnalités » lance le moteur, avec la demande d'autorisation de Windows. -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Padding="14,10" CornerRadius="12" BorderThickness="1" ToolTip="{x:Static app:Ui.TipLimitedMode}"
                                Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}"
                                Visibility="{Binding Source={x:Static vm:ElevationState.Current}, Path=ShowLimitedBanner, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.EnableAllFeatures}" Padding="14,4" ToolTip="{x:Static app:Ui.TipAllFeatures}"
                                        appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=CanEnable, Mode=OneWay}"
                                        Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{x:Static app:Ui.EnableAllFeatures}"
                                        Command="{Binding Source={x:Static vm:ElevationState.Current}, Path=EnableAllCommand}" />
                                <ProgressBar DockPanel.Dock="Bottom" AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                             Visibility="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsEnabling, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Source={x:Static vm:ElevationState.Current}, Path=LimitedText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource PastelSandInk}" />
                            </DockPanel>
                        </Border>
                        <!-- Droits ouverts par le moteur : discret, mais dit, et refermable sans fermer MAUS. -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Padding="14,6" CornerRadius="12" BorderThickness="1" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}"
                                Visibility="{Binding Source={x:Static vm:ElevationState.Current}, Path=ShowFullBanner, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.CloseRights}" ToolTip="{x:Static app:Ui.CloseRightsTip}" Padding="12,3" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding Source={x:Static vm:ElevationState.Current}, Path=CloseRightsCommand}" />
                                <TextBlock Text="{Binding Source={x:Static vm:ElevationState.Current}, Path=FullText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" />
                            </DockPanel>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </DockPanel>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <!-- Accueil : score de santé, familles M·A·U·S et actions rapides -->
        <TabItem Style="{StaticResource NavTab}" AutomationProperties.AcceleratorKey="Ctrl+1" AutomationProperties.Name="{x:Static app:Ui.NavHome}" Header="{x:Static app:Ui.NavHome}" Tag="&#xE80F;" Background="{StaticResource MausBlue}">
            <ScrollViewer controls:PageScroll.Enabled="True" appearance:Motion.Ambient="True" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CrashNotice}" Focusable="False" Margin="0,12,0,0"
                                    Visibility="{Binding Workshop.HasCrashNotice, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Windows a changé de version depuis le dernier audit (0.8.6). -->
                    <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}"
                            Visibility="{Binding HasBuildNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BuildNotice}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>

                    <!-- Alerte de l'audit de la semaine restée sans réponse (0.8.6). -->
                    <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}"
                            Visibility="{Binding HasMissedAlert, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MissedAlert}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>

                    <!-- Tâche de la semaine d'une version précédente (dossier du Store, ou droits administrateur) : seul ce bouton la remet en place (0.8.6). -->
                    <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}"
                            Visibility="{Binding IsScheduleOutdated, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.ScheduleMove}" Command="{Binding MoveScheduleCommand}" Padding="16,5" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScheduleOutdatedText}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Quoi de neuf (0.8.4) : en carte après une mise à jour, plus en fenêtre ; « Compris » la ferme. -->
                    <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}"
                            appearance:Motion.EnterOnLoad="True" Visibility="{Binding ShowWhatsNew, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top">
                                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.WhatsNewClose}" Command="{Binding DismissWhatsNewCommand}" Padding="16,5" Margin="0,0,0,8" />
                                <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.WhatsNewAll}" Command="{Binding OpenWhatsNewPageCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding WhatsNewTitle}" FontSize="{StaticResource FontSizeCardTitle}" FontWeight="SemiBold" Foreground="{DynamicResource PastelLilacInk}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding WhatsNewLines}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" Foreground="{DynamicResource PastelLilacInk}" />
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Score -->
                        <Border Style="{StaticResource Card}" ToolTip="{x:Static app:Ui.TipScore}">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Width="168" Height="168" HorizontalAlignment="Center">
                                    <!-- Score d'un audit passé : anneau gris, jamais la couleur d'un état actuel. -->
                                    <controls:RingGauge Value="{Binding DisplayedScore, Mode=OneWay}" Thickness="16" Halo="True">
                                        <controls:RingGauge.Style>
                                            <Style TargetType="controls:RingGauge">
                                                <Setter Property="Stroke" Value="{Binding Score, Converter={StaticResource ScoreToBrush}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPastScore, Mode=OneWay}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource MausGrey}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:RingGauge.Style>
                                    </controls:RingGauge>
                                    <!-- Pendant l'audit, un arc tourne autour du score. -->
                                    <controls:RingGauge Value="14" Thickness="16" Track="Transparent" Stroke="{DynamicResource MausAccent}" IsHitTestVisible="False"
                                                        appearance:Motion.Spin="{Binding IsRunning, Mode=OneWay}"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock appearance:Motion.RollingText="{Binding ScoreText}" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <!-- Avant le premier audit : couleur du texte du thème (suit un changement de thème) ; ensuite, couleur du score. -->
                                        <TextBlock Text="{Binding ScoreWord}" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasScore, Mode=OneWay}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding Score, Converter={StaticResource ScoreToBrush}, ConverterParameter=Ink}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{x:Static app:Ui.HealthCaption}" FontSize="{StaticResource FontSizeNote}" Opacity="{DynamicResource MutedOpacity}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <!-- Après des corrections : l'anneau avance et la différence s'affiche. -->
                                <TextBlock Text="{Binding ScoreDeltaText}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource PastelMintInk}"
                                           appearance:Motion.EnterWhen="{Binding HasScoreDelta, Mode=OneWay}"
                                           Visibility="{Binding HasScoreDelta, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Tout est vert : les quatre lettres s'allument l'une après l'autre, une seule fois. -->
                                <controls:AccessibleGroup HorizontalAlignment="Center" Margin="0,10,0,0" ToolTip="{x:Static app:Ui.AllGreen}" AutomationProperties.Name="{x:Static app:Ui.AllGreen}"
                                            Visibility="{Binding IsAllGreen, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" appearance:Motion.EnterWhen="{Binding IsAllGreen, Mode=OneWay}">
                                    <controls:LetterTile Width="24" Height="24" Margin="2,0" Text="M" Fill="{Binding Source='M', Converter={StaticResource LetterToBrush}}" />
                                    <controls:LetterTile Width="24" Height="24" Margin="2,0" Text="A" Fill="{Binding Source='A', Converter={StaticResource LetterToBrush}}" />
                                    <controls:LetterTile Width="24" Height="24" Margin="2,0" Text="U" Fill="{Binding Source='U', Converter={StaticResource LetterToBrush}}" />
                                    <controls:LetterTile Width="24" Height="24" Margin="2,0" Text="S" Fill="{Binding Source='S', Converter={StaticResource LetterToBrush}}" />
                                </StackPanel>
                                </controls:AccessibleGroup>
                                <TextBlock Text="{Binding ScoreDetail}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding PriorityMergedNote}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" TextAlignment="Center" Margin="0,0,0,6"
                                           Visibility="{Binding HasPriorityMergedNote, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Score partiel : un module en erreur ou en délai dépassé n'a rien lu, le score ne compte que le reste. -->
                                <TextBlock Text="{Binding ScorePartialNote}" Style="{StaticResource MausText}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="{Binding IsScorePartial, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.ScoreWhy}" Command="{Binding ShowScoreDetailCommand}" HorizontalAlignment="Center" Margin="0,0,0,8"
                                        Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Quoi faire d'abord : les corrections qui rapportent le plus de points. -->
                                <StackPanel Margin="0,0,0,8" Visibility="{Binding HasBestFixes, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Static app:Ui.BestFixesTitle}" ToolTip="{x:Static app:Ui.BestFixesTip}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Style="{StaticResource MausText}" Margin="0,0,0,2" />
                                    <ItemsControl Focusable="False" ItemsSource="{Binding BestFixes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BestFixRow}">
                                                <DockPanel Margin="0,3">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.FixThis}" Padding="10,2" FontSize="{StaticResource FontSizeSmall}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Command="{Binding Fix}" AutomationProperties.Name="{Binding Title}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Gain}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasHealthTrend, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding HealthTrendText}">
                                    <controls:Sparkline Height="28" Values="{Binding HealthTrend, Mode=OneWay}" Maximum="100" Stroke="{StaticResource MausGreen}" />
                                    <TextBlock Text="{Binding HealthTrendText}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <!-- Prochaine étape : l'audit d'abord, puis, dès qu'il est fini, les corrections (demande du porteur). -->
                            <Border Style="{StaticResource SoftCard}" Padding="22,18"
                                    Background="{Binding NextStepTone, Converter={StaticResource Pastel}}"
                                    BorderBrush="{Binding NextStepTone, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                <StackPanel>
                                    <TextBlock Text="{Binding NextStepTitle}" FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{Binding NextStepTone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                    <TextBlock Text="{Binding NextStepText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                                    <!-- Parcours « première fois » (0.8.6) : trois étapes, la courante en avant, les faites cochées. -->
                                    <ItemsControl Focusable="False" ItemsSource="{Binding JourneySteps}" Margin="0,0,0,10" AutomationProperties.Name="{x:Static app:Ui.JourneyTitle}"
                                                  Visibility="{Binding ShowJourney, Converter={StaticResource BoolToVisibility}}" ItemTemplate="{StaticResource StepChip}" ItemsPanel="{StaticResource WrapItems}" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding FixNowLabel}" Command="{Binding GoToCommand}" CommandParameter="2" Margin="0,0,10,6"
                                                Visibility="{Binding ShowFixNowButton, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding HomeAuditLabel}" Command="{Binding RunAuditCommand}" Margin="0,0,10,6"
                                                Visibility="{Binding IsFirstAudit, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.SeeFindings}" Command="{Binding GoToCommand}" CommandParameter="1" Margin="0,0,10,6"
                                                Visibility="{Binding ShowReadFindingsButton, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.SeeFindings}" Command="{Binding GoToCommand}" CommandParameter="1" Margin="0,0,10,6"
                                                Visibility="{Binding ShowSeeFindingsButton, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource SoftButton}" Content="{Binding HomeAuditLabel}" Command="{Binding RunAuditCommand}" Margin="0,0,10,6"
                                                Visibility="{Binding ShowRerunButton, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                    <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" Height="4" Margin="0,8,0,0" Maximum="{Binding ModuleCount, Mode=OneWay}" Value="{Binding Completed, Mode=OneWay}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <!-- Squelette pendant l'audit (0.8.6) : un module par ligne avec son état, et le temps écoulé. -->
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Modules}" Margin="0,8,0,0" AutomationProperties.Name="{x:Static app:Ui.AuditProgressList}"
                                                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
                                                <DockPanel Margin="0,2,12,2" ToolTip="{Binding AuditStateLabel}">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding AuditStateIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               appearance:Motion.EnterWhen="{Binding IsAuditDone, Mode=OneWay}"
                                                               AutomationProperties.Name="{Binding AuditStateLabel}" />
                                                    <TextBlock Text="{Binding Header}" FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding AuditElapsedText}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Dernier audit gardé (0.8.6), en gris et daté : ce n'est pas l'état actuel. Les explications ne sont pas gardées. -->
                            <Border Style="{StaticResource SoftCard}" Margin="0,10,0,0" Padding="16,12"
                                    Background="{DynamicResource PastelGrey}" BorderBrush="{StaticResource MausGrey}"
                                    Visibility="{Binding ShowLastAudit, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LastAuditTitle}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Static app:Ui.LastAuditNotCurrent}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                    <TextBlock Text="{Binding LastAuditScore}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LastAuditCounts}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                    <ItemsControl Focusable="False" ItemsSource="{Binding LastAuditRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LastAuditRow}">
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding State}" FontSize="{StaticResource FontSizeNote}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding LastAuditMore}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}"
                                               Visibility="{Binding HasLastAuditMore, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- Accueil simple : une ligne compacte (lettre et points à voir) ; un clic ouvre les Constats. -->
                            <ItemsControl Focusable="False" ItemsSource="{Binding Families}" Margin="-4,10,-4,0" AutomationProperties.Name="{x:Static app:Ui.FamiliesLine}"
                                          Visibility="{Binding IsHomeSimple, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:FittingGrid MinItemWidth="160" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FamilyViewModel}">
                                        <Button Style="{StaticResource ActionCard}" Margin="4" Padding="10,8"
                                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="1"
                                                AutomationProperties.Name="{Binding CompactLabel}" ToolTip="{Binding Description}"
                                                Background="{Binding Letter, Converter={StaticResource Pastel}}"
                                                BorderBrush="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                            <DockPanel>
                                                <controls:LetterTile DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                     Text="{Binding Letter}" Fill="{Binding Letter, Converter={StaticResource LetterToBrush}}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                    <TextBlock Text="{Binding CompactText}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{Binding CompactTone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Familles M·A·U·S, en tuiles pastel (accueil complet) -->
                            <ItemsControl Focusable="False" ItemsSource="{Binding Families}" Margin="-5,10,-5,0"
                                          Visibility="{Binding IsHomeComplete, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FamilyViewModel}">
                                        <Border Style="{StaticResource SoftCard}" Margin="5" Padding="14,12"
                                                Background="{Binding Letter, Converter={StaticResource Pastel}}"
                                                BorderBrush="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                            <DockPanel>
                                                <controls:LetterTile DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top"
                                                                     Text="{Binding Letter}" Fill="{Binding Letter, Converter={StaticResource LetterToBrush}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLead}" FontWeight="SemiBold"
                                                               Foreground="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                                                    <ItemsControl Focusable="False" ItemsSource="{Binding Chips}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ChipViewModel}">
                                                                <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                                        Background="{Binding Tone, Converter={StaticResource Pastel}}"
                                                                        BorderBrush="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}">
                                                                    <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                                               Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Votre PC en un coup d'œil (0.8.4) : ce que l'audit a lu, avec la couleur des constats qui le concernent. -->
                            <Border Style="{StaticResource SoftCard}" Margin="0,10,0,0" Padding="16,12"
                                    Visibility="{Binding HasGlance, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.GlanceTitle}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Glance}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GlanceItem}">
                                                <controls:AccessibleGroup AutomationProperties.Name="{Binding AccessibleName}">
                                                <DockPanel Margin="0,4,12,4">
                                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Top"
                                                            Background="{Binding Tone, Converter={StaticResource Pastel}}"
                                                            BorderBrush="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" BorderThickness="1">
                                                        <TextBlock Style="{StaticResource NavIcon}" Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" />
                                                        <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding StateIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                       Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                            <TextBlock Text="{Binding State}" FontSize="{StaticResource FontSizeNote}"
                                                                       Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                                </controls:AccessibleGroup>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Accueil complet : état des pilotes graphiques en une ligne, lu dans le dernier audit. -->
                            <Border Style="{StaticResource SoftCard}" Margin="0,10,0,0" Padding="16,10"
                                    Visibility="{Binding ShowDriverCard, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenWebPage}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding DriverPage, Mode=OneWay}" Command="{Binding OpenDriverPageCommand}"
                                            Visibility="{Binding HasDriverPage, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding DriverLine}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Outils : quatre cartes, le reste en boutons -->
                    <TextBlock Text="{x:Static app:Ui.HomeTools}" Style="{StaticResource ZoneTitle}" Margin="0,22,0,4" />
                    <UniformGrid Columns="{Binding ToolColumns}" Margin="-6,0,-6,0">
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding SlowPcCommand}"
                                Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}" AutomationProperties.Name="{x:Static app:Ui.SlowPcTitle}" AutomationProperties.HelpText="{x:Static app:Ui.SlowPcDetail}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xEC4A;" Foreground="{DynamicResource PastelSandInk}" />
                                <TextBlock Text="{x:Static app:Ui.SlowPcTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.SlowPcDetail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding GoToCommand}" CommandParameter="33"
                                Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}" AutomationProperties.Name="{x:Static app:Ui.TestPcTitle}" AutomationProperties.HelpText="{x:Static app:Ui.TestPcDetail}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE9D9;" Foreground="{DynamicResource PastelRoseInk}" />
                                <TextBlock Text="{x:Static app:Ui.TestPcTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.TestPcDetail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding GoToCommand}" CommandParameter="30"
                                Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}" AutomationProperties.Name="{x:Static app:Ui.MyPcTitle}" AutomationProperties.HelpText="{x:Static app:Ui.MyPcDetail}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE950;" Foreground="{DynamicResource PastelBlueInk}" />
                                <TextBlock Text="{x:Static app:Ui.MyPcTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.MyPcDetail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding HelpSummaryCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding HasAudit, Mode=OneWay}"
                                Visibility="{Binding IsHomeComplete, Converter={StaticResource BoolToVisibility}}"
                                Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}" AutomationProperties.Name="{x:Static app:Ui.HelpTitle}" AutomationProperties.HelpText="{x:Static app:Ui.HelpDetail}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE897;" Foreground="{DynamicResource PastelMintInk}" />
                                <TextBlock Text="{x:Static app:Ui.HelpTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.HelpDetail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsHomeComplete, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Command="{Binding GoToCommand}" CommandParameter="5" ToolTip="{x:Static app:Ui.BenchmarkSubtitle}"
                                Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}" AutomationProperties.Name="{x:Static app:Ui.NavBenchmark}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7FC;" Foreground="{DynamicResource PastelRoseInk}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static app:Ui.NavBenchmark}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Command="{Binding GoToCommand}" CommandParameter="31" ToolTip="{x:Static app:Ui.LiveDetail}"
                                Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" AutomationProperties.Name="{x:Static app:Ui.LiveTitle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9D2;" Foreground="{DynamicResource PastelLilacInk}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static app:Ui.LiveTitle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Command="{Binding GoToCommand}" CommandParameter="34" ToolTip="{x:Static app:Ui.SpaceDetail}"
                                Background="{DynamicResource PastelAqua}" BorderBrush="{DynamicResource PastelAquaStroke}" AutomationProperties.Name="{x:Static app:Ui.SpaceTitle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xEDA2;" Foreground="{DynamicResource PastelAquaInk}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static app:Ui.SpaceTitle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Command="{Binding SaveReportCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding HasAudit, Mode=OneWay}" ToolTip="{x:Static app:Ui.ReportDetail}"
                                Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}" AutomationProperties.Name="{x:Static app:Ui.ReportTitle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" Foreground="{DynamicResource PastelSandInk}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static app:Ui.ReportTitle}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <!-- Accueil simple : « Que se passe-t-il ? » (0.8.6), chaque ligne ouvre un outil qui existe déjà ; ce n'est pas un diagnostic.
                         Benchmark : barre de gauche ; En direct : Atelier ; rapport : Corrections. Les autres sont dans la liste. -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsHomeSimple, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static app:Ui.SymptomsTitle}" Style="{StaticResource ZoneTitle}" Margin="0,0,0,4" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding Symptoms}" AutomationProperties.Name="{x:Static app:Ui.SymptomsTitle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SymptomRow}">
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding ActionLabel}" Command="{Binding Action}" Padding="12,3" FontSize="{StaticResource FontSizeSmall}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding AccessibleName}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Onglet 1 : modules et constats -->
        <TabItem Style="{StaticResource NavTab}" AutomationProperties.AcceleratorKey="Ctrl+2" AutomationProperties.Name="{x:Static app:Ui.TabFindings}" Header="{x:Static app:Ui.TabFindings}" Tag="&#xE9D9;" Background="{StaticResource MausRed}">
            <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding FixNowLabel}" Command="{Binding GoToCommand}" CommandParameter="2" Margin="12,0,0,0"
                        Visibility="{Binding HasProposedChanges, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Left" Content="{Binding HomeAuditLabel}" Command="{Binding RunAuditCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAudit, Mode=OneWay}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource MausAccentStrong}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MausAccentStrong}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" DockPanel.Dock="Right" Width="160" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                             Maximum="{Binding ModuleCount, Mode=OneWay}" Value="{Binding Completed, Mode=OneWay}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>

            <!-- Deux façons de lire l'audit : par importance (par défaut) ou module par module.
                 Jamais de GroupName dans cette fenêtre : un même nom de groupe relie aussi la fenêtre recréée par un changement de langue à celle qu'elle remplace, tant que leurs onglets sont fermés. Sans nom, le groupe est le panneau parent. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton Style="{StaticResource Segment}" Content="{x:Static app:Ui.ByImportance}" IsChecked="{Binding ShowByImportance}" />
                <RadioButton Style="{StaticResource Segment}" Content="{x:Static app:Ui.ByModule}" IsChecked="{Binding ShowByModule}" />
            </StackPanel>

            <Grid>
                <!-- Par importance : ce qui demande une action, du plus grave au plus léger ; le reste à la demande. -->
                <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowByImportance, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}"
                                Visibility="{Binding IsFirstAudit, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0" VerticalAlignment="Center"
                                        Background="{DynamicResource PastelBlueStroke}">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeMetric}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PastelBlueInk}" AutomationProperties.Name="{x:Static app:Ui.NoAuditIllustration}" />
                                </Border>
                                <TextBlock Text="{x:Static app:Ui.FindingsBeforeAudit}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <!-- Ce qui a changé depuis un audit précédent (0.8.6). -->
                        <Expander Header="{Binding ComparisonTitle}" IsExpanded="{Binding IsComparisonOpen}" Margin="0,0,0,8"
                                  Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,8,0,0">
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.CompareWith}" ToolTip="{x:Static app:Ui.CompareWith}" MinWidth="260" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          ItemsSource="{Binding ComparisonOptions}" SelectedItem="{Binding ComparisonChoice}" DisplayMemberPath="Label" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding AuditChanges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AuditChangeRow}">
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeSmall}" Margin="0,2,8,0"
                                                           Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Avant une mise à jour (0.8.6) : quand Windows Update propose quelque chose. -->
                        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}" Margin="0,0,0,10"
                                Visibility="{Binding ShowReadiness, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static app:Ui.ReadinessTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.ReadinessIntro}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding ReadinessRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ReadinessRow}">
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding ActionLabel}" Padding="10,2" FontSize="{StaticResource FontSizeSmall}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Target}"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeSmall}" Margin="0,2,8,0"
                                                           Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Choix des modules audités (0.8.6) : choix protégé, grisé sans droits. -->
                        <Expander Header="{Binding ModulesChoiceLabel}" Margin="0,0,0,8" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{x:Static app:Ui.ModulesChoiceNote}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding Modules}" ItemsPanel="{StaticResource TwoColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
                                            <CheckBox Content="{Binding Header}" IsChecked="{Binding IsAudited}" Margin="0,2,12,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <DockPanel Margin="0,0,0,10" Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Left" Text="{x:Static app:Ui.FindingSearchLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding FindingSearch, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" HorizontalAlignment="Left" MinWidth="260"
                                     ToolTip="{x:Static app:Ui.FindingSearchTip}" AutomationProperties.Name="{x:Static app:Ui.FindingSearchLabel}" />
                        </DockPanel>
                        <TextBlock Text="{x:Static app:Ui.FindingSearchEmpty}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding FindingSearchFindsNothing, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PriorityTitle}" Style="{StaticResource ZoneTitle}" Foreground="{DynamicResource PastelRoseInk}"
                                   Visibility="{Binding HasPriorityFindings, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PriorityMergedNote}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,8"
                                   Visibility="{Binding HasPriorityMergedNote, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel Margin="0,0,0,10" Visibility="{Binding HasPriorityFindings, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.FindingFilterLabel}" ToolTip="{x:Static app:Ui.FindingFilterLabel}" MinWidth="260" Margin="0,0,8,4"
                                      ItemsSource="{Binding FindingFilterOptions}" SelectedItem="{Binding FindingFilterChoice}" DisplayMemberPath="Label" />
                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.FamilyFilterLabel}" ToolTip="{x:Static app:Ui.FamilyFilterLabel}" MinWidth="180" Margin="0,0,8,4"
                                      ItemsSource="{Binding FamilyFilterOptions}" SelectedItem="{Binding FamilyFilterChoice}" DisplayMemberPath="Label" />
                        </WrapPanel>
                        <TextBlock Text="{x:Static app:Ui.FilterHidesAll}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding FilterHidesAll, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}" Margin="0,0,0,4"
                                Visibility="{Binding ShowNothingToHandle, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0" VerticalAlignment="Center"
                                        Background="{DynamicResource PastelMintStroke}">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeMetric}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PastelMintInk}" AutomationProperties.Name="{x:Static app:Ui.AllGoodIllustration}" />
                                </Border>
                                <TextBlock Text="{x:Static app:Ui.NothingToHandle}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PastelMintInk}" />
                            </DockPanel>
                        </Border>
                        <!-- Tout n'a pas pu être lu : même phrase, limitée à ce qui a été lu, sans le vert qui rassure. -->
                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,4"
                                Visibility="{Binding ShowNothingToHandleInRead, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static app:Ui.NothingToHandleInRead}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}" Margin="0,0,0,10"
                                Visibility="{Binding ShowOnlyOptionalLeft, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static app:Ui.OnlyOptionalLeft}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource PastelMintInk}" />
                        </Border>
                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10"
                                Visibility="{Binding ShowOnlyOptionalLeftInRead, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static app:Ui.OnlyOptionalLeftInRead}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>
                        <ItemsControl Focusable="False" ItemsSource="{Binding PriorityFindings}" ItemTemplate="{StaticResource FindingCard}" />
                        <Border Style="{StaticResource Divider}" Visibility="{Binding HasOtherFindings, Converter={StaticResource BoolToVisibility}}" />
                        <Expander Header="{Binding OthersLabel}" IsExpanded="{Binding ShowOthers}" Margin="0,0,0,8"
                                  Visibility="{Binding HasOtherFindings, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl Focusable="False" ItemsSource="{Binding OtherFindings}" ItemTemplate="{StaticResource FindingCard}" Margin="0,10,0,0" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Par module : la liste des modules à gauche, les constats du module choisi à droite (conformes masqués). -->
                <Grid Visibility="{Binding ShowByModule, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" AutomationProperties.Name="{x:Static app:Ui.ByModule}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
                                <DockPanel Margin="2,6">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeBody}" Margin="0,2,10,0" VerticalAlignment="Top"
                                               ToolTip="{Binding StatusLabel}" AutomationProperties.Name="{Binding StatusLabel}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeSmall}" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer controls:PageScroll.Enabled="True" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedModule.Header}" FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedModule.Summary}" Opacity="{DynamicResource MutedOpacity}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <DockPanel Margin="0,0,0,12">
                                <CheckBox DockPanel.Dock="Right" Content="{x:Static app:Ui.ShowConforming}" IsChecked="{Binding ShowConforming}" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding HiddenConformingNote}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl Focusable="False" ItemsSource="{Binding SelectedModuleFindings}" ItemTemplate="{StaticResource FindingCard}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </DockPanel>
        </TabItem>

        <!-- Onglet 2 : corrections proposées -->
        <TabItem Style="{StaticResource NavTab}" AutomationProperties.AcceleratorKey="Ctrl+3" AutomationProperties.Name="{x:Static app:Ui.TabFixes}" Header="{x:Static app:Ui.TabFixes}" Tag="&#xE90F;" Background="{StaticResource MausGreen}">
            <DockPanel>
                <!-- Haut : ce qui est proposé et les profils en un clic. -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource ZoneTitle}" />
                    <Border Style="{StaticResource SoftCard}" Padding="14,10" Margin="0,0,0,10" BorderThickness="5,1,1,1"
                            Background="{DynamicResource PastelRose}" BorderBrush="{StaticResource MausRed}"
                            Visibility="{Binding ShowBlockingBanner, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BlockingReason}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                    <WrapPanel Margin="0,0,0,4" Visibility="{Binding HasProposedChanges, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static app:Ui.OneClickProfiles}" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding Profiles}" ItemsPanel="{StaticResource WrapItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                                    <Button Style="{StaticResource SoftButton}" Content="{Binding Name}" ToolTip="{Binding Description}" Command="{Binding Command}"
                                            Margin="0,0,8,6" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </StackPanel>

                <!-- Bas, toujours visible : les réponses de la page ; appliquer la sélection seulement quand il y a de quoi cocher. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SoftCard}" Margin="0,12,0,0" Padding="16,12"
                        Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                    <StackPanel>
                        <DockPanel appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}" Visibility="{Binding HasProposedChanges, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="{Binding ApplyLabel}" VerticalAlignment="Center"
                                    Command="{Binding ApplyCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding CanApply, Mode=OneWay}" />
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,2">
                                    <TextBlock Text="{x:Static app:Ui.CreateRestorePoint}" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding EnableProtection}">
                                    <TextBlock Text="{x:Static app:Ui.EnableProtection}" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{x:Static app:Ui.VerifyNote}" FontSize="{StaticResource FontSizeSmall}" Margin="0,8,0,0" Style="{StaticResource Muted}"
                                   Visibility="{Binding HasProposedChanges, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding ApplySteps}" ItemTemplate="{StaticResource StepChip}" ItemsPanel="{StaticResource WrapItems}" Margin="0,8,0,0"
                                      AutomationProperties.Name="{x:Static app:Ui.ApplyStepsTitle}"
                                      Visibility="{Binding ShowApplySteps, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Réponses des boutons et des choix de cette page (winget, rapport, audit automatique) : visibles ici aussi. -->
                        <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontSizeSmall}" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                        <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" IsIndeterminate="True" Height="4" Margin="0,6,0,0" Visibility="{Binding IsCheckingSoftware, Converter={StaticResource BoolToVisibility}}" />
                                <UniformGrid Rows="1" Height="72" Margin="0,8,0,0" Visibility="{Binding IsCheckingSoftware, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                </UniformGrid>
                        <Border Padding="12,8" Margin="0,8,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource PastelMintStroke}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="{Binding HasFixReport, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding FixReport, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Centre : la liste des corrections, rangées par module sous des titres repliables, puis, séparés par une barre,
                     les outils, vos choix et l'honnêteté sur les gains. -->
                <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel.Resources>
                            <CollectionViewSource x:Key="GroupedChanges" Source="{Binding MoreChanges}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Group" />
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausGold}"
                                Visibility="{Binding HasRestartPending, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding RestartPendingNote}" TextWrapping="Wrap" />
                        </Border>
                        <Button Style="{StaticResource SoftButton}" Content="{Binding RecheckComeBackLabel}" Command="{Binding RecheckComeBackCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8"
                                Visibility="{Binding HasComeBackChanges, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Les corrections recommandées, à plat : rien à ouvrir (demande du porteur du 1/11/2026 : ne pas charger la page). -->
                        <ItemsControl Focusable="False" ItemsSource="{Binding ImportantChanges}" ItemTemplate="{StaticResource ChangeCard}" />
                        <!-- Le reste est au choix : un simple lien, jamais en gros. -->
                        <Expander Style="{StaticResource QuietExpander}" Header="{Binding MoreChangesLabel}" IsExpanded="{Binding ShowMoreChanges}" Margin="0,4,0,8"
                                  Visibility="{Binding HasMoreChanges, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl Focusable="False" ItemsSource="{Binding Source={StaticResource GroupedChanges}}" ItemTemplate="{StaticResource ChangeCard}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,6" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>
                        </Expander>

                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.RestartExplorer}" Margin="0,4,0,6" HorizontalAlignment="Left" Command="{Binding RestartExplorerCommand}"
                                    Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static app:Ui.RestartExplorerTip}"
                                    Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}" />
                        <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.FixesMoreTools}" Margin="0,4,0,8">
                            <StackPanel>
<TextBlock Text="{x:Static app:Ui.OtherTools}" Style="{StaticResource ZoneTitle}" Foreground="{DynamicResource PastelLilacInk}" />
                        <WrapPanel>
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.SaveReport}" Margin="0,0,8,6" Command="{Binding SaveReportCommand}"
                                    appearance:WhyDisabled.Explain="True" IsEnabled="{Binding HasAudit, Mode=OneWay}" ToolTip="{x:Static app:Ui.SaveReportTip}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.RepairWindows}" Margin="0,0,8,6" Command="{Binding RepairWindowsCommand}"
                                    ToolTip="{x:Static app:Ui.RepairWindowsTip}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.UpdateSoftware}" Margin="0,0,8,6" Command="{Binding UpdateSoftwareCommand}"
                                    ToolTip="{x:Static app:Ui.UpdateSoftwareTip}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.DriverUpdates}" Margin="0,0,8,6" Command="{Binding Workshop.OpenDriverUpdatesCommand}"
                                    ToolTip="{x:Static app:Ui.DriverUpdatesTip}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="{x:Static app:Ui.YourChoices}" Style="{StaticResource ZoneTitle}" Foreground="{DynamicResource PastelAquaInk}" />
                            <Grid appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Static app:Ui.GameBarProfile}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.GameBarProfile}" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding GameBarOptions}" SelectedItem="{Binding GameBarChoice}" DisplayMemberPath="Label" />
                                <TextBlock Grid.Row="1" Text="{x:Static app:Ui.LaptopPower}" VerticalAlignment="Center" Margin="0,0,12,6"
                                           Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.LaptopPower}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding LaptopOptions}" SelectedItem="{Binding LaptopChoice}" DisplayMemberPath="Label"
                                          Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="2" Text="{x:Static app:Ui.WeeklyAudit}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.WeeklyAudit}" Grid.Row="2" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding ScheduleChoice}" DisplayMemberPath="Label"
                                          ToolTip="{x:Static app:Ui.WeeklyAuditTip}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ScheduleNotice}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource PastelSandInk}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,6,0,0"
                                           Visibility="{Binding HasScheduleNotice, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="3" Text="{x:Static app:Ui.WeeklyNotificationLabel}" VerticalAlignment="Center" Margin="0,6,12,0" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.WeeklyNotificationLabel}" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding WeeklyNotificationOptions}" SelectedItem="{Binding WeeklyNotificationChoice}" DisplayMemberPath="Label" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />
                        <Expander Header="{x:Static app:Ui.HonestTitle}" Margin="0,0,0,8">
                            <Border Style="{StaticResource SoftCard}" Margin="0,8,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.HonestWindows}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestHardware}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestOverclock}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestSecurity}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestWarning}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Expander Header="{Binding MythsTitle}" Margin="0,0,0,8">
                            <ItemsControl Focusable="False" ItemsSource="{Binding Myths}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MythViewModel}">
                                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,8" Padding="14,10" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.SeeSource}" ToolTip="{Binding Source}"
                                                        Command="{Binding OpenSourceCommand}" VerticalAlignment="Top" Margin="12,0,0,0" FontSize="{StaticResource FontSizeSmall}" Padding="12,3"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Claim}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource PastelLilacInk}" />
                                                    <TextBlock Text="{Binding Truth}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- Atelier : Mon PC, En direct, Processus, Tests -->
        <TabItem Style="{StaticResource NavTab}" AutomationProperties.AcceleratorKey="Ctrl+4" AutomationProperties.Name="{x:Static app:Ui.NavWorkshop}" Header="{x:Static app:Ui.NavWorkshop}" Tag="&#xE950;" Background="{StaticResource MausGold}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="{x:Static app:Ui.NavWorkshop}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{x:Static app:Ui.WorkshopSubtitle}" Style="{StaticResource Muted}" />
                </StackPanel>
                <!-- Trois entrées (0.8.6), puis les sections de l'entrée choisie ; « Tests » n'en a qu'une. Hors du gabarit de la
                     liste des sections : les lecteurs d'écran ne voient pas ce qui est posé dans un gabarit. -->
                <TabControl DockPanel.Dock="Top" SelectedIndex="{Binding Workshop.Group}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
                            AutomationProperties.Name="{x:Static app:Ui.NavWorkshop}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="{x:Static app:Ui.SectionPc}" Style="{StaticResource PillTab}" />
                    <TabItem Header="{x:Static app:Ui.LiveTitle}" Style="{StaticResource PillTab}" />
                    <TabItem Header="{x:Static app:Ui.SectionTests}" Style="{StaticResource PillTab}" />
                </TabControl>
                <TabControl SelectedIndex="{Binding Workshop.Section}" Background="Transparent" BorderThickness="0" Padding="0" appearance:Motion.AnimateSelection="True">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,14" />
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- Mon PC : fiche d'identité du matériel -->
                    <TabItem Header="{x:Static app:Ui.SectionSheet}" Style="{StaticResource SubPillTab}" Visibility="{Binding Workshop.ShowPcSections, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.CopySheet}" ToolTip="{x:Static app:Ui.CopySheetTip}"
                                            Command="{Binding Workshop.CopyInventoryCommand}" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Workshop.InventoryStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" IsIndeterminate="True" Height="4" Margin="0,0,0,10" Visibility="{Binding Workshop.IsReadingInventory, Converter={StaticResource BoolToVisibility}}" />
                                <UniformGrid Rows="1" Height="72" Margin="0,8,0,0" Visibility="{Binding Workshop.IsReadingInventory, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                </UniformGrid>
                                <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.Components}" Margin="-6,0" ItemsPanel="{StaticResource TwoColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:ComponentCardViewModel}">
                                            <Border Style="{StaticResource SoftCard}" Margin="6" appearance:Motion.EnterOnLoad="True" appearance:Motion.HoverGrow="True"
                                                    Background="{Binding Letter, Converter={StaticResource Pastel}}"
                                                    BorderBrush="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                        <controls:LetterTile DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0"
                                                                             Text="{Binding Letter}" Fill="{Binding Letter, Converter={StaticResource LetterToBrush}}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CardTitle}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                                        <Button Padding="12,4" Margin="0,0,8,0"
                                                                Content="{x:Static app:Ui.SearchSheet}" Command="{Binding SearchCommand}"
                                                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Padding="12,4" Margin="0,0,8,0" Content="{Binding HistoryLabel, Mode=OneTime}" Command="{Binding History.ReadCommand}"
                                                                AutomationProperties.Name="{Binding HistoryLabel, Mode=OneTime}"
                                                                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Padding="12,4" Content="{Binding ActionLabel, Mode=OneWay}" Command="{Binding ActionCommand}"
                                                                AutomationProperties.Name="{Binding ActionLabel, Mode=OneWay}"
                                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                                    </WrapPanel>
                                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding History.HasLines, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                        <TextBlock Text="{Binding HistoryLabel, Mode=OneTime}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                                        <controls:Sparkline Height="44" Margin="0,0,0,6" Maximum="0" Values="{Binding History.Curve, Mode=OneWay}" Marks="{Binding History.Marks, Mode=OneWay}"
                                                                            Stroke="{StaticResource MausBlue}" Visibility="{Binding History.HasCurve, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                                        <ItemsControl Focusable="False" ItemsSource="{Binding History.Lines, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,1" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding HasGauge, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Gauge.Caption}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                                        <controls:SafetyGauge Height="18" ToolTip="{x:Static app:Ui.TipSafetyGauge}" Minimum="{Binding Gauge.Minimum, Mode=OneWay}" Maximum="{Binding Gauge.Maximum, Mode=OneWay}"
                                                                              Elevated="{Binding Gauge.Elevated, Mode=OneWay}" Danger="{Binding Gauge.Danger, Mode=OneWay}"
                                                                              Value="{Binding Gauge.Value, Mode=OneWay}" />
                                                        <TextBlock Text="{Binding Gauge.Legend}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <ItemsControl Focusable="False" ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type ws:InfoLine}">
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="0.45*" />
                                                                        <ColumnDefinition Width="0.55*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- En direct : charge, températures et alarmes -->
                    <TabItem Header="{x:Static app:Ui.SectionSensors}" Style="{StaticResource SubPillTab}" Visibility="{Binding Workshop.ShowLiveSections, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Zone 1 : les mesures en direct. -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenMonitor}" Command="{Binding OpenMonitorCommand}" VerticalAlignment="Center"
                                            Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                                    <TextBlock Text="{x:Static app:Ui.LiveMeasuresTitle}" Style="{StaticResource ZoneTitle}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SensorAlarms}" Focusable="False" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.Live.Metrics}" Margin="-6,0" ItemsPanel="{StaticResource ThreeColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:MetricViewModel}">
                                            <Border Style="{StaticResource SoftCard}" Margin="6" MinHeight="140"
                                                    Background="{Binding Stroke, Converter={StaticResource Pastel}}"
                                                    BorderBrush="{Binding Stroke, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Margin="0,4,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail, Mode=OneWay}">
                                                        <Run Text="{Binding Value, Mode=OneWay}" FontSize="{StaticResource FontSizeMetric}" FontWeight="Bold" />
                                                        <Run Text="{Binding Detail, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" />
                                                    </TextBlock>
                                                    <controls:Sparkline Height="48" Values="{Binding Series, Mode=OneWay}" Maximum="{Binding Maximum, Mode=OneWay}" Stroke="{Binding Stroke}" />
                                                    <StackPanel Visibility="{Binding HasGauge, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                                        <controls:SafetyGauge Height="16" ToolTip="{x:Static app:Ui.TipSafetyGauge}" Minimum="{Binding Gauge.Minimum, Mode=OneWay}" Maximum="{Binding Gauge.Maximum, Mode=OneWay}"
                                                                              Elevated="{Binding Gauge.Elevated, Mode=OneWay}" Danger="{Binding Gauge.Danger, Mode=OneWay}"
                                                                              Value="{Binding Gauge.Value, Mode=OneWay}" />
                                                        <TextBlock Text="{Binding Gauge.Legend}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Workshop.Live.ThermalNote}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                <Border Style="{StaticResource Divider}" />

                                <!-- Zone 2 : relevé pendant une partie (images par seconde comprises). -->
                                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.SessionTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelMintInk}" />
                                        <TextBlock Text="{Binding Workshop.SessionStatus}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="{x:Static app:Ui.DurationLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.DurationLabel}" MinWidth="180" Margin="0,0,12,4" ItemsSource="{Binding Workshop.SessionDurations, Mode=OneWay}" SelectedItem="{Binding Workshop.SessionDuration}"
                                                      DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsNotRecording, Mode=OneWay}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.Record}"
                                                    Command="{Binding Workshop.StartSessionCommand}" Visibility="{Binding Workshop.IsNotRecording, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource DangerButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.Stop}"
                                                    Command="{Binding Workshop.StopSessionCommand}" Visibility="{Binding Workshop.IsRecording, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource SoftButton}" Margin="0,0,8,4" Content="{x:Static app:Ui.ExportCsv}" Command="{Binding Workshop.ExportSessionCommand}"
                                                    Visibility="{Binding Workshop.HasSessionSummary, Converter={StaticResource BoolToVisibility}}" />
                                        </WrapPanel>
                                        <TextBox Text="{Binding Workshop.SessionSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                                 Margin="0,8,0,0" Visibility="{Binding Workshop.HasSessionSummary, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Divider}" />

                                <!-- Zone 3 : capteurs avancés (pilote PawnIO, au choix de l'utilisateur). -->
                                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.PawnIoTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelSandInk}" />
                                        <TextBlock Text="{Binding Workshop.PawnIoStatus}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.EnableAdvancedSensors}"
                                                    Command="{Binding Workshop.EnableAdvancedSensorsCommand}" Visibility="{Binding Workshop.CanEnableAdvancedSensors, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.InstallPawnIo}"
                                                    Command="{Binding Workshop.InstallPawnIoCommand}" Visibility="{Binding Workshop.IsPawnIoMissing, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource SoftButton}" Margin="0,0,8,4" Content="{x:Static app:Ui.UninstallPawnIo}"
                                                    Command="{Binding Workshop.UninstallPawnIoCommand}" Visibility="{Binding Workshop.IsPawnIoInstalled, Converter={StaticResource BoolToVisibility}}" />
                                        </WrapPanel>
                                        <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.AllSensors}" Margin="0,10,0,0"
                                                  Visibility="{Binding Workshop.Live.HasReadings, Converter={StaticResource BoolToVisibility}}">
                                            <DataGrid AutomationProperties.Name="{x:Static app:Ui.SectionSensors}" ItemsSource="{Binding Workshop.Live.Readings}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                                      CanUserAddRows="False" GridLinesVisibility="None" MaxHeight="360" Margin="0,6,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{x:Static app:Ui.ComponentColumn}" Binding="{Binding Hardware, Mode=OneWay}" Width="2*" />
                                                    <DataGridTextColumn Header="{x:Static app:Ui.SensorColumn}" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                                                    <DataGridTextColumn Header="{x:Static app:Ui.ValueColumn}" Binding="{Binding Value, Mode=OneWay}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Processus : gestionnaire des tâches expliqué -->
                    <TabItem Header="{x:Static app:Ui.SectionProcesses}" Style="{StaticResource SubPillTab}" Visibility="{Binding Workshop.ShowLiveSections, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{x:Static app:Ui.FilterLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox AutomationProperties.Name="{x:Static app:Ui.FilterLabel}" Width="200" Margin="0,0,16,0" VerticalAlignment="Center"
                                         Text="{Binding Workshop.Filter, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{x:Static app:Ui.SearchWith}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.SearchWith}" MinWidth="130" Margin="0,0,16,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Workshop.SearchEngines}" SelectedItem="{Binding Workshop.SearchEngineChoice}" DisplayMemberPath="Label" />
                                <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Content="{x:Static app:Ui.SlowPcTitle}" Command="{Binding Workshop.DiagnoseCommand}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Workshop.DiagnosisStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl Focusable="False" DockPanel.Dock="Top" ItemsSource="{Binding Workshop.ProcessList.Causes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ws:CauseViewModel}">
                                        <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausBlue}" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <Button Style="{StaticResource SoftButton}" Content="{Binding Module}" Command="{Binding OpenModule}" HorizontalAlignment="Left" Padding="10,2" FontSize="{StaticResource FontSizeSmall}" Margin="0,6,0,0"
                                                        Visibility="{Binding HasModule, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Workshop.LastRestartText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding Workshop.HasLastRestart, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <!-- La suite du diagnostic : corriger, ou tester le matériel (0.8.6). -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding Workshop.HasCauses, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource SoftButton}" Visibility="{Binding HasProposedChanges, Converter={StaticResource BoolToVisibility}}" Content="{Binding FixNowLabel}" Command="{Binding GoToCommand}" CommandParameter="2" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.TestPcTitle}" Command="{Binding GoToCommand}" CommandParameter="33" />
                            </WrapPanel>

                            <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.PickProcess}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding Workshop.NoSelectedProcess, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Fiche du processus choisi : elle ne prend sa place que quand il y a quelque chose à y lire. -->
                            <Border DockPanel.Dock="Right" Width="300" Margin="12,0,0,0" Style="{StaticResource Card}"
                                    Visibility="{Binding Workshop.HasSelectedProcess, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel DataContext="{Binding Workshop.SelectedProcess}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontSizeSectionTitle}" />
                                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Background="{Binding Trust, Converter={StaticResource TrustToBrush}}">
                                                <TextBlock Text="{Binding TrustLabel}" Foreground="{DynamicResource OnAccentText}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource SectionLabel}" Margin="0,8,0,2" />
                                            <TextBlock Text="{Binding What}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Static app:Ui.LocationLabel}" Style="{StaticResource SectionLabel}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Location, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" />
                                            <TextBlock FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,8,0,0">
                                                <Run Text="{x:Static app:Ui.PidLabel}" /><Run Text="{x:Static app:Ui.LabelSeparator}" /><Run Text="{Binding PidText, Mode=OneWay}" />
                                                <LineBreak />
                                                <Run Text="{x:Static app:Ui.StartedLabel}" /><Run Text="{x:Static app:Ui.LabelSeparator}" /><Run Text="{Binding Started, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Content="{x:Static app:Ui.SearchWeb}" Margin="0,12,0,0" Padding="12,5" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.Workshop.SearchProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="{x:Static app:Ui.ShowFolder}" Margin="0,6,0,0" Padding="12,5" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.Workshop.ShowProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Style="{StaticResource DangerButton}" Content="{x:Static app:Ui.Terminate}" Margin="0,6,0,0" Padding="12,6"
                                                    appearance:WhyDisabled.Explain="True" IsEnabled="{Binding CanTerminate, Mode=OneWay}"
                                                    Command="{Binding DataContext.Workshop.TerminateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="{Binding TerminationNote}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Workshop.ProcessListNote}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Workshop.HasProcessListNote, Converter={StaticResource BoolToVisibility}}" />
                            <DataGrid AutomationProperties.Name="{x:Static app:Ui.SectionProcesses}" ItemsSource="{Binding Workshop.ProcessList.Rows}" SelectedItem="{Binding Workshop.SelectedProcess}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0"
                                      Background="Transparent" RowBackground="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnProcess}" Binding="{Binding Name, Mode=OneWay}" Width="2*" FontWeight="SemiBold" ElementStyle="{StaticResource GridCell}" />
                                    <DataGridTemplateColumn Header="{x:Static app:Ui.ColumnCpu}" Width="*" SortMemberPath="Sample.CpuPercent">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type ws:ProcessRowViewModel}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                                        <TextBlock Text="{Binding Cpu}" MinWidth="46" />
                                                    <Rectangle Width="{Binding CpuBar, Mode=OneWay}" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource MausBlue}" Margin="0,0,6,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnMemory}" Binding="{Binding Memory, Mode=OneWay}" Width="*" SortMemberPath="Sample.PrivateBytes" ElementStyle="{StaticResource GridCell}" />
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnIo}" Binding="{Binding Io, Mode=OneWay}" Width="Auto" SortMemberPath="Sample.IoBytesPerSecond" ElementStyle="{StaticResource GridCell}" />
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnGpu}" Binding="{Binding Gpu, Mode=OneWay}" Width="0.7*" SortMemberPath="Sample.GpuPercent" ElementStyle="{StaticResource GridCell}" />
                                    <DataGridTemplateColumn Header="{x:Static app:Ui.ColumnTrust}" Width="Auto" SortMemberPath="Trust">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type ws:ProcessRowViewModel}">
                                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2"
                                                        Background="{Binding Trust, Converter={StaticResource TrustToBrush}}">
                                                    <TextBlock Text="{Binding TrustLabel}" Foreground="{DynamicResource OnAccentText}" FontSize="{StaticResource FontSizeNote}" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Tests : processeur et mémoire vive -->
                    <TabItem Header="{x:Static app:Ui.SectionTests}" Visibility="Collapsed">
                        <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Avant de commencer : sécurité et fenêtre de surveillance, en une seule carte. -->
                                <Border Style="{StaticResource SoftCard}" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenMonitor}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding OpenMonitorCommand}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PastelBlueStroke}" />
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE7BA;" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource PastelBlueInk}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static app:Ui.TestSafety}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Static app:Ui.MonitorTestsHint}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CrashNotice}" Focusable="False" Margin="0,0,0,12"
                                                Visibility="{Binding Workshop.HasCrashNotice, Converter={StaticResource BoolToVisibility}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SensorAlarms}" Focusable="False" />
                                <!-- Test en cours : arrêt toujours à portée de main, avec la charge et la température. -->
                                <Border Style="{StaticResource SoftCard}" Padding="14,10" Margin="0,0,0,12" BorderThickness="5,1,1,1"
                                        Background="{DynamicResource PastelRose}" BorderBrush="{StaticResource MausRed}"
                                        Visibility="{Binding Workshop.IsTesting, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Content="{x:Static app:Ui.StopTest}" Command="{Binding Workshop.StopTestCommand}" />
                                        <controls:RingGauge DockPanel.Dock="Left" Width="40" Height="40" Margin="14,0,0,0" Thickness="5" Value="{Binding Workshop.ActiveProgress, Mode=OneWay}" Stroke="{DynamicResource MausAccent}" />
                                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Workshop.TestLoad.Title, Mode=OneWay}" /><Run Text="{x:Static app:Ui.LabelSeparator}" /><Run Text="{Binding Workshop.TestLoad.Value, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Workshop.TestLoad.DetailSuffix, Mode=OneWay}" />
                                            <Run Text="   ·   " />
                                            <Run Text="{Binding Workshop.TestTemperature.Title, Mode=OneWay}" /><Run Text="{x:Static app:Ui.LabelSeparator}" /><Run Text="{Binding Workshop.TestTemperature.Value, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Workshop.TestTemperature.DetailSuffix, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Workshop.ActiveStatus}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Résultat du dernier test : une coche qui se dessine. -->
                                <Border Style="{StaticResource SoftCard}" Padding="14,10" Margin="0,0,0,12" appearance:Motion.EnterWhen="{Binding Workshop.HasOutcome, Mode=OneWay}"
                                        Visibility="{Binding Workshop.HasOutcome, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <controls:DoneMark DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0" Good="{Binding Workshop.OutcomeGood, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.OutcomeText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>

                                <!-- Bilan complet : tous les tests à la suite, une seule confirmation. -->
                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Center" Content="{x:Static app:Ui.FullCheckStart}"
                                                    Command="{Binding Workshop.StartFullCheckCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Static app:Ui.TestPcTitle}" Style="{StaticResource CardTitle}" Margin="0" Foreground="{DynamicResource PastelLilacInk}" />
                                                <TextBlock Text="{x:Static app:Ui.FullCheckIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{x:Static app:Ui.SaveCheck}" ToolTip="{x:Static app:Ui.TipSaveCheck}" Command="{Binding SaveCheckReportCommand}" />
                                        <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.FullCheckLines}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,2,0,0" appearance:Motion.EnterOnLoad="True" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Une tuile par famille : seule la famille choisie s'affiche dessous. -->
                                <UniformGrid Rows="1" Margin="0,0,-8,12">
                                    <RadioButton Style="{StaticResource TestTile}" IsChecked="{Binding Workshop.ShowCpuTests}" ToolTip="{x:Static app:Ui.TipTileCpu}" AutomationProperties.Name="{x:Static app:Ui.TileCpu}"
                                                 Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardIcon}" FontSize="20" Margin="0,0,0,6" Text="&#xE9D9;" Foreground="{DynamicResource PastelBlueInk}" />
                                            <TextBlock Text="{x:Static app:Ui.TileCpu}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workshop.CpuStatus}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TestTile}" IsChecked="{Binding Workshop.ShowRamTests}" ToolTip="{x:Static app:Ui.TipTileRam}" AutomationProperties.Name="{x:Static app:Ui.TileRam}"
                                                 Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardIcon}" FontSize="20" Margin="0,0,0,6" Text="&#xE964;" Foreground="{DynamicResource PastelMintInk}" />
                                            <TextBlock Text="{x:Static app:Ui.TileRam}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workshop.RamStatus}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TestTile}" IsChecked="{Binding Workshop.ShowGpuTests}" ToolTip="{x:Static app:Ui.TipTileGpu}" AutomationProperties.Name="{x:Static app:Ui.TileGpu}"
                                                 Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardIcon}" FontSize="20" Margin="0,0,0,6" Text="&#xE7F4;" Foreground="{DynamicResource PastelRoseInk}" />
                                            <TextBlock Text="{x:Static app:Ui.TileGpu}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workshop.VramStatus}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TestTile}" IsChecked="{Binding Workshop.ShowDiskTests}" ToolTip="{x:Static app:Ui.TipTileDisk}" AutomationProperties.Name="{x:Static app:Ui.TileDisk}"
                                                 Background="{DynamicResource PastelAqua}" BorderBrush="{DynamicResource PastelAquaStroke}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardIcon}" FontSize="20" Margin="0,0,0,6" Text="&#xEDA2;" Foreground="{DynamicResource PastelAquaInk}" />
                                            <TextBlock Text="{x:Static app:Ui.TileDisk}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workshop.DiskStatus}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TestTile}" IsChecked="{Binding Workshop.ShowNetTests}" ToolTip="{x:Static app:Ui.TipTileNet}" AutomationProperties.Name="{x:Static app:Ui.TileNet}"
                                                 Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardIcon}" FontSize="20" Margin="0,0,0,6" Text="&#xE701;" Foreground="{DynamicResource PastelLilacInk}" />
                                            <TextBlock Text="{x:Static app:Ui.TileNet}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workshop.NetStatus}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TestTile}" IsChecked="{Binding Workshop.ShowDeviceTests}" ToolTip="{x:Static app:Ui.TipTileDevices}" AutomationProperties.Name="{x:Static app:Ui.TileDevices}"
                                                 Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardIcon}" FontSize="20" Margin="0,0,0,6" Text="&#xE7F8;" Foreground="{DynamicResource PastelSandInk}" />
                                            <TextBlock Text="{x:Static app:Ui.TileDevices}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Workshop.DeviceStatus}" FontSize="{StaticResource FontSizeNote}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowCpuTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowCpuTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                        <StackPanel>
                                            <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.CpuTestTitle}" Content="&#xE9D9;" Tag="{DynamicResource PastelBlueStroke}" Foreground="{DynamicResource PastelBlueInk}" />
                                            <TextBlock Text="{x:Static app:Ui.CpuTestIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <RadioButton Style="{StaticResource Segment}" Content="{x:Static app:Ui.LevelQuick}" IsChecked="{Binding Workshop.CpuQuick}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <RadioButton Style="{StaticResource Segment}" Content="{x:Static app:Ui.LevelNormal}" IsChecked="{Binding Workshop.CpuNormal}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <RadioButton Style="{StaticResource Segment}" Content="{x:Static app:Ui.LevelLong}" IsChecked="{Binding Workshop.CpuLong}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartCpuLevelCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Workshop.CpuLevelDetail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.MoreOptions}" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{x:Static app:Ui.LoadLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ComboBox ItemsSource="{Binding Workshop.CpuModes}" SelectedItem="{Binding Workshop.CpuMode}" DisplayMemberPath="Label"
                                                                  appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Static app:Ui.LoadLabel}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Workshop.CpuModeDetail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Expander>
                                            <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" Height="6" Margin="0,12,0,0" Maximum="100" Visibility="{Binding Workshop.CpuProgress, Converter={StaticResource PositiveToVisibility}}" Value="{Binding Workshop.CpuProgress, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Workshop.CpuStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowRamTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowRamTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                                        <StackPanel>
                                            <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.RamTestTitle}" Content="&#xE964;" Tag="{DynamicResource PastelMintStroke}" Foreground="{DynamicResource PastelMintInk}" />
                                            <TextBlock Text="{x:Static app:Ui.RamTestIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock Text="{x:Static app:Ui.SizeLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="8,0,0,0"
                                                        Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartRamTestCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.SizeLabel}" ItemsSource="{Binding Workshop.RamSizes}" SelectedItem="{Binding Workshop.RamSize}" DisplayMemberPath="Label"
                                                          appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            </DockPanel>
                                            <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" Height="6" Margin="0,12,0,0" Maximum="100" Visibility="{Binding Workshop.RamProgress, Converter={StaticResource PositiveToVisibility}}" Value="{Binding Workshop.RamProgress, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Workshop.RamStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowGpuTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowGpuTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                                    <StackPanel>
                                        <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.VramTestTitle}" Content="&#xE7F4;" Tag="{DynamicResource PastelRoseStroke}" Foreground="{DynamicResource PastelRoseInk}" />
                                        <TextBlock Text="{x:Static app:Ui.VramTestIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="{x:Static app:Ui.CardLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.CardLabel}" MinWidth="260" Margin="0,0,16,4" ItemsSource="{Binding Workshop.VramAdapters}" SelectedItem="{Binding Workshop.VramAdapter}"
                                                      DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <TextBlock Text="{x:Static app:Ui.SizeLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.SizeLabel}" MinWidth="200" Margin="0,0,16,4" ItemsSource="{Binding Workshop.VramSizes}" SelectedItem="{Binding Workshop.VramSize}"
                                                      DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4"
                                                    Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartVramTestCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        </WrapPanel>
                                        <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" Height="6" Margin="0,8,0,0" Maximum="100" Visibility="{Binding Workshop.VramProgress, Converter={StaticResource PositiveToVisibility}}" Value="{Binding Workshop.VramProgress, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.VramStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowCpuTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowCpuTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                    <StackPanel>
                                        <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.CoreTestTitle}" Content="&#xE945;" Tag="{DynamicResource PastelSandStroke}" Foreground="{DynamicResource PastelSandInk}" />
                                        <TextBlock Text="{x:Static app:Ui.CoreTestIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                                        <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.FineTuningShow}" Margin="0,8,0,0" IsExpanded="{Binding Workshop.FineTuningOpen, Mode=OneWay}">
                                        <StackPanel>
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="{x:Static app:Ui.LoadLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox MinWidth="260" Margin="0,0,12,4" ItemsSource="{Binding Workshop.CpuModes}" SelectedItem="{Binding Workshop.CoreMode}"
                                                      DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Static app:Ui.LoadLabel}" />
                                            <TextBlock Text="{Binding Workshop.CoreModeDetail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Text="{x:Static app:Ui.DurationLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.DurationLabel}" MinWidth="220" Margin="0,0,16,4" ItemsSource="{Binding Workshop.CoreDurations}" SelectedItem="{Binding Workshop.CoreDuration}"
                                                      DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4"
                                                    Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartCoreTestCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        </WrapPanel>
                                        <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" Height="6" Margin="0,8,0,0" Maximum="100" Visibility="{Binding Workshop.CoreProgress, Converter={StaticResource PositiveToVisibility}}" Value="{Binding Workshop.CoreProgress, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.CoreStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />

                                        <!-- Programme complet : phase cœur par cœur puis phase de transitoires, sur plusieurs heures. -->
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" Background="{DynamicResource PastelSandStroke}" />
                                        <TextBlock Text="{x:Static app:Ui.CurveProgramTitle}" FontWeight="SemiBold" Foreground="{DynamicResource PastelSandInk}" />
                                        <TextBlock Text="{x:Static app:Ui.CurveProgramIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{x:Static app:Ui.DurationLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox MinWidth="220" Margin="0,0,16,4" ItemsSource="{Binding Workshop.CurvePrograms}" SelectedItem="{Binding Workshop.CurveProgram}"
                                                      DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Static app:Ui.CurveProgramTitle}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4"
                                                    Content="{x:Static app:Ui.StartProgram}" Command="{Binding Workshop.StartCurveProgramCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        </WrapPanel>
                                        <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" Height="10" Margin="0,8,0,0" Maximum="100" Visibility="{Binding Workshop.CurveProgress, Converter={StaticResource PositiveToVisibility}}" Value="{Binding Workshop.CurveProgress, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.CurveStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.CoreChips}" Margin="0,8,0,0" ItemsPanel="{StaticResource WrapItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ws:CoreChipViewModel}">
                                                    <Border Style="{StaticResource Chip}" Background="{Binding Background}">
                                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource OnAccentText}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- Benchmark visuel : la page dédiée (menu de gauche) le lance et garde les résultats. -->
                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowGpuTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowGpuTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                                    <DockPanel>
