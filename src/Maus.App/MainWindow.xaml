                                <Border Style="{StaticResource Divider}" Margin="0,22,0,16" />
                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelGreyStroke}">
                                                <TextBlock Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeCardTitle}" Text="&#xE9D2;" Foreground="{DynamicResource PastelGreyInk}" />
                                            </Border>
                                            <TextBlock Text="{x:Static app:Ui.ScoreHistoryTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static app:Ui.ScoreHistoryIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <ComboBox AutomationProperties.Name="{x:Static app:Ui.ScoreHistoryTitle}" MinWidth="260" Margin="0,10,0,4" HorizontalAlignment="Left" ItemsSource="{Binding Workshop.ScoreKinds}" SelectedItem="{Binding Workshop.ScoreKind}"
                                                  DisplayMemberPath="Label" Visibility="{Binding Workshop.HasScores, Converter={StaticResource BoolToVisibility}}" />
                                        <controls:Sparkline Height="60" Margin="0,8,0,0" Values="{Binding Workshop.ScoreSeries, Mode=OneWay}" Maximum="0" Stroke="{StaticResource MausBlue}" />
