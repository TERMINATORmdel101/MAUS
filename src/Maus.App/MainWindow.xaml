                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Border appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}">
