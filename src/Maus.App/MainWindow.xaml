                                </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowDeviceTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowDeviceTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                                    <StackPanel>
                                        <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.SpeakerTestTitle}" Content="&#xE767;" Tag="{DynamicResource PastelMintStroke}" Foreground="{DynamicResource PastelMintInk}" />
