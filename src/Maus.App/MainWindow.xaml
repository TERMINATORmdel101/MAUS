<Window x:Class="Maus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:appearance="clr-namespace:Maus.App.Appearance"
        xmlns:controls="clr-namespace:Maus.App.Controls"
        xmlns:vm="clr-namespace:Maus.App.ViewModels"
        xmlns:ws="clr-namespace:Maus.App.ViewModels.Workshop"
        Title="{x:Static app:Ui.WindowTitle}"
        Width="1240" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />

        <!-- Carte d'un constat (onglet Constats, par importance comme par module) : fond pastel et bord de la couleur du verdict. -->
        <DataTemplate x:Key="FindingCard" DataType="{x:Type vm:FindingViewModel}">
            <Border appearance:Motion.EnterOnLoad="True" Margin="0,0,0,10" Padding="16,12" CornerRadius="12" BorderThickness="5,1,1,1"
                    Background="{Binding Status, Converter={StaticResource Pastel}}"
                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}">
                <StackPanel>
                    <TextBlock Text="{Binding Module}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"
                               Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}"
                               Visibility="{Binding HasModule, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Top" BorderThickness="1"
                                BorderBrush="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Values}" FontSize="12" Opacity="{DynamicResource MutedOpacity}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding AlsoIn}" FontSize="12" FontStyle="Italic" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{Binding Status, Converter={StaticResource Pastel}, ConverterParameter=Ink}"
                               Visibility="{Binding HasAlsoIn, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Explanation}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Advice}" Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                               Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.FixThis}" Padding="14,4" FontSize="12" Margin="0,0,6,0"
                                ToolTip="{x:Static app:Ui.FixThisTip}" Command="{Binding FixCommand}"
                                Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenWebPage}" Padding="12,3" FontSize="12" Margin="0,0,6,0"
                                ToolTip="{Binding Link, Mode=OneWay}" Command="{Binding OpenLinkCommand}"
                                Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenInWindows}" Padding="12,3" FontSize="12" Margin="0,0,6,0"
                                Command="{Binding OpenSettingsPageCommand}"
                                Visibility="{Binding HasSettingsPage, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.Wanted}" Padding="12,3" FontSize="12"
                                ToolTip="{x:Static app:Ui.WantedTip}"
                                Command="{Binding AcknowledgeCommand}"
                                Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.ReportAgain}" Padding="12,3" FontSize="12"
                                Command="{Binding UnacknowledgeCommand}"
                                Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Navigation à gauche (logo, parties, langue) ; la partie choisie s'affiche à droite. -->
    <Grid>
    <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0" appearance:Motion.AnimateSelection="True">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Barre de navigation, légèrement teintée de la couleur d'accentuation (et de celle de la carte graphique). -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                        <Border Background="{DynamicResource MausSidebarTint}" Padding="14,16">
                            <DockPanel>
                                <!-- Logo du porteur, recadré sur les lettres (jamais redessiné) : coins arrondis et ombre légère pour qu'il se pose
                                     sur la barre, puis les quatre couleurs des lettres et ce que veut dire le nom. -->
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                                    <Border Height="100" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            AutomationProperties.Name="MAUS">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/maus-banner.png" Stretch="UniformToFill" />
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" />
                                        </Border.Effect>
                                    </Border>
                                    <UniformGrid Rows="1" Height="3" Margin="10,10,10,0">
                                        <Border Background="{StaticResource MausBlue}" CornerRadius="1.5" Margin="0,0,3,0" />
                                        <Border Background="{StaticResource MausRed}" CornerRadius="1.5" Margin="0,0,3,0" />
                                        <Border Background="{StaticResource MausGreen}" CornerRadius="1.5" Margin="0,0,3,0" />
                                        <Border Background="{StaticResource MausGold}" CornerRadius="1.5" />
                                    </UniformGrid>
                                    <TextBlock Text="{x:Static app:Ui.NameMeaning}" FontSize="10.5" Margin="0,7,0,0" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Opacity="{DynamicResource MutedOpacity}" />
                                </StackPanel>
                                <!-- Place réservée aux réglages du bas (langue, surveillance, paramètres), posés hors du gabarit
                                     pour rester accessibles aux lecteurs d'écran : voir la fin de la fenêtre. -->
                                <Border DockPanel.Dock="Bottom" Height="84" />
                                <StackPanel IsItemsHost="True" />
                            </DockPanel>
                        </Border>
                    </Border>
                    <DockPanel Grid.Column="1" Margin="28,22,28,12">
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding About}" FontSize="11" Opacity="{DynamicResource MutedOpacity}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </DockPanel>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <!-- Accueil : score de santé, familles M·A·U·S et actions rapides -->
        <TabItem Style="{StaticResource NavTab}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource NavIconBox}" Background="{StaticResource MausBlue}">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" />
                    </Border>
                    <TextBlock Text="{x:Static app:Ui.NavHome}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausRed}"
                            Margin="0,12,0,0" Visibility="{Binding Workshop.HasCrashNotice, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.Understood}" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding Workshop.DismissCrashCommand}" />
                            <StackPanel>
                                <TextBlock Text="{x:Static app:Ui.CrashTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Workshop.CrashNotice}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tout premier lancement : MAUS en trois étapes. -->
                    <Border Style="{StaticResource SoftCard}" Margin="0,16,0,0" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}"
                            Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{x:Static app:Ui.WelcomeTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PastelLilacInk}" Margin="0,0,0,10" />
                            <UniformGrid Columns="3">
                                <DockPanel Margin="0,0,16,0">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelLilacStroke}" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PastelLilacInk}" />
                                    </Border>
                                    <TextBlock Text="{x:Static app:Ui.WelcomeStep1}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,16,0">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelLilacStroke}" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PastelLilacInk}" />
                                    </Border>
                                    <TextBlock Text="{x:Static app:Ui.WelcomeStep2}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelLilacStroke}" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PastelLilacInk}" />
                                    </Border>
                                    <TextBlock Text="{x:Static app:Ui.WelcomeStep3}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </UniformGrid>
                            <TextBlock Text="{x:Static app:Ui.WelcomeNever}" FontSize="12" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Score -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Width="168" Height="168" HorizontalAlignment="Center">
                                    <controls:RingGauge Value="{Binding Score, Mode=OneWay}" Thickness="16"
                                                        Stroke="{Binding Score, Converter={StaticResource ScoreToBrush}}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ScoreText}" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <!-- Avant le premier audit : couleur du texte du thème (suit un changement de thème) ; ensuite, couleur du score. -->
                                        <TextBlock Text="{Binding ScoreWord}" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasScore, Mode=OneWay}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding Score, Converter={StaticResource ScoreToBrush}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{x:Static app:Ui.HealthCaption}" FontSize="11" Opacity="{DynamicResource MutedOpacity}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ScoreDetail}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,4" />
                                <!-- Score partiel : un module en erreur ou en délai dépassé n'a rien lu, le score ne compte que le reste. -->
                                <TextBlock Text="{Binding ScorePartialNote}" Style="{StaticResource MausText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="{Binding IsScorePartial, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.ScoreWhy}" Command="{Binding ShowScoreDetailCommand}" HorizontalAlignment="Center" Margin="0,0,0,8"
                                        Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Visibility="{Binding HasHealthTrend, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding HealthTrendText}">
                                    <controls:Sparkline Height="28" Values="{Binding HealthTrend, Mode=OneWay}" Maximum="100" Stroke="{StaticResource MausGreen}" />
                                    <TextBlock Text="{Binding HealthTrendText}" FontSize="11" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <!-- Prochaine étape : l'audit d'abord, puis, dès qu'il est fini, les corrections (demande du porteur). -->
                            <Border Style="{StaticResource SoftCard}" Padding="22,18"
                                    Background="{Binding NextStepTone, Converter={StaticResource Pastel}}"
                                    BorderBrush="{Binding NextStepTone, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                <StackPanel>
                                    <TextBlock Text="{Binding NextStepTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{Binding NextStepTone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                    <TextBlock Text="{Binding NextStepText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding FixNowLabel}" Command="{Binding GoToCommand}" CommandParameter="2" Margin="0,0,10,6"
                                                Visibility="{Binding HasProposedChanges, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding HomeAuditLabel}" Command="{Binding RunAuditCommand}" Margin="0,0,10,6"
                                                Visibility="{Binding IsFirstAudit, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.SeeFindings}" Command="{Binding GoToCommand}" CommandParameter="1" Margin="0,0,10,6"
                                                Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource SoftButton}" Content="{Binding HomeAuditLabel}" Command="{Binding RunAuditCommand}" Margin="0,0,10,6"
                                                Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                    <ProgressBar Height="4" Margin="0,8,0,0" Maximum="{Binding ModuleCount, Mode=OneWay}" Value="{Binding Completed, Mode=OneWay}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Familles M·A·U·S, en tuiles pastel -->
                            <ItemsControl ItemsSource="{Binding Families}" Margin="-5,10,-5,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FamilyViewModel}">
                                        <Border Style="{StaticResource SoftCard}" Margin="5" Padding="14,12"
                                                Background="{Binding Letter, Converter={StaticResource Pastel}}"
                                                BorderBrush="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                            <DockPanel>
                                                <controls:LetterTile DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top"
                                                                     Text="{Binding Letter}" Fill="{Binding Letter, Converter={StaticResource LetterToBrush}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Style="{StaticResource Muted}" />
                                                    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ChipViewModel}">
                                                                <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                                        Background="{Binding Tone, Converter={StaticResource Pastel}}"
                                                                        BorderBrush="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}">
                                                                    <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- Outils : quatre cartes, le reste en boutons -->
                    <TextBlock Text="{x:Static app:Ui.HomeTools}" Style="{StaticResource ZoneTitle}" Margin="0,22,0,4" />
                    <UniformGrid Columns="4" Margin="-6,0,-6,0">
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding SlowPcCommand}"
                                Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xEC4A;" Foreground="{DynamicResource PastelSandInk}" />
                                <TextBlock Text="{x:Static app:Ui.SlowPcTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.SlowPcDetail}" FontSize="12" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding GoToCommand}" CommandParameter="33"
                                Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE9D9;" Foreground="{DynamicResource PastelRoseInk}" />
                                <TextBlock Text="{x:Static app:Ui.TestPcTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.TestPcDetail}" FontSize="12" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding GoToCommand}" CommandParameter="30"
                                Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE950;" Foreground="{DynamicResource PastelBlueInk}" />
                                <TextBlock Text="{x:Static app:Ui.MyPcTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.MyPcDetail}" FontSize="12" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding HelpSummaryCommand}" IsEnabled="{Binding HasAudit, Mode=OneWay}"
                                Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE897;" Foreground="{DynamicResource PastelMintInk}" />
                                <TextBlock Text="{x:Static app:Ui.HelpTitle}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static app:Ui.HelpDetail}" FontSize="12" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Command="{Binding GoToCommand}" CommandParameter="31" ToolTip="{x:Static app:Ui.LiveDetail}"
                                Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9D2;" Foreground="{DynamicResource PastelLilacInk}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static app:Ui.LiveTitle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Command="{Binding GoToCommand}" CommandParameter="34" ToolTip="{x:Static app:Ui.SpaceDetail}"
                                Background="{DynamicResource PastelAqua}" BorderBrush="{DynamicResource PastelAquaStroke}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xEDA2;" Foreground="{DynamicResource PastelAquaInk}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static app:Ui.SpaceTitle}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Command="{Binding SaveReportCommand}" IsEnabled="{Binding HasAudit, Mode=OneWay}" ToolTip="{x:Static app:Ui.ReportDetail}"
                                Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" Foreground="{DynamicResource PastelSandInk}" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static app:Ui.ReportTitle}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Onglet 1 : modules et constats -->
        <TabItem Style="{StaticResource NavTab}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource NavIconBox}" Background="{StaticResource MausRed}">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9D9;" />
                    </Border>
                    <TextBlock Text="{x:Static app:Ui.TabFindings}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding FixNowLabel}" Command="{Binding GoToCommand}" CommandParameter="2" Margin="12,0,0,0"
                        Visibility="{Binding HasProposedChanges, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Left" Content="{Binding HomeAuditLabel}" Command="{Binding RunAuditCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAudit, Mode=OneWay}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource MausAccentStrong}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MausAccentStrong}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar DockPanel.Dock="Right" Width="160" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                             Maximum="{Binding ModuleCount, Mode=OneWay}" Value="{Binding Completed, Mode=OneWay}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>

            <!-- Deux façons de lire l'audit : par importance (par défaut) ou module par module. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton Style="{StaticResource Segment}" GroupName="FindingsView" Content="{x:Static app:Ui.ByImportance}" IsChecked="{Binding ShowByImportance}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="FindingsView" Content="{x:Static app:Ui.ByModule}" IsChecked="{Binding ShowByModule}" />
            </StackPanel>

            <Grid>
                <!-- Par importance : ce qui demande une action, du plus grave au plus léger ; le reste à la demande. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowByImportance, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}"
                                Visibility="{Binding IsFirstAudit, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static app:Ui.FindingsBeforeAudit}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding PriorityTitle}" Style="{StaticResource ZoneTitle}" Foreground="{DynamicResource PastelRoseInk}"
                                   Visibility="{Binding HasPriorityFindings, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}" Margin="0,0,0,4"
                                Visibility="{Binding NothingToHandle, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static app:Ui.NothingToHandle}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource PastelMintInk}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding PriorityFindings}" ItemTemplate="{StaticResource FindingCard}" />
                        <Border Style="{StaticResource Divider}" Visibility="{Binding HasOtherFindings, Converter={StaticResource BoolToVisibility}}" />
                        <Expander Header="{Binding OthersLabel}" IsExpanded="{Binding ShowOthers}" Margin="0,0,0,8"
                                  Visibility="{Binding HasOtherFindings, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding OtherFindings}" ItemTemplate="{StaticResource FindingCard}" Margin="0,10,0,0" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Par module : la liste des modules à gauche, les constats du module choisi à droite (conformes masqués). -->
                <Grid Visibility="{Binding ShowByModule, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" AutomationProperties.Name="{x:Static app:Ui.ByModule}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
                                <DockPanel Margin="2,6">
                                    <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Margin="0,4,10,0" VerticalAlignment="Top"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedModule.Header}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedModule.Summary}" Opacity="{DynamicResource MutedOpacity}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,12">
                                <CheckBox DockPanel.Dock="Right" Content="{x:Static app:Ui.ShowConforming}" IsChecked="{Binding ShowConforming}" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding HiddenConformingNote}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding SelectedModuleFindings}" ItemTemplate="{StaticResource FindingCard}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </DockPanel>
        </TabItem>

        <!-- Onglet 2 : corrections proposées -->
        <TabItem Style="{StaticResource NavTab}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource NavIconBox}" Background="{StaticResource MausGreen}">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE90F;" />
                    </Border>
                    <TextBlock Text="{x:Static app:Ui.TabFixes}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel>
                <!-- Haut : ce qui est proposé et les profils en un clic. -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource ZoneTitle}" />
                    <Border Style="{StaticResource SoftCard}" Padding="14,10" Margin="0,0,0,10" BorderThickness="5,1,1,1"
                            Background="{DynamicResource PastelRose}" BorderBrush="{StaticResource MausRed}"
                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BlockingReason}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                    <WrapPanel Margin="0,0,0,4">
                        <TextBlock Text="{x:Static app:Ui.OneClickProfiles}" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                                    <Button Style="{StaticResource SoftButton}" Content="{Binding Name}" ToolTip="{Binding Description}" Command="{Binding Command}"
                                            Margin="0,0,8,6" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </StackPanel>

                <!-- Bas, toujours visible : appliquer la sélection, avec le point de restauration. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SoftCard}" Margin="0,12,0,0" Padding="16,12"
                        Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="{Binding ApplyLabel}" VerticalAlignment="Center"
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply, Mode=OneWay}" />
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <CheckBox Content="{x:Static app:Ui.CreateRestorePoint}" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,2" />
                                <CheckBox Content="{x:Static app:Ui.EnableProtection}" IsChecked="{Binding EnableProtection}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{x:Static app:Ui.VerifyNote}" FontSize="12" Margin="0,8,0,0" Style="{StaticResource Muted}" />
                        <!-- Réponses des boutons et des choix de cette page (winget, rapport, audit automatique) : visibles ici aussi. -->
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0" Visibility="{Binding IsCheckingSoftware, Converter={StaticResource BoolToVisibility}}" />
                        <Border Padding="12,8" Margin="0,8,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource PastelMintStroke}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="{Binding HasFixReport, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding FixReport, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Centre : la liste des corrections, rangées par module sous des titres repliables, puis, séparés par une barre,
                     les outils, vos choix et l'honnêteté sur les gains. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel.Resources>
                            <CollectionViewSource x:Key="GroupedChanges" Source="{Binding Changes}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Group" />
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </StackPanel.Resources>
                        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedChanges}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <Expander Style="{StaticResource QuietExpander}" IsExpanded="True" Margin="0,4,0,8">
                                                            <Expander.Header>
                                                                <TextBlock FontSize="14">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    <Run Text="  ·  " />
                                                                    <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Expander.Header>
                                                            <ItemsPresenter Margin="-16,4,0,0" />
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChangeViewModel}">
                                    <Grid Margin="0,0,0,8">
                                    <Border Style="{StaticResource SoftCard}" Padding="14,10"
                                            Background="{Binding Tone, Converter={StaticResource Pastel}}"
                                            BorderBrush="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title, Mode=OneWay}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Badges}" FontSize="12" FontWeight="SemiBold" Margin="12,1,0,0"
                                                               Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Gain}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}"
                                                           Visibility="{Binding HasGain, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Risk}" Margin="0,4,0,0" FontStyle="Italic" FontSize="12" TextWrapping="Wrap"
                                                           Visibility="{Binding HasRisk, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Warning}" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource PastelRoseInk}"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.TechnicalDetails}" Margin="0,6,0,0">
                                                    <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                </Expander>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <!-- Correction choisie depuis un constat : entourée de la couleur d'accentuation. -->
                                    <Border BorderThickness="2" CornerRadius="14" BorderBrush="{DynamicResource MausAccent}" IsHitTestVisible="False"
                                            Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="{x:Static app:Ui.OtherTools}" Style="{StaticResource ZoneTitle}" Foreground="{DynamicResource PastelLilacInk}" />
                        <WrapPanel>
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.SaveReport}" Margin="0,0,8,6" Command="{Binding SaveReportCommand}"
                                    IsEnabled="{Binding HasAudit, Mode=OneWay}" ToolTip="{x:Static app:Ui.SaveReportTip}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.RepairWindows}" Margin="0,0,8,6" Command="{Binding RepairWindowsCommand}"
                                    ToolTip="{x:Static app:Ui.RepairWindowsTip}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.UpdateSoftware}" Margin="0,0,8,6" Command="{Binding UpdateSoftwareCommand}"
                                    ToolTip="{x:Static app:Ui.UpdateSoftwareTip}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.DriverUpdates}" Margin="0,0,8,6" Command="{Binding Workshop.OpenDriverUpdatesCommand}"
                                    ToolTip="{x:Static app:Ui.DriverUpdatesTip}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.RestartExplorer}" Margin="0,0,8,6" Command="{Binding RestartExplorerCommand}"
                                    Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVisibility}}" ToolTip="{x:Static app:Ui.RestartExplorerTip}"
                                    Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}" />
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="{x:Static app:Ui.YourChoices}" Style="{StaticResource ZoneTitle}" Foreground="{DynamicResource PastelAquaInk}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Static app:Ui.GameBarProfile}" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.GameBarProfile}" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding GameBarOptions}" SelectedItem="{Binding GameBarChoice}" DisplayMemberPath="Label" />
                                <TextBlock Grid.Row="1" Text="{x:Static app:Ui.LaptopPower}" VerticalAlignment="Center" Margin="0,0,12,6"
                                           Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.LaptopPower}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding LaptopOptions}" SelectedItem="{Binding LaptopChoice}" DisplayMemberPath="Label"
                                          Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="2" Text="{x:Static app:Ui.WeeklyAudit}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.WeeklyAudit}" Grid.Row="2" Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left"
                                          ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding ScheduleChoice}" DisplayMemberPath="Label"
                                          ToolTip="{x:Static app:Ui.WeeklyAuditTip}" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />
                        <Expander Header="{x:Static app:Ui.HonestTitle}" Margin="0,0,0,8">
                            <Border Style="{StaticResource SoftCard}" Margin="0,8,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.HonestWindows}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestHardware}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestOverclock}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestSecurity}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static app:Ui.HonestWarning}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- Atelier : Mon PC, En direct, Processus, Tests -->
        <TabItem Style="{StaticResource NavTab}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource NavIconBox}" Background="{StaticResource MausGold}">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE950;" />
                    </Border>
                    <TextBlock Text="{x:Static app:Ui.NavWorkshop}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="{x:Static app:Ui.NavWorkshop}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{x:Static app:Ui.WorkshopSubtitle}" Style="{StaticResource Muted}" />
                </StackPanel>
                <TabControl SelectedIndex="{Binding Workshop.Section}" Background="Transparent" BorderThickness="0" Padding="0" appearance:Motion.AnimateSelection="True">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,14" />
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- Mon PC : fiche d'identité du matériel -->
                    <TabItem Header="{x:Static app:Ui.SectionPc}" Style="{StaticResource PillTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.CopySheet}" ToolTip="{x:Static app:Ui.CopySheetTip}"
                                            Command="{Binding Workshop.CopyInventoryCommand}" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Workshop.InventoryStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10" Visibility="{Binding Workshop.IsReadingInventory, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Workshop.Components}" Margin="-6,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:ComponentCardViewModel}">
                                            <Border Style="{StaticResource SoftCard}" Margin="6" appearance:Motion.EnterOnLoad="True"
                                                    Background="{Binding Letter, Converter={StaticResource Pastel}}"
                                                    BorderBrush="{Binding Letter, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                        <controls:LetterTile DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0"
                                                                             Text="{Binding Letter}" Fill="{Binding Letter, Converter={StaticResource LetterToBrush}}" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CardTitle}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"
                                                            Content="{x:Static app:Ui.SearchSheet}" Command="{Binding SearchCommand}"
                                                            Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding HasGauge, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Gauge.Caption}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                                        <controls:SafetyGauge Height="18" Minimum="{Binding Gauge.Minimum, Mode=OneWay}" Maximum="{Binding Gauge.Maximum, Mode=OneWay}"
                                                                              Elevated="{Binding Gauge.Elevated, Mode=OneWay}" Danger="{Binding Gauge.Danger, Mode=OneWay}"
                                                                              Value="{Binding Gauge.Value, Mode=OneWay}" />
                                                        <TextBlock Text="{Binding Gauge.Legend}" FontSize="11" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type ws:InfoLine}">
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="0.45*" />
                                                                        <ColumnDefinition Width="0.55*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- En direct : charge, températures et alarmes -->
                    <TabItem Header="{x:Static app:Ui.LiveTitle}" Style="{StaticResource PillTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button Content="{x:Static app:Ui.OpenMonitor}" Command="{Binding OpenMonitorCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Workshop.Live.Alarms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausGold}">
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Workshop.Live.Metrics}" Margin="-6,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:MetricViewModel}">
                                            <Border Style="{StaticResource SoftCard}" Margin="6" MinHeight="140"
                                                    Background="{Binding Stroke, Converter={StaticResource Pastel}}"
                                                    BorderBrush="{Binding Stroke, Converter={StaticResource Pastel}, ConverterParameter=Stroke}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Margin="0,4,0,6" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Value, Mode=OneWay}" FontSize="26" FontWeight="Bold" />
                                                        <Run Text="{Binding Detail, Mode=OneWay}" FontSize="12" />
                                                    </TextBlock>
                                                    <controls:Sparkline Height="48" Values="{Binding Series, Mode=OneWay}" Maximum="{Binding Maximum, Mode=OneWay}" Stroke="{Binding Stroke}"
                                                                        Visibility="{Binding HasSeries, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel Visibility="{Binding HasGauge, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                                        <controls:SafetyGauge Height="16" Minimum="{Binding Gauge.Minimum, Mode=OneWay}" Maximum="{Binding Gauge.Maximum, Mode=OneWay}"
                                                                              Elevated="{Binding Gauge.Elevated, Mode=OneWay}" Danger="{Binding Gauge.Danger, Mode=OneWay}"
                                                                              Value="{Binding Gauge.Value, Mode=OneWay}" />
                                                        <TextBlock Text="{Binding Gauge.Legend}" FontSize="11" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Workshop.Live.ThermalNote}" FontSize="12" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.SessionTitle}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Workshop.SessionStatus}" FontSize="12" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="{x:Static app:Ui.DurationLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.DurationLabel}" MinWidth="180" Margin="0,0,12,4" ItemsSource="{Binding Workshop.SessionDurations, Mode=OneWay}" SelectedItem="{Binding Workshop.SessionDuration}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsNotRecording, Mode=OneWay}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.Record}"
                                                    Command="{Binding Workshop.StartSessionCommand}" Visibility="{Binding Workshop.IsNotRecording, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource DangerButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.Stop}"
                                                    Command="{Binding Workshop.StopSessionCommand}" Visibility="{Binding Workshop.IsRecording, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.ExportCsv}" Command="{Binding Workshop.ExportSessionCommand}"
                                                    Visibility="{Binding Workshop.HasSessionSummary, Converter={StaticResource BoolToVisibility}}" />
                                        </WrapPanel>
                                        <TextBox Text="{Binding Workshop.SessionSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                                 Margin="0,8,0,0" Visibility="{Binding Workshop.HasSessionSummary, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.PawnIoTitle}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Workshop.PawnIoStatus}" FontSize="12" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.InstallPawnIo}"
                                                    Command="{Binding Workshop.InstallPawnIoCommand}" Visibility="{Binding Workshop.IsPawnIoMissing, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.UninstallPawnIo}"
                                                    Command="{Binding Workshop.UninstallPawnIoCommand}" Visibility="{Binding Workshop.IsPawnIoInstalled, Converter={StaticResource BoolToVisibility}}" />
                                        </WrapPanel>
                                        <Expander Header="{x:Static app:Ui.AllSensors}" Margin="0,8,0,0"
                                                  Visibility="{Binding Workshop.Live.HasReadings, Converter={StaticResource BoolToVisibility}}">
                                            <DataGrid ItemsSource="{Binding Workshop.Live.Readings}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                                      CanUserAddRows="False" GridLinesVisibility="None" MaxHeight="360" Margin="0,6,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{x:Static app:Ui.ComponentColumn}" Binding="{Binding Hardware, Mode=OneWay}" Width="2*" />
                                                    <DataGridTextColumn Header="{x:Static app:Ui.SensorColumn}" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                                                    <DataGridTextColumn Header="{x:Static app:Ui.ValueColumn}" Binding="{Binding Value, Mode=OneWay}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Processus : gestionnaire des tâches expliqué -->
                    <TabItem Header="{x:Static app:Ui.SectionProcesses}" Style="{StaticResource PillTab}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{x:Static app:Ui.FilterLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox AutomationProperties.Name="{x:Static app:Ui.FilterLabel}" Width="200" Margin="0,0,16,0" VerticalAlignment="Center"
                                         Text="{Binding Workshop.Filter, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{x:Static app:Ui.SearchWith}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.SearchWith}" MinWidth="130" Margin="0,0,16,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Workshop.SearchEngines}" SelectedItem="{Binding Workshop.SearchEngineChoice}" DisplayMemberPath="Label" />
                                <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Content="{x:Static app:Ui.SlowPcTitle}" Command="{Binding Workshop.DiagnoseCommand}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Workshop.DiagnosisStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Workshop.ProcessList.Causes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ws:CauseViewModel}">
                                        <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausBlue}" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Module}" FontSize="12" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Fiche du processus choisi -->
                            <Border DockPanel.Dock="Right" Width="340" Margin="12,0,0,0" Style="{StaticResource Card}">
                                <Grid>
                                    <TextBlock Text="{x:Static app:Ui.PickProcess}" Style="{StaticResource Muted}"
                                               Visibility="{Binding Workshop.NoSelectedProcess, Converter={StaticResource BoolToVisibility}}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding Workshop.HasSelectedProcess, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel DataContext="{Binding Workshop.SelectedProcess}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="18" />
                                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Background="{Binding Trust, Converter={StaticResource TrustToBrush}}">
                                                <TextBlock Text="{Binding TrustLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource SectionLabel}" Margin="0,8,0,2" />
                                            <TextBlock Text="{Binding What}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Static app:Ui.LocationLabel}" Style="{StaticResource SectionLabel}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Location, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock FontSize="12" Style="{StaticResource Muted}" Margin="0,8,0,0">
                                                <Run Text="{x:Static app:Ui.PidLabel}" />
                                                <Run Text=" : " />
                                                <Run Text="{Binding PidText, Mode=OneWay}" />
                                                <LineBreak />
                                                <Run Text="{x:Static app:Ui.StartedLabel}" />
                                                <Run Text=" : " />
                                                <Run Text="{Binding Started, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Content="{x:Static app:Ui.SearchWeb}" Margin="0,12,0,0" Padding="12,5" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.Workshop.SearchProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="{x:Static app:Ui.ShowFolder}" Margin="0,6,0,0" Padding="12,5" HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.Workshop.ShowProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Style="{StaticResource DangerButton}" Content="{x:Static app:Ui.Terminate}" Margin="0,6,0,0" Padding="12,6"
                                                    IsEnabled="{Binding CanTerminate, Mode=OneWay}"
                                                    Command="{Binding DataContext.Workshop.TerminateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="{Binding TerminationNote}" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <DataGrid ItemsSource="{Binding Workshop.ProcessList.Rows}" SelectedItem="{Binding Workshop.SelectedProcess}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0"
                                      Background="Transparent" RowBackground="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnProcess}" Binding="{Binding Name, Mode=OneWay}" Width="2*" FontWeight="SemiBold" />
                                    <DataGridTemplateColumn Header="{x:Static app:Ui.ColumnCpu}" Width="*" SortMemberPath="Sample.CpuPercent">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type ws:ProcessRowViewModel}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle Width="{Binding CpuBar, Mode=OneWay}" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource MausBlue}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Cpu}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnMemory}" Binding="{Binding Memory, Mode=OneWay}" Width="*" SortMemberPath="Sample.PrivateBytes" />
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnDisk}" Binding="{Binding Disk, Mode=OneWay}" Width="*" SortMemberPath="Sample.DiskBytesPerSecond" />
                                    <DataGridTextColumn Header="{x:Static app:Ui.ColumnGpu}" Binding="{Binding Gpu, Mode=OneWay}" Width="0.7*" SortMemberPath="Sample.GpuPercent" />
                                    <DataGridTemplateColumn Header="{x:Static app:Ui.ColumnTrust}" Width="1.4*" SortMemberPath="Trust">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type ws:ProcessRowViewModel}">
                                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2"
                                                        Background="{Binding Trust, Converter={StaticResource TrustToBrush}}">
                                                    <TextBlock Text="{Binding TrustLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Tests : processeur et mémoire vive -->
                    <TabItem Header="{x:Static app:Ui.SectionTests}" Style="{StaticResource PillTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Avant de commencer : sécurité et fenêtre de surveillance, en une seule carte. -->
                                <Border Style="{StaticResource SoftCard}" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenMonitor}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding OpenMonitorCommand}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PastelBlueStroke}" />
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE7BA;" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource PastelBlueInk}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static app:Ui.TestSafety}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Static app:Ui.MonitorTestsHint}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausRed}"
                                        Visibility="{Binding Workshop.HasCrashNotice, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.Understood}" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding Workshop.DismissCrashCommand}" />
                                        <StackPanel>
                                            <TextBlock Text="{x:Static app:Ui.CrashTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Workshop.CrashNotice}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Workshop.Live.Alarms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource MausGold}">
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Test en cours : arrêt toujours à portée de main, avec la charge et la température. -->
                                <Border Style="{StaticResource SoftCard}" Padding="14,10" Margin="0,0,0,12" BorderThickness="5,1,1,1"
                                        Background="{DynamicResource PastelRose}" BorderBrush="{StaticResource MausRed}"
                                        Visibility="{Binding Workshop.IsTesting, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Content="{x:Static app:Ui.StopTest}" Command="{Binding Workshop.StopTestCommand}" />
                                        <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding Workshop.TestLoad.Title, Mode=OneWay}" />
                                            <Run Text=" : " />
                                            <Run Text="{Binding Workshop.TestLoad.Value, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Workshop.TestLoad.DetailSuffix, Mode=OneWay}" />
                                            <Run Text="   ·   " />
                                            <Run Text="{Binding Workshop.TestTemperature.Title, Mode=OneWay}" />
                                            <Run Text=" : " />
                                            <Run Text="{Binding Workshop.TestTemperature.Value, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Workshop.TestTemperature.DetailSuffix, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>

                                <!-- Partie 1 : stabilité -->
                                <TextBlock Text="{x:Static app:Ui.TestsStability}" Style="{StaticResource ZoneTitle}" FontSize="17" />
                                <TextBlock Text="{x:Static app:Ui.TestsStabilityIntro}" Style="{StaticResource Muted}" FontSize="12" Margin="0,-4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelBlueStroke}">
                                                    <TextBlock Style="{StaticResource NavIcon}" FontSize="17" Text="&#xE9D9;" Foreground="{DynamicResource PastelBlueInk}" />
                                                </Border>
                                                <TextBlock Text="{x:Static app:Ui.CpuTestTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelBlueInk}" />
                                            </DockPanel>
                                            <TextBlock Text="{x:Static app:Ui.CpuTestIntro}" FontSize="12" Style="{StaticResource Muted}" />
                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock Text="{x:Static app:Ui.LoadLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox ItemsSource="{Binding Workshop.CpuModes}" SelectedItem="{Binding Workshop.CpuMode}" DisplayMemberPath="Label"
                                                          IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Static app:Ui.LoadLabel}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Workshop.CpuModeDetail}" FontSize="12" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Text="{x:Static app:Ui.DurationLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="8,0,0,0"
                                                        Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartCpuTestCommand}" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.DurationLabel}" ItemsSource="{Binding Workshop.CpuDurations}" SelectedItem="{Binding Workshop.CpuDuration}" DisplayMemberPath="Label"
                                                          IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            </DockPanel>
                                            <ProgressBar Height="6" Margin="0,12,0,0" Maximum="100" Value="{Binding Workshop.CpuProgress, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Workshop.CpuStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelMintStroke}">
                                                    <TextBlock Style="{StaticResource NavIcon}" FontSize="17" Text="&#xE964;" Foreground="{DynamicResource PastelMintInk}" />
                                                </Border>
                                                <TextBlock Text="{x:Static app:Ui.RamTestTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelMintInk}" />
                                            </DockPanel>
                                            <TextBlock Text="{x:Static app:Ui.RamTestIntro}" FontSize="12" Style="{StaticResource Muted}" />
                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock Text="{x:Static app:Ui.SizeLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="8,0,0,0"
                                                        Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartRamTestCommand}" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.SizeLabel}" ItemsSource="{Binding Workshop.RamSizes}" SelectedItem="{Binding Workshop.RamSize}" DisplayMemberPath="Label"
                                                          IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            </DockPanel>
                                            <ProgressBar Height="6" Margin="0,12,0,0" Maximum="100" Value="{Binding Workshop.RamProgress, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Workshop.RamStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0" Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelRoseStroke}">
                                                <TextBlock Style="{StaticResource NavIcon}" FontSize="17" Text="&#xE7F4;" Foreground="{DynamicResource PastelRoseInk}" />
                                            </Border>
                                            <TextBlock Text="{x:Static app:Ui.VramTestTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelRoseInk}" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static app:Ui.VramTestIntro}" FontSize="12" Style="{StaticResource Muted}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="{x:Static app:Ui.CardLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.CardLabel}" MinWidth="260" Margin="0,0,16,4" ItemsSource="{Binding Workshop.VramAdapters}" SelectedItem="{Binding Workshop.VramAdapter}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <TextBlock Text="{x:Static app:Ui.SizeLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.SizeLabel}" MinWidth="200" Margin="0,0,16,4" ItemsSource="{Binding Workshop.VramSizes}" SelectedItem="{Binding Workshop.VramSize}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4"
                                                    Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartVramTestCommand}" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        </WrapPanel>
                                        <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100" Value="{Binding Workshop.VramProgress, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.VramStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelSandStroke}">
                                                <TextBlock Style="{StaticResource NavIcon}" FontSize="17" Text="&#xE945;" Foreground="{DynamicResource PastelSandInk}" />
                                            </Border>
                                            <TextBlock Text="{x:Static app:Ui.CoreTestTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelSandInk}" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static app:Ui.CoreTestIntro}" FontSize="12" Style="{StaticResource Muted}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="{x:Static app:Ui.LoadLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox MinWidth="260" Margin="0,0,12,4" ItemsSource="{Binding Workshop.CpuModes}" SelectedItem="{Binding Workshop.CoreMode}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Static app:Ui.LoadLabel}" />
                                            <TextBlock Text="{Binding Workshop.CoreModeDetail}" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Text="{x:Static app:Ui.DurationLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox AutomationProperties.Name="{x:Static app:Ui.DurationLabel}" MinWidth="220" Margin="0,0,16,4" ItemsSource="{Binding Workshop.CoreDurations}" SelectedItem="{Binding Workshop.CoreDuration}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4"
                                                    Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartCoreTestCommand}" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        </WrapPanel>
                                        <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100" Value="{Binding Workshop.CoreProgress, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.CoreStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />

                                        <!-- Programme complet : phase cœur par cœur puis phase de transitoires, sur plusieurs heures. -->
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" Background="{DynamicResource PastelSandStroke}" />
                                        <TextBlock Text="{x:Static app:Ui.CurveProgramTitle}" FontWeight="SemiBold" Foreground="{DynamicResource PastelSandInk}" />
                                        <TextBlock Text="{x:Static app:Ui.CurveProgramIntro}" FontSize="12" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{x:Static app:Ui.DurationLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox MinWidth="220" Margin="0,0,16,4" ItemsSource="{Binding Workshop.CurvePrograms}" SelectedItem="{Binding Workshop.CurveProgram}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Static app:Ui.CurveProgramTitle}" />
                                            <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4"
                                                    Content="{x:Static app:Ui.StartProgram}" Command="{Binding Workshop.StartCurveProgramCommand}" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                        </WrapPanel>
                                        <ProgressBar Height="10" Margin="0,8,0,0" Maximum="100" Value="{Binding Workshop.CurveProgress, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Workshop.CurveStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <ItemsControl ItemsSource="{Binding Workshop.CoreChips}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ws:CoreChipViewModel}">
                                                    <Border Style="{StaticResource Chip}" Background="{Binding Background}">
                                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Partie 2 : vitesse -->
                                <Border Style="{StaticResource Divider}" Margin="0,22,0,16" />
                                <TextBlock Text="{x:Static app:Ui.TestsSpeed}" Style="{StaticResource ZoneTitle}" FontSize="17" />
                                <TextBlock Text="{x:Static app:Ui.TestsSpeedIntro}" Style="{StaticResource Muted}" FontSize="12" Margin="0,-4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelAqua}" BorderBrush="{DynamicResource PastelAquaStroke}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelAquaStroke}">
                                                    <TextBlock Style="{StaticResource NavIcon}" FontSize="17" Text="&#xEDA2;" Foreground="{DynamicResource PastelAquaInk}" />
                                                </Border>
                                                <TextBlock Text="{x:Static app:Ui.DiskTestTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelAquaInk}" />
                                            </DockPanel>
                                            <TextBlock Text="{x:Static app:Ui.DiskTestIntro}" FontSize="12" Style="{StaticResource Muted}" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <TextBlock Text="{x:Static app:Ui.DriveLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.DriveLabel}" MinWidth="200" Margin="0,0,12,4" ItemsSource="{Binding Workshop.Drives}" SelectedItem="{Binding Workshop.Drive}"
                                                          DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <TextBlock Text="{x:Static app:Ui.SizeLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.SizeLabel}" MinWidth="140" Margin="0,0,12,4" ItemsSource="{Binding Workshop.DiskSizes}" SelectedItem="{Binding Workshop.DiskSize}"
                                                          DisplayMemberPath="Label" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                                <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,0,4"
                                                        Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartDiskTestCommand}" IsEnabled="{Binding Workshop.IsIdle, Mode=OneWay}" />
                                            </WrapPanel>
                                            <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100" Value="{Binding Workshop.DiskProgress, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Workshop.DiskStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelLilacStroke}">
                                                    <TextBlock Style="{StaticResource NavIcon}" FontSize="17" Text="&#xE701;" Foreground="{DynamicResource PastelLilacInk}" />
                                                </Border>
                                                <TextBlock Text="{x:Static app:Ui.NetTestTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelLilacInk}" />
                                            </DockPanel>
                                            <TextBlock Text="{x:Static app:Ui.NetTestIntro}" FontSize="12" Style="{StaticResource Muted}" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4"
                                                        Content="{x:Static app:Ui.Start}" Command="{Binding Workshop.StartNetTestCommand}" IsEnabled="{Binding Workshop.IsNotNetTesting, Mode=OneWay}" />
                                                <Button Style="{StaticResource DangerButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.Stop}"
                                                        Command="{Binding Workshop.StopNetTestCommand}" Visibility="{Binding Workshop.IsNetTesting, Converter={StaticResource BoolToVisibility}}" />
                                            </WrapPanel>
                                            <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100" Value="{Binding Workshop.NetProgress, Mode=OneWay}" />
                                            <TextBox Text="{Binding Workshop.NetStatus, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Partie 3 : historique des scores -->
                                <Border Style="{StaticResource Divider}" Margin="0,22,0,16" />
                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelGreyStroke}">
                                                <TextBlock Style="{StaticResource NavIcon}" FontSize="17" Text="&#xE9D2;" Foreground="{DynamicResource PastelGreyInk}" />
                                            </Border>
                                            <TextBlock Text="{x:Static app:Ui.ScoreHistoryTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static app:Ui.ScoreHistoryIntro}" FontSize="12" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <ComboBox AutomationProperties.Name="{x:Static app:Ui.ScoreHistoryTitle}" MinWidth="260" Margin="0,10,0,4" HorizontalAlignment="Left" ItemsSource="{Binding Workshop.ScoreKinds}" SelectedItem="{Binding Workshop.ScoreKind}"
                                                  DisplayMemberPath="Label" Visibility="{Binding Workshop.HasScores, Converter={StaticResource BoolToVisibility}}" />
                                        <controls:Sparkline Height="60" Margin="0,8,0,0" Values="{Binding Workshop.ScoreSeries, Mode=OneWay}" Maximum="0" Stroke="{StaticResource MausBlue}" />
                                        <TextBlock Text="{Binding Workshop.ScoreTrend}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Workshop.ScoreLines}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" Style="{StaticResource Muted}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Stockage : qu'est-ce qui prend de la place ? -->
                    <TabItem Header="{x:Static app:Ui.SectionStorage}" Style="{StaticResource PillTab}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{x:Static app:Ui.DriveLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.DriveLabel}" MinWidth="260" Margin="0,0,12,4" ItemsSource="{Binding Workshop.Drives}" SelectedItem="{Binding Workshop.Drive}" DisplayMemberPath="Label"
                                          IsEnabled="{Binding Workshop.IsNotScanning, Mode=OneWay}" />
                                <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.Analyze}"
                                        Command="{Binding Workshop.ScanCommand}" IsEnabled="{Binding Workshop.IsNotScanning, Mode=OneWay}" />
                                <Button Style="{StaticResource DangerButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.Stop}"
                                        Command="{Binding Workshop.StopScanCommand}" Visibility="{Binding Workshop.IsScanning, Converter={StaticResource BoolToVisibility}}" />
                                <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.StorageSense}" Command="{Binding Workshop.StorageSettingsCommand}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Workshop.ScanStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Left" Padding="12,4" Content="{x:Static app:Ui.GoUp}" Command="{Binding Workshop.UpCommand}" IsEnabled="{Binding Workshop.CanGoUp, Mode=OneWay}" />
                                <Button DockPanel.Dock="Right" Padding="12,4" Content="{x:Static app:Ui.OpenInExplorer}" Command="{Binding Workshop.OpenCurrentFolderCommand}" />
                                <TextBlock Text="{Binding Workshop.CurrentPath}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Border DockPanel.Dock="Right" Width="330" Margin="12,0,0,0" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.LargestTitle}" Style="{StaticResource CardTitle}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Workshop.LargestFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ws:SpaceEntryViewModel}">
                                                    <DockPanel Margin="0,4">
                                                        <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.ShowEntry}" Command="{Binding ShowCommand}" Padding="8,1" FontSize="11" VerticalAlignment="Top" />
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Size}" FontSize="12" Style="{StaticResource Muted}" />
                                                            <TextBlock Text="{Binding Hint}" FontSize="11" Style="{StaticResource Muted}"
                                                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Workshop.SpaceEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:SpaceEntryViewModel}">
                                            <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource NavIcon}" Foreground="{StaticResource MausGold}" FontSize="18"
                                                               Text="{Binding Icon}" Margin="0,0,10,0" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{x:Static app:Ui.OpenEntry}" Command="{Binding OpenCommand}" Padding="10,2" Margin="6,0,0,0"
                                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Content="{x:Static app:Ui.ShowEntry}" Command="{Binding ShowCommand}" Padding="10,2" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel DockPanel.Dock="Right" Width="150" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock>
                                                            <Run Text="{Binding Size, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="  " />
                                                            <Run Text="{Binding Percent, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <ProgressBar Height="5" Maximum="1" Value="{Binding Share, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Hint}" FontSize="11" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Mémoire : fiche complète (SPD, timings réels, horloges) -->
                    <TabItem Header="{x:Static app:Ui.SectionMemory}" Style="{StaticResource PillTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.ReadMemory}"
                                            Command="{Binding Workshop.ReadMemoryCommand}" IsEnabled="{Binding Workshop.IsNotReadingMemory, Mode=OneWay}" />
                                    <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.CopyMemory}" Command="{Binding Workshop.CopyMemoryCommand}"
                                            IsEnabled="{Binding Workshop.HasMemoryReport, Mode=OneWay}" />
                                    <Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,4" Content="{x:Static app:Ui.InstallPawnIo}"
                                            Command="{Binding Workshop.InstallPawnIoCommand}" Visibility="{Binding Workshop.IsMemoryDriverMissing, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Workshop.MemoryStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Workshop.HasMemoryConfiguration, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.MemoryAppliedTitle}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Workshop.MemoryConfiguration, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <!-- Étalonnage de la tension de la mémoire, avec celle réglée dans le BIOS (carte mère non décrite) -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding Workshop.CanCalibrateVoltage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Static app:Ui.CalibrationTitle}" Style="{StaticResource SectionLabel}" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBox Width="80" Text="{Binding Workshop.CalibrationInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Ui.CalibrationTitle}" />
                                                <TextBlock Text="V" VerticalAlignment="Center" Margin="6,0,12,0" />
                                                <Button Content="{x:Static app:Ui.FindInputs}" Command="{Binding Workshop.FindCandidatesCommand}" Padding="12,4" Margin="0,0,8,4" />
                                                <Button Content="{x:Static app:Ui.ForgetCalibration}" Command="{Binding Workshop.ForgetCalibrationCommand}" Padding="12,4" Margin="0,0,8,4"
                                                        Visibility="{Binding Workshop.HasCalibration, Converter={StaticResource BoolToVisibility}}" />
                                            </WrapPanel>
                                            <ListBox ItemsSource="{Binding Workshop.VoltageCandidates}" SelectedItem="{Binding Workshop.SelectedCandidate}" DisplayMemberPath="Label"
                                                     MaxHeight="170" Margin="0,6,0,0" Visibility="{Binding Workshop.HasVoltageCandidates, Converter={StaticResource BoolToVisibility}}"
                                                     AutomationProperties.Name="{x:Static app:Ui.CalibrationTitle}" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.UseInput}" Command="{Binding Workshop.UseCandidateCommand}" Padding="14,5"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Workshop.HasVoltageCandidates, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Workshop.CalibrationStatus}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Comparaison avec une lecture précédente (avant / après un réglage dans le BIOS) -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Workshop.HasComparisonOptions, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.CompareTitle}" Style="{StaticResource CardTitle}" />
                                        <ComboBox ItemsSource="{Binding Workshop.ComparisonOptions}" SelectedItem="{Binding Workshop.ComparisonChoice}" DisplayMemberPath="Label"
                                                  HorizontalAlignment="Left" MinWidth="360" Margin="0,6,0,0" AutomationProperties.Name="{x:Static app:Ui.CompareTitle}" />
                                        <TextBlock Text="{Binding Workshop.MemoryComparison}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding Workshop.HasMemoryComparison, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Workshop.HasMemoryClocks, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.MemoryControllerTitle}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Workshop.MemoryClocks}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Workshop.MemorySettings}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Workshop.LiveTimingBlocks}" Margin="-6,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:TimingBlockViewModel}">
                                            <Border Style="{StaticResource Card}" Margin="6" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type ws:TimingRowViewModel}">
                                                                <DockPanel Margin="0,1" ToolTip="{Binding Hint}" Background="Transparent">
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" />
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Workshop.MemoryModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:MemoryModuleViewModel}">
                                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,8">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Profiles}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type ws:TimingBlockViewModel}">
                                                                <Border BorderThickness="1" BorderBrush="#40808080" CornerRadius="6" Padding="10" Margin="0,0,8,8" Width="250">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,2,0,6" />
                                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type ws:TimingRowViewModel}">
                                                                                    <DockPanel Margin="0,1" ToolTip="{Binding Hint}" Background="Transparent">
                                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" />
                                                                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" />
                                                                                    </DockPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Workshop.MemoryNotes}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}" Margin="0,12,0,0"
                                           Visibility="{Binding Workshop.HasMemoryNotes, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{x:Static app:Ui.MemoryHonest}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pilotes : liste complète (lecture seule) et actions manuelles sur le pilote de la carte graphique -->
                    <TabItem Header="{x:Static app:Ui.SectionDrivers}" Style="{StaticResource PillTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.RefreshList}" Command="{Binding Workshop.RefreshDriversCommand}" />
                                    <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.CopyList}" ToolTip="{x:Static app:Ui.CopySheetTip}" Command="{Binding Workshop.CopyDriversCommand}" />
                                    <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.DriverBackupsFolder}" Command="{Binding Workshop.OpenDriverBackupsCommand}" />
                                    <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.RestoreDriverBackup}" Command="{Binding Workshop.RestoreDriverBackupCommand}" />
                                    <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.DriverUpdates}" ToolTip="{x:Static app:Ui.DriverUpdatesTip}" Command="{Binding Workshop.OpenDriverUpdatesCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Workshop.DriversStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10" Visibility="{Binding Workshop.IsReadingDrivers, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{x:Static app:Ui.DriversGpuTitle}" Style="{StaticResource CardTitle}" Margin="0,4,0,4" />
                                <TextBlock Text="{x:Static app:Ui.DriversIntro}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Workshop.GraphicsDrivers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:GraphicsDriverCardViewModel}">
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" appearance:Motion.EnterOnLoad="True">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <controls:LetterTile DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" Text="G" Fill="{StaticResource MausRed}" />
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type ws:InfoLine}">
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="220" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding PackageNote}" FontSize="12" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8" />
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,4" Content="{x:Static app:Ui.RestartDriver}"
                                                                ToolTip="{x:Static app:Ui.RestartDriverTip}" Command="{Binding RestartCommand}" />
                                                        <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.ReinstallDevice}" ToolTip="{x:Static app:Ui.ReinstallDeviceTip}" Command="{Binding ReinstallCommand}"
                                                                IsEnabled="{Binding CanReinstall, Mode=OneWay}" ToolTipService.ShowOnDisabled="True" />
                                                        <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.BackupDriver}" Command="{Binding BackupCommand}"
                                                                IsEnabled="{Binding CanBackupOrRemove, Mode=OneWay}" />
                                                        <Button Style="{StaticResource DangerButton}" Padding="14,6" Margin="0,0,8,4" Content="{x:Static app:Ui.RemoveDriver}"
                                                                ToolTip="{x:Static app:Ui.RemoveDriverTip}" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanBackupOrRemove, Mode=OneWay}" />
                                                        <Button Padding="12,5" Margin="0,0,8,4" Content="{x:Static app:Ui.DriverPage}" Command="{Binding DownloadCommand}"
                                                                Visibility="{Binding HasDownloadPage, Converter={StaticResource BoolToVisibility}}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,8,0,6">
                                    <TextBox DockPanel.Dock="Right" Width="260" Text="{Binding Workshop.DriverFilter, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{x:Static app:Ui.DriverFilterLabel}" ToolTip="{x:Static app:Ui.DriverFilterLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{x:Static app:Ui.FilterLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Static app:Ui.DriversAllTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Workshop.DriversSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{x:Static app:Ui.DriversDateNote}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                <Button Content="{x:Static app:Ui.ShowUnsignedDrivers}" Command="{Binding Workshop.ShowUnsignedDriversCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8"
                                        Visibility="{Binding Workshop.HasUnsignedDrivers, Converter={StaticResource BoolToVisibility}}" />
                                <DataGrid ItemsSource="{Binding Workshop.DriverRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None" Height="480" BorderThickness="0"
                                          Background="Transparent" RowBackground="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnFamily}" Binding="{Binding Group, Mode=OneWay}" Width="1.2*" />
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnDevice}" Binding="{Binding Device, Mode=OneWay}" Width="2.6*" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnVersion}" Binding="{Binding Version, Mode=OneWay}" Width="1.2*" />
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnDate}" Binding="{Binding Date, Mode=OneWay}" SortMemberPath="DateValue" Width="0.9*" />
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnAge}" Binding="{Binding Age, Mode=OneWay}" SortMemberPath="DateValue" Width="0.9*" />
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnProvider}" Binding="{Binding Provider, Mode=OneWay}" Width="1.4*" />
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnPackage}" Binding="{Binding Package, Mode=OneWay}" Width="0.9*" />
                                        <DataGridTextColumn Header="{x:Static app:Ui.ColumnSignature}" Binding="{Binding Signature, Mode=OneWay}" Width="1.4*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>

        <!-- Onglet 3 : historique et annulation -->
        <TabItem Style="{StaticResource NavTab}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource NavIconBox}" Background="{StaticResource MausGrey}">
                        <TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" />
                    </Border>
                    <TextBlock Text="{x:Static app:Ui.TabHistory}" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.TabHistory}" Style="{StaticResource PageTitle}" Margin="0,0,0,10" />
                <Border DockPanel.Dock="Top" Style="{StaticResource SoftCard}" Margin="0,0,0,14" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.Refresh}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RefreshJournalCommand}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE81C;" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource PastelLilacInk}" />
                        <TextBlock Text="{Binding JournalSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                                <Border Margin="0,0,0,10" Style="{StaticResource SoftCard}" Padding="16,12" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.RevertSession}"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PastelBlueStroke}"
                                                    Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="{DynamicResource MutedOpacity}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.SessionChanges}" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SessionChangeViewModel}">
                                                        <DockPanel Margin="0,0,0,8">
                                                            <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.Revert}" Padding="10,2" FontSize="12" VerticalAlignment="Top"
                                                                    Command="{Binding RevertCommand}" IsEnabled="{Binding CanRevert, Mode=OneWay}" />
                                                            <StackPanel Margin="0,0,10,0">
                                                                <TextBlock TextWrapping="Wrap">
                                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    <Run Text="  ·  " />
                                                                    <Run Text="{Binding State, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource MausGold}" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>

    <!-- Bas de la barre de navigation : langue, fenêtre de surveillance, paramètres (posés sur la barre, hors du gabarit). -->
    <StackPanel Width="232" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,16">
        <!-- Langue sur toute la largeur (le nom de la langue était coupé à côté des boutons), puis les trois boutons ronds. -->
        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding LanguageChoice}" DisplayMemberPath="Label" Margin="14,0,14,8"
                  AutomationProperties.Name="Language / Langue / Idioma" ToolTip="Language · Langue · Idioma" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Content="&#xE9D9;" Margin="0,0,12,0"
                    Command="{Binding OpenMonitorCommand}" ToolTip="{x:Static app:Ui.MonitorTitle}" AutomationProperties.Name="{x:Static app:Ui.MonitorTitle}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE946;" Margin="0,0,12,0"
                    Command="{Binding OpenAboutCommand}" ToolTip="{x:Static app:Ui.AboutTitle}" AutomationProperties.Name="{x:Static app:Ui.AboutTitle}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                    Command="{Binding OpenSettingsCommand}" ToolTip="{x:Static app:Ui.SettingsTitle}" AutomationProperties.Name="{x:Static app:Ui.SettingsTitle}" />
        </StackPanel>
    </StackPanel>
    </Grid>
</Window>
