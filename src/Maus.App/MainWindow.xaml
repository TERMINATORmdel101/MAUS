                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowDiskTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowDiskTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
