                                    </StackPanel>
                                </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowBatteryTest, Mode=OneWay}" Visibility="{Binding Workshop.ShowBatteryTest, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelAqua}" BorderBrush="{DynamicResource PastelAquaStroke}">
