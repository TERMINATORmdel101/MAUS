                                    </StackPanel>
                                </Border>

                                <Border appearance:Motion.EnterWhen="{Binding Workshop.ShowNetTests, Mode=OneWay}" Visibility="{Binding Workshop.ShowNetTests, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SoftCard}" Margin="0,0,0,12" Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                                    <StackPanel>
                                        <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.WifiWalkTitle}" Content="&#xE701;" Tag="{DynamicResource PastelRoseStroke}" Foreground="{DynamicResource PastelRoseInk}" />
                                        <TextBlock Text="{x:Static app:Ui.WifiWalkIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <WrapPanel><Button Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,10,8,0" Content="{x:Static app:Ui.StartOrStop}" Command="{Binding Workshop.ToggleWifiWalkCommand}" /></WrapPanel>
