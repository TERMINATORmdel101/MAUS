                                            Command="{Binding Workshop.InstallPawnIoCommand}" Visibility="{Binding Workshop.IsMemoryDriverMissing, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBlock Text="{x:Static app:Ui.ReadMemoryNeedsRights}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding Source={x:Static vm:ElevationState.Current}, Path=ShowLimitedBanner, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Workshop.MemoryStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Workshop.HasMemoryConfiguration, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.MemoryAppliedTitle}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Workshop.MemoryConfiguration, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <!-- Comparaison avec une lecture précédente (avant / après un réglage dans le BIOS) -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Workshop.HasComparisonOptions, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.CompareTitle}" Style="{StaticResource CardTitle}" />
                                        <ComboBox ItemsSource="{Binding Workshop.ComparisonOptions}" SelectedItem="{Binding Workshop.ComparisonChoice}" DisplayMemberPath="Label"
                                                  HorizontalAlignment="Left" MinWidth="360" Margin="0,6,0,0" AutomationProperties.Name="{x:Static app:Ui.CompareTitle}" />
                                        <TextBlock Text="{Binding Workshop.MemoryComparison}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding Workshop.HasMemoryComparison, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Workshop.HasMemoryClocks, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:Ui.MemoryControllerTitle}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Workshop.MemoryClocks}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeLead}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Workshop.MemorySettings}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.LiveTimingBlocks}" Margin="-6,0" ItemsPanel="{StaticResource ThreeColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:TimingBlockViewModel}">
                                            <Border Style="{StaticResource Card}" Margin="6" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                                    <ItemsControl Focusable="False" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TimingRow}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.MemoryModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:MemoryModuleViewModel}">
                                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                                    <ItemsControl Focusable="False" ItemsSource="{Binding Lines}" Margin="0,4,0,8">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl Focusable="False" ItemsSource="{Binding Profiles}" ItemsPanel="{StaticResource WrapItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type ws:TimingBlockViewModel}">
                                                                <Border BorderThickness="1" BorderBrush="#40808080" CornerRadius="6" Padding="10" Margin="0,0,8,8" Width="250">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,2,0,6" />
                                                                        <ItemsControl Focusable="False" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TimingRow}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Workshop.MemoryNotes}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,12,0,0"
                                           Visibility="{Binding Workshop.HasMemoryNotes, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{x:Static app:Ui.MemoryHonest}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pilotes : liste complète (lecture seule) et actions manuelles sur le pilote de la carte graphique -->
                    <TabItem Header="{x:Static app:Ui.SectionDrivers}" Style="{StaticResource SubPillTab}" Visibility="{Binding Workshop.ShowPcSections, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Workshop.DriversStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" IsIndeterminate="True" Height="4" Margin="0,0,0,10" Visibility="{Binding Workshop.IsReadingDrivers, Converter={StaticResource BoolToVisibility}}" />
                                <UniformGrid Rows="1" Height="72" Margin="0,8,0,0" Visibility="{Binding Workshop.IsReadingDrivers, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                </UniformGrid>

                                <!-- Zone 1 : la carte graphique et les actions sur son pilote. -->
                                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelRoseStroke}">
                                                <TextBlock Text="1" FontWeight="Bold" FontSize="{StaticResource FontSizeCardTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PastelRoseInk}" />
                                            </Border>
                                            <TextBlock Text="{x:Static app:Ui.DriversGpuTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelRoseInk}" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static app:Ui.DriversIntro}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                                        <!-- Actions avancées sur le pilote : mode technicien seulement ; le moteur et ses vérifications sont les mêmes. -->
                                        <TextBlock Text="{x:Static app:Ui.DriversIntroTechnician}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,0,0,10"
                                                   Visibility="{Binding Source={x:Static vm:DisplayMode.Current}, Path=IsTechnician, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.GraphicsDrivers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ws:GraphicsDriverCardViewModel}">
                                                    <Border Style="{StaticResource Card}" Margin="0,0,0,4" appearance:Motion.EnterOnLoad="True">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,10">
                                                                <controls:LetterTile DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" Text="G" Fill="{StaticResource MausRed}" />
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                            <ItemsControl Focusable="False" ItemsSource="{Binding Lines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type ws:InfoLine}">
                                                                        <Grid Margin="0,1">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="220" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding PackageNote}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                       Visibility="{Binding Source={x:Static vm:DisplayMode.Current}, Path=IsTechnician, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                            <WrapPanel Margin="0,8,0,0">
                                                                <WrapPanel appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}">
                                                                <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,4" Content="{x:Static app:Ui.RestartDriver}"
                                                                        ToolTip="{x:Static app:Ui.RestartDriverTip}" Command="{Binding RestartCommand}" />
                                                                <WrapPanel Visibility="{Binding Source={x:Static vm:DisplayMode.Current}, Path=IsTechnician, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,4" Content="{x:Static app:Ui.ReinstallDevice}" ToolTip="{x:Static app:Ui.ReinstallDeviceTip}" Command="{Binding ReinstallCommand}"
                                                                        appearance:WhyDisabled.Explain="True" IsEnabled="{Binding CanReinstall, Mode=OneWay}" ToolTipService.ShowOnDisabled="True" />
                                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,4" Content="{x:Static app:Ui.BackupDriver}" Command="{Binding BackupCommand}"
                                                                        appearance:WhyDisabled.Explain="True" IsEnabled="{Binding CanBackupOrRemove, Mode=OneWay}" />
                                                                <Button Style="{StaticResource DangerButton}" Padding="14,6" Margin="0,0,8,4" Content="{x:Static app:Ui.RemoveDriver}"
                                                                        ToolTip="{x:Static app:Ui.RemoveDriverTip}" Command="{Binding RemoveCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding CanBackupOrRemove, Mode=OneWay}" />
                                                                </WrapPanel>
                                                                </WrapPanel>
                                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,4" Content="{x:Static app:Ui.DriverPage}" Command="{Binding DownloadCommand}"
                                                                        Visibility="{Binding HasDownloadPage, Converter={StaticResource BoolToVisibility}}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Divider}" />

                                <!-- Zone 2 : tous les pilotes installés. -->
                                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding Workshop.DriverFilter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Static app:Ui.DriverFilterLabel}" ToolTip="{x:Static app:Ui.DriverFilterLabel}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{x:Static app:Ui.FilterLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelBlueStroke}">
                                                <TextBlock Text="2" FontWeight="Bold" FontSize="{StaticResource FontSizeCardTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PastelBlueInk}" />
                                            </Border>
                                            <TextBlock Text="{x:Static app:Ui.DriversAllTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource PastelBlueInk}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Workshop.DriversSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.DriversDateWhy}" Margin="0,0,0,8">
                                            <TextBlock Text="{x:Static app:Ui.DriversDateNote}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" />
                                        </Expander>
                                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.ShowUnsignedDrivers}" Command="{Binding Workshop.ShowUnsignedDriversCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                Visibility="{Binding Workshop.HasUnsignedDrivers, Converter={StaticResource BoolToVisibility}}" />
                                        <DataGrid AutomationProperties.Name="{x:Static app:Ui.SectionDrivers}" ItemsSource="{Binding Workshop.DriverRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None" Height="440" BorderThickness="0" controls:WheelChain.PassAtEdge="True"
                                                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" RowBackground="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnFamily}" Binding="{Binding Group, Mode=OneWay}" Width="1.2*" ElementStyle="{StaticResource GridCell}" />
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnDevice}" Binding="{Binding Device, Mode=OneWay}" Width="2.6*" FontWeight="SemiBold" ElementStyle="{StaticResource GridCell}" />
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnVersion}" Binding="{Binding Version, Mode=OneWay}" Width="1.2*" ElementStyle="{StaticResource GridCell}" />
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnDate}" Binding="{Binding Date, Mode=OneWay}" SortMemberPath="DateValue" Width="0.9*" ElementStyle="{StaticResource GridCell}" />
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnAge}" Binding="{Binding Age, Mode=OneWay}" SortMemberPath="DateValue" Width="0.9*" ElementStyle="{StaticResource GridCell}" />
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnProvider}" Binding="{Binding Provider, Mode=OneWay}" Width="1.4*" ElementStyle="{StaticResource GridCell}" />
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnPackage}" Binding="{Binding Package, Mode=OneWay}" Width="0.9*" ElementStyle="{StaticResource GridCell}" />
                                                <DataGridTextColumn Header="{x:Static app:Ui.ColumnSignature}" Binding="{Binding Signature, Mode=OneWay}" Width="1.4*" ElementStyle="{StaticResource GridCell}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Divider}" />

                                <!-- Zone 3 : outils, rangés par usage. -->
                                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelGrey}" BorderBrush="{DynamicResource PastelGreyStroke}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelGreyStroke}">
                                                <TextBlock Text="3" FontWeight="Bold" FontSize="{StaticResource FontSizeCardTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PastelGreyInk}" />
                                            </Border>
                                            <TextBlock Text="{x:Static app:Ui.DriversToolsTitle}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Static app:Ui.DriversListLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,6" />
                                            <WrapPanel Grid.Column="1">
                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Content="{x:Static app:Ui.RefreshList}" Command="{Binding Workshop.RefreshDriversCommand}" />
                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Content="{x:Static app:Ui.CopyList}" ToolTip="{x:Static app:Ui.CopySheetTip}" Command="{Binding Workshop.CopyDriversCommand}" />
                                            </WrapPanel>
                                            <TextBlock Grid.Row="1" Text="{x:Static app:Ui.DriversBackupsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,6"
                                                       Visibility="{Binding Source={x:Static vm:DisplayMode.Current}, Path=IsTechnician, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <WrapPanel Grid.Row="1" Grid.Column="1" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}"
                                                       Visibility="{Binding Source={x:Static vm:DisplayMode.Current}, Path=IsTechnician, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Content="{x:Static app:Ui.DriverBackupsFolder}" Command="{Binding Workshop.OpenDriverBackupsCommand}" />
                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Content="{x:Static app:Ui.RestoreDriverBackup}" Command="{Binding Workshop.RestoreDriverBackupCommand}" />
                                            </WrapPanel>
                                            <TextBlock Grid.Row="2" Text="{x:Static app:Ui.DriversUpdateLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,6" />
                                            <WrapPanel Grid.Row="2" Grid.Column="1">
                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,8,6" Content="{x:Static app:Ui.DriverUpdates}" ToolTip="{x:Static app:Ui.DriverUpdatesTip}" Command="{Binding Workshop.OpenDriverUpdatesCommand}" />
                                            </WrapPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>

        <!-- Onglet 3 : historique et annulation -->
        <TabItem Style="{StaticResource NavTab}" AutomationProperties.AcceleratorKey="Ctrl+5" AutomationProperties.Name="{x:Static app:Ui.TabHistory}" Header="{x:Static app:Ui.TabHistory}" Tag="&#xE81C;" Background="{StaticResource MausGrey}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.TabHistory}" Style="{StaticResource PageTitle}" Margin="0,0,0,10" />
                <Border DockPanel.Dock="Top" Style="{StaticResource SoftCard}" Margin="0,0,0,14" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding RevertTodayLabel}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RevertTodayCommand}" ToolTip="{x:Static app:Ui.RevertTodayTip}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}"
                                Visibility="{Binding HasRevertibleToday, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding RevertEverythingLabel}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RevertEverythingCommand}" ToolTip="{x:Static app:Ui.RevertEverythingTip}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}"
                                Visibility="{Binding HasRevertibleEarlier, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.Refresh}" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RefreshJournalCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PastelLilacStroke}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardIcon}" Text="&#xE81C;" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource PastelLilacInk}" />
                        <TextBlock Text="{Binding JournalSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <!-- Fréquences d'écran gardées après un essai (0.8.6) : hors du journal, mais annulables ici. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource SoftCard}" Margin="0,0,0,14" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}"
                        Visibility="{Binding HasKeptRefreshRates, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Ui.KeptRefreshTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelBlueInk}" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding KeptRefreshRates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:KeptRefreshRow}">
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding UndoLabel}" Command="{Binding Undo}" Margin="10,0,0,0" Padding="10,3" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding KeptRefreshStatus}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Points de restauration de Windows (0.8.2) -->
                <Border DockPanel.Dock="Top" Style="{StaticResource SoftCard}" Margin="0,0,0,14" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Ui.RestorePointsTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelMintInk}" />
                        <TextBlock Text="{Binding RestorePointsText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <WrapPanel>
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.ShowRestorePoints}" Margin="0,0,8,4" Command="{Binding ShowRestorePointsCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.CreateRestorePointNow}" Margin="0,0,8,4" Command="{Binding CreateManualRestorePointCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}" />
                            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.OpenSystemRestore}" Margin="0,0,8,4" Command="{Binding OpenSystemRestoreCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBox Text="{Binding FixReport, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,0,0,10" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static app:Ui.HistoryReportName}" Visibility="{Binding HasFixReport, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl Focusable="False" ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                                <Border Margin="0,0,0,10" Style="{StaticResource SoftCard}" Padding="16,12" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}">
                                                <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.RevertSession}"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource PastelBlueStroke}"
                                                        Command="{Binding RevertCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding CanRevert, Mode=OneWay}" />
                                            </Border>
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeSmall}" Opacity="{DynamicResource MutedOpacity}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.SessionChanges}" Margin="0,8,0,0">
                                            <ItemsControl Focusable="False" ItemsSource="{Binding Changes}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SessionChangeViewModel}">
                                                        <DockPanel Margin="0,0,0,8">
                                                            <Border DockPanel.Dock="Right" VerticalAlignment="Top" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=IsFull, Mode=OneWay}">
                                                                <Button Content="{x:Static app:Ui.Revert}" Padding="10,2" FontSize="{StaticResource FontSizeSmall}"
                                                                        Command="{Binding RevertCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding CanRevert, Mode=OneWay}" />
                                                            </Border>
                                                            <StackPanel Margin="0,0,10,0">
                                                                <TextBlock TextWrapping="Wrap">
                                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    <Run Text="  ·  " />
                                                                    <Run Text="{Binding State, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Note}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource PastelSandInk}" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                         FontFamily="Consolas" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- Benchmark : lancement (processus séparé en plein écran), dernier résultat détaillé, historique des passes. -->
        <TabItem Style="{StaticResource NavTab}" AutomationProperties.AcceleratorKey="Ctrl+6" AutomationProperties.Name="{x:Static app:Ui.NavBenchmark}" Header="{x:Static app:Ui.NavBenchmark}" Tag="&#xE7FC;" Background="{StaticResource MausRed}">
            <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{x:Static app:Ui.NavBenchmark}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{x:Static app:Ui.BenchmarkSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,14" />

                    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource TestCardHeader}" Header="{x:Static app:Ui.BenchmarkTitle}" Content="&#xE7FC;" Tag="{DynamicResource PastelRoseStroke}" Foreground="{DynamicResource PastelRoseInk}" />
                            <TextBlock Text="{x:Static app:Ui.BenchmarkIntro}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,14,0,0">
                                <TextBlock Text="{x:Static app:Ui.BenchmarkScopeLabel}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.BenchmarkScopeLabel}" MinWidth="320" Margin="0,0,18,6" ItemsSource="{Binding Workshop.BenchmarkScopes, Mode=OneWay}" SelectedItem="{Binding Workshop.BenchmarkScope}"
                                          DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsNotBenchmarkRunning, Mode=OneWay}" />
                                <TextBlock Text="{x:Static app:Ui.ApiLabel}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.ApiLabel}" MinWidth="200" Margin="0,0,18,6" ItemsSource="{Binding Workshop.BenchmarkApis, Mode=OneWay}" SelectedItem="{Binding Workshop.BenchmarkApi}"
                                          DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsNotBenchmarkRunning, Mode=OneWay}" />
                                <TextBlock Text="{x:Static app:Ui.ResolutionLabel}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <ComboBox AutomationProperties.Name="{x:Static app:Ui.ResolutionLabel}" MinWidth="200" Margin="0,0,18,6" ItemsSource="{Binding Workshop.BenchmarkResolutions, Mode=OneWay}" SelectedItem="{Binding Workshop.BenchmarkResolution}"
                                          DisplayMemberPath="Label" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsNotBenchmarkRunning, Mode=OneWay}" />
                                <CheckBox Content="{x:Static app:Ui.BenchmarkRayTracingOption}" IsChecked="{Binding Workshop.BenchmarkIncludeRayTracing}" ToolTip="{x:Static app:Ui.BenchmarkRayTracingTip}"
                                          VerticalAlignment="Center" Margin="0,0,0,6" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsNotBenchmarkRunning, Mode=OneWay}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Padding="24,9" Margin="0,0,14,4" Content="{x:Static app:Ui.BenchmarkStart}"
                                        Command="{Binding Workshop.StartBenchmarkCommand}" appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Workshop.IsNotBenchmarkRunning, Mode=OneWay}" />
                                <TextBlock Text="{Binding Workshop.BenchmarkDuration, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                            </WrapPanel>
                            <ProgressBar AutomationProperties.Name="{x:Static app:Ui.ProgressLabel}" IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="{Binding Workshop.IsBenchmarkRunning, Converter={StaticResource BoolToVisibility}}" />
                                <UniformGrid Rows="1" Height="72" Margin="0,8,0,0" Visibility="{Binding Workshop.IsBenchmarkRunning, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                    <Border Style="{StaticResource Skeleton}" />
                                </UniformGrid>
                            <TextBlock Text="{Binding Workshop.BenchmarkStatus, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0" Visibility="{Binding Workshop.HasNoBenchmark, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static app:Ui.BenchmarkNone}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                    </Border>

                    <StackPanel Visibility="{Binding Workshop.HasBenchmark, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Divider}" Margin="0,22,0,16" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.BenchmarkCopy}" Command="{Binding Workshop.CopyBenchmarkCommand}" VerticalAlignment="Center" Padding="14,6" />
                            <StackPanel>
                                <TextBlock Text="{x:Static app:Ui.BenchmarkLast}" Style="{StaticResource ZoneTitle}" FontSize="{StaticResource FontSizeCardTitle}" />
                                <TextBlock Text="{Binding Workshop.BenchmarkWhen, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" Margin="0,-4,0,0" />
                                <TextBlock Text="{Binding Workshop.BenchmarkOldEdition, Mode=OneWay}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Margin="0,6,12,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource MausRed}" Visibility="{Binding Workshop.HasBenchmarkOldEdition, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                        <UniformGrid Rows="1" Margin="-6,0,-6,0">
                            <Button Style="{StaticResource ActionCard}" Margin="6" Tag="all" Click="OnBenchmarkDetail" ToolTip="{x:Static app:Ui.BenchmarkTileHint}" AutomationProperties.Name="{x:Static app:Ui.BenchmarkCombined}"
                                    Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeSmall}" Text="&#xE76C;" Foreground="{DynamicResource PastelLilacInk}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelLilacStroke}">
                                            <TextBlock Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeCardTitle}" Text="&#xE734;" Foreground="{DynamicResource PastelLilacInk}" />
                                        </Border>
                                        <TextBlock Text="{x:Static app:Ui.BenchmarkCombined}" Foreground="{DynamicResource PastelLilacInk}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock appearance:Motion.RollingText="{Binding Workshop.BenchmarkOverall, Mode=OneWay}" FontSize="38" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workshop.BenchmarkVerdict, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionCard}" Margin="6" Tag="gpu" Click="OnBenchmarkDetail" ToolTip="{x:Static app:Ui.BenchmarkTileHint}" AutomationProperties.Name="{x:Static app:Ui.GpuLabel}"
                                    Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeSmall}" Text="&#xE76C;" Foreground="{DynamicResource PastelBlueInk}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelBlueStroke}">
                                            <TextBlock Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeCardTitle}" Text="&#xE7F4;" Foreground="{DynamicResource PastelBlueInk}" />
                                        </Border>
                                        <TextBlock Text="{x:Static app:Ui.GpuLabel}" Foreground="{DynamicResource PastelBlueInk}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock appearance:Motion.RollingText="{Binding Workshop.BenchmarkGpu, Mode=OneWay}" FontSize="38" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workshop.BenchmarkGpuName, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Workshop.BenchmarkGpuWarning, Mode=OneWay}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                                               Foreground="{StaticResource MausRed}" Visibility="{Binding Workshop.HasBenchmarkGpuWarning, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionCard}" Margin="6" Tag="cpu" Click="OnBenchmarkDetail" ToolTip="{x:Static app:Ui.BenchmarkTileHint}" AutomationProperties.Name="{x:Static app:Ui.CpuLabel}"
                                    Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeSmall}" Text="&#xE76C;" Foreground="{DynamicResource PastelMintInk}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelMintStroke}">
                                            <TextBlock Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeCardTitle}" Text="&#xE950;" Foreground="{DynamicResource PastelMintInk}" />
                                        </Border>
                                        <TextBlock Text="{x:Static app:Ui.CpuLabel}" Foreground="{DynamicResource PastelMintInk}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock appearance:Motion.RollingText="{Binding Workshop.BenchmarkCpu, Mode=OneWay}" FontSize="38" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workshop.BenchmarkCpuName, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Workshop.BenchmarkCpuWarning, Mode=OneWay}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                                               Foreground="{StaticResource MausRed}" Visibility="{Binding Workshop.HasBenchmarkCpuWarning, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionCard}" Margin="6" Tag="rt" Click="OnBenchmarkDetail" ToolTip="{x:Static app:Ui.BenchmarkTileHint}" AutomationProperties.Name="{x:Static app:Ui.BenchmarkRayTracingTitle}"
                                    Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}" Visibility="{Binding Workshop.HasBenchmarkRayTracing, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeSmall}" Text="&#xE76C;" Foreground="{DynamicResource PastelSandInk}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{DynamicResource PastelSandStroke}">
                                            <TextBlock Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeCardTitle}" Text="&#xE706;" Foreground="{DynamicResource PastelSandInk}" />
                                        </Border>
                                        <TextBlock Text="{x:Static app:Ui.BenchmarkRayTracingTitle}" Foreground="{DynamicResource PastelSandInk}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock appearance:Motion.RollingText="{Binding Workshop.BenchmarkRayTracing, Mode=OneWay}" FontSize="38" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workshop.BenchmarkGpuName, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeNote}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="{Binding Workshop.BenchmarkRayTracingNote, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="2,10,0,0"
                                   Visibility="{Binding Workshop.HasBenchmarkRayTracingNote, Converter={StaticResource BoolToVisibility}}" />

                        <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0" Visibility="{Binding Workshop.HasBenchmarkImage, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource ActionCard}" Margin="0,0,18,0" Click="OnBenchmarkPicture" ToolTip="{x:Static app:Ui.BenchmarkImageZoom}"
                                        Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="{x:Static app:Ui.BenchmarkImageZoom}">
                                    <Image x:Name="BenchmarkPicture" Source="{Binding Workshop.BenchmarkImageSource, Mode=OneWay}" Width="384" Height="216" Stretch="Uniform">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,384,216" RadiusX="8" RadiusY="8" />
                                        </Image.Clip>
                                    </Image>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static app:Ui.BenchmarkImageTitle}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" />
                                    <TextBlock Text="{x:Static app:Ui.BenchmarkImageDetail}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,4,0,12" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.BenchmarkImageCopy}" Command="{Binding Workshop.CopyBenchmarkImageCommand}" Margin="0,0,8,6" Padding="14,6" />
                                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.BenchmarkImageOpen}" Command="{Binding Workshop.OpenBenchmarkImageCommand}" Margin="0,0,8,6" Padding="14,6" />
                                        <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.BenchmarkImageFolder}" Command="{Binding Workshop.ShowBenchmarkImageCommand}" Margin="0,0,8,6" Padding="14,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static app:Ui.BenchmarkCompareHeading}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLead}" />
                                <TextBlock Text="{x:Static app:Ui.BenchmarkCompareDetail}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,4,0,8" />
                                <TextBox Text="{Binding Workshop.BenchmarkCompareText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static app:Ui.BenchmarkCompareHeading}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.BenchmarkCompareButton}" Command="{Binding Workshop.CompareBenchmarkCommand}" Margin="0,0,8,6" Padding="14,6" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Workshop.BenchmarkCompareStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding Workshop.HasBenchmarkComparison, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Workshop.BenchmarkCompareTitle, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Workshop.BenchmarkCompareWarning, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource MausRed}" Margin="0,4,0,0"
                                               Visibility="{Binding Workshop.HasBenchmarkCompareWarning, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid Margin="0,10,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static app:Ui.BenchmarkCompareTest}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="{x:Static app:Ui.BenchmarkCompareMine}" Style="{StaticResource Muted}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{x:Static app:Ui.BenchmarkCompareTheirs}" Style="{StaticResource Muted}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{x:Static app:Ui.BenchmarkCompareGap}" Style="{StaticResource Muted}" TextAlignment="Right" />
                                    </Grid>
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.BenchmarkCompareRows, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Mine, Mode=OneWay}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Theirs, Mode=OneWay}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Difference, Mode=OneWay}" TextAlignment="Right" FontWeight="SemiBold" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Divider}" Margin="0,22,0,16" Visibility="{Binding Workshop.HasBenchmarkRanking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding Workshop.HasBenchmarkRanking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static app:Ui.BenchmarkRankingTitle}" Style="{StaticResource ZoneTitle}" FontSize="{StaticResource FontSizeCardTitle}" />
                            <TextBlock Text="{x:Static app:Ui.BenchmarkRankingIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SoftCard}">
                                <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.BenchmarkRanking, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.BenchmarkRankingCompare}" Padding="10,2" FontSize="{StaticResource FontSizeSmall}" Margin="8,0,0,0"
                                                        Command="{Binding Compare, Mode=OneWay}" Visibility="{Binding CanCompare, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding When, Mode=OneWay}" />
                                                <TextBlock DockPanel.Dock="Left" Width="30" Text="{Binding Rank, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Width="150" Text="{Binding When, Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Width="80" Text="{Binding Points, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Width="110" Text="{Binding Gap, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Settings, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Historique replié sous le classement : même liste de passes, avec la courbe et ses repères. -->
                        <Expander Style="{StaticResource QuietExpander}" Header="{x:Static app:Ui.BenchmarkHistoryTitle}" Margin="0,16,0,0">
                            <Border Style="{StaticResource SoftCard}" Margin="0,8,0,4">
                                <StackPanel>
                                    <Border Background="Transparent" ToolTip="{Binding Workshop.BenchmarkTrendMarksText, Mode=OneWay}" AutomationProperties.HelpText="{Binding Workshop.BenchmarkTrendMarksText, Mode=OneWay}">
                                        <controls:Sparkline Height="70" Values="{Binding Workshop.BenchmarkTrend, Mode=OneWay}" Marks="{Binding Workshop.BenchmarkTrendMarks, Mode=OneWay}" Maximum="0" Stroke="{StaticResource MausRed}" />
                                    </Border>
                                    <TextBlock Text="{x:Static app:Ui.BenchmarkMarkersNote}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Workshop.HasBenchmarkMarkers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Workshop.BenchmarkRuns, Mode=OneWay}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding EditionHeading, Mode=OneWay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,8,0,4" Visibility="{Binding HasEditionHeading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Width="150" Text="{Binding When, Mode=OneWay}" Style="{StaticResource Muted}" />
                                                        <TextBlock Text="{Binding Summary, Mode=OneWay}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Marker, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="150,4,0,1" Visibility="{Binding HasMarker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Suivi : ce qui donne une raison de revenir, sans inventer de problème. Dernière place : l'ordre des autres pages et la dernière page gardée ne bougent pas. -->
        <TabItem Style="{StaticResource NavTab}" AutomationProperties.AcceleratorKey="Ctrl+7" AutomationProperties.Name="{x:Static app:Ui.TabFollow}" Header="{x:Static app:Ui.TabFollow}" Tag="&#xE9D2;" Background="{StaticResource MausGrey}">
            <follow:FollowPage />
        </TabItem>
    </controls:PageTabControl>

    <!-- Bas de la barre de navigation : langue, fenêtre de surveillance, paramètres (posés sur la barre, hors du gabarit). -->
    <StackPanel Width="232" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,16">
        <!-- Langue sur toute la largeur (le nom de la langue était coupé à côté des boutons), puis les quatre boutons ronds. -->
        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding LanguageChoice}" DisplayMemberPath="Label" Margin="14,0,14,8"
                  AutomationProperties.Name="Language / Langue / Idioma" ToolTip="Language · Langue · Idioma" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Content="&#xE9D9;" Margin="0,0,12,0"
                    Command="{Binding OpenMonitorCommand}" ToolTip="{x:Static app:Ui.MonitorTitle}" AutomationProperties.Name="{x:Static app:Ui.MonitorTitle}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE897;" Margin="0,0,12,0"
                    Command="{Binding OpenHelpSiteCommand}" ToolTip="{x:Static app:Ui.HelpSite}" AutomationProperties.Name="{x:Static app:Ui.HelpSite}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE946;" Margin="0,0,12,0"
                    Command="{Binding OpenAboutCommand}" ToolTip="{x:Static app:Ui.AboutTitle}" AutomationProperties.Name="{x:Static app:Ui.AboutTitle}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                    Command="{Binding OpenSettingsCommand}" ToolTip="{x:Static app:Ui.SettingsTitle}" AutomationProperties.Name="{x:Static app:Ui.SettingsTitle}" />
        </StackPanel>
    </StackPanel>

    <views:BenchmarkOverlay x:Name="BenchmarkOverlay" Panel.ZIndex="50" />
    </Grid>
</Window>
