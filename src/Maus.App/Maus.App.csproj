<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MAUS</AssemblyName>
    <RootNamespace>Maus.App</RootNamespace>
    <ApplicationIcon>Assets\maus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\maus.ico" />
    <Resource Include="Assets\maus-banner.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maus.Core\Maus.Core.csproj" />
  </ItemGroup>

</Project>
