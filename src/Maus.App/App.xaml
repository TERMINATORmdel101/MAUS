<Application x:Class="Maus.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Maus.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Maus.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:StatusToBrushConverter x:Key="StatusToBrush" />
            <views:ScoreToBrushConverter x:Key="ScoreToBrush" />
            <views:LetterToBrushConverter x:Key="LetterToBrush" />
            <views:TrustToBrushConverter x:Key="TrustToBrush" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
