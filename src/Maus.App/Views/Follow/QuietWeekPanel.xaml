<UserControl x:Class="Maus.App.Views.Follow.QuietWeekPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Maus.App.ViewModels">
    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelAqua}" BorderBrush="{DynamicResource PastelAquaStroke}">
        <StackPanel>
            <TextBlock Text="{x:Static vm:MainViewModel.QuietWeekTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding QuietWeekHeadline}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding QuietWeekPoints}" Focusable="False" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding QuietWeekNotes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource SoftButton}" Content="{x:Static vm:MainViewModel.QuietWeekSettingLabel}" AutomationProperties.Name="{x:Static vm:MainViewModel.QuietWeekSettingLabel}"
                    HorizontalAlignment="Left" Padding="12,3" Margin="0,8,0,0" Click="OnOpenSetting"
                    Visibility="{Binding CanOpenQuietWeekSetting, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding QuietWeekSettingNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasQuietWeekSettingNote, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
