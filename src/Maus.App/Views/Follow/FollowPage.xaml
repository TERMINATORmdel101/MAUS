<UserControl x:Class="Maus.App.Views.Follow.FollowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Maus.App"
             xmlns:controls="clr-namespace:Maus.App.Controls"
             xmlns:follow="clr-namespace:Maus.App.Views.Follow">
    <ScrollViewer controls:PageScroll.Enabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{x:Static app:Ui.TabFollow}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
            <TextBlock Text="{x:Static app:Ui.FollowIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <follow:WindowsUndidPanel Margin="0,0,0,14" />
            <follow:WhatChangedPanel Margin="0,0,0,14" />
            <follow:HealthLogPanel Margin="0,0,0,14" />
            <follow:CrashTimelinePanel Margin="0,0,0,14" />
            <follow:BeforeAfterPanel Margin="0,0,0,14" />
            <follow:QuietWeekPanel Margin="0,0,0,14" />
            <follow:NewPartPanel Margin="0,0,0,14" />
            <follow:PcFilePanel Margin="0,0,0,14" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
