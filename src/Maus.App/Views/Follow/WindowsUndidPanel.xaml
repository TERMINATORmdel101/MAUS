<UserControl x:Class="Maus.App.Views.Follow.WindowsUndidPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Maus.App"
             xmlns:appearance="clr-namespace:Maus.App.Appearance"
             xmlns:vm="clr-namespace:Maus.App.ViewModels">
    <Border Style="{StaticResource SoftCard}">
        <StackPanel>
            <TextBlock Text="{x:Static app:Ui.WindowsUndidTitle}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{x:Static app:Ui.WindowsUndidIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <!-- Windows a changé de version : dit simplement, et les états ci-dessous sont datés. -->
            <Border Style="{StaticResource SoftCard}" Margin="0,10,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}"
                    Visibility="{Binding HasWindowsUndidBuildChange, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding WindowsUndidBuildNote}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding WindowsUndidBuildNote}" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource Muted}"
                       Visibility="{Binding HasWindowsUndidPlainBuildNote, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding WindowsUndidSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="{Binding WindowsUndidNotice}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource PastelSandInk}"
                       Visibility="{Binding HasWindowsUndidNotice, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl Focusable="False" ItemsSource="{Binding WindowsUndidRows}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WindowsUndidRow}">
                        <StackPanel Margin="0,6,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding State}" FontSize="{StaticResource FontSizeNote}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{Binding Tone, Converter={StaticResource Pastel}, ConverterParameter=Ink}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding WindowsUndidNextStep}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}"
                       Visibility="{Binding HasWindowsUndidNextStep, Converter={StaticResource BoolToVisibility}}" />
            <WrapPanel Margin="0,10,0,0">
                <!-- Le même chemin que dans la page Corrections : recocher, rien de plus. L'utilisateur décide ensuite. -->
                <Button Style="{StaticResource SoftButton}" Content="{Binding RecheckComeBackLabel}" Command="{Binding WindowsUndidRecheckCommand}" Padding="12,4" Margin="0,0,10,6"
                        Visibility="{Binding HasComeBackChanges, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SoftButton}" Content="{Binding HomeAuditLabel}" Command="{Binding RunAuditCommand}" Padding="12,4" Margin="0,0,10,6"
                        Visibility="{Binding WindowsUndidCanAudit, Converter={StaticResource BoolToVisibility}}" />
                <!-- La demande d'autorisation de Windows ne vient que de ce clic. -->
                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.EnableAllFeatures}" ToolTip="{x:Static app:Ui.TipAllFeatures}" Padding="14,4" Margin="0,0,10,6"
                        appearance:WhyDisabled.Explain="True" IsEnabled="{Binding Source={x:Static vm:ElevationState.Current}, Path=CanEnable, Mode=OneWay}"
                        Command="{Binding Source={x:Static vm:ElevationState.Current}, Path=EnableAllCommand}"
                        Visibility="{Binding WindowsUndidNeedsRights, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
