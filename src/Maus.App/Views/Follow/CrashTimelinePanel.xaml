<UserControl x:Class="Maus.App.Views.Follow.CrashTimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Maus.App.ViewModels">
    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelRose}" BorderBrush="{DynamicResource PastelRoseStroke}">
        <StackPanel>
            <TextBlock Text="{x:Static vm:CrashTimelineUi.Title}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelRoseInk}" />
            <TextBlock Text="{x:Static vm:CrashTimelineUi.Intro}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,10,0,0">
                <Button Style="{StaticResource SoftButton}" Content="{Binding CrashTimelineReadLabel}" Command="{Binding ReadCrashTimelineCommand}" Margin="0,0,8,6" />
                <Button Style="{StaticResource SoftButton}" Content="{x:Static vm:CrashTimelineUi.CopyLabel}" Command="{Binding CopyCrashTimelineCommand}" Margin="0,0,8,6"
                        Visibility="{Binding HasCrashTimeline, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SoftButton}" Content="{x:Static vm:CrashTimelineUi.FindingsLabel}" Command="{Binding CrashTimelineFindingsCommand}" Margin="0,0,8,6"
                        Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <TextBlock Text="{Binding CrashTimelineStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <StackPanel Visibility="{Binding HasCrashTimeline, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding CrashTimelineSections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding HasCrashTimelineLines, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                    <TextBlock Text="{x:Static vm:CrashTimelineUi.Caution}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static vm:CrashTimelineUi.TimeNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{x:Static vm:CrashTimelineUi.RequestNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding CrashTimelineRows}" Focusable="False" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CrashTimelineRow}">
                                <Grid Margin="0,3">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCrash, Mode=OneWay}" Value="True">
                                                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CrashTimelineWhen" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CrashTimelineKind" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding What}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SoftButton}" Content="{Binding CrashTimelineShowAllLabel}" Command="{Binding ShowAllCrashTimelineCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Visibility="{Binding CanShowAllCrashTimeline, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
