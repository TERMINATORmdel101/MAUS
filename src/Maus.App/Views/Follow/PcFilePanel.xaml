<UserControl x:Class="Maus.App.Views.Follow.PcFilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SoftCard}">
        <StackPanel>
            <TextBlock Text="{Binding PcFileTitle}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding PcFileIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding PcFileIncludes}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <WrapPanel Margin="0,10,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding PcFilePrepareLabel}" Command="{Binding PreparePcFileCommand}" Padding="14,4" Margin="0,0,6,0" />
                <Button Style="{StaticResource SoftButton}" Content="{Binding PcFileSaveLabel}" Command="{Binding SavePcFileCommand}" Padding="12,4" Margin="0,0,6,0"
                        Visibility="{Binding HasPcFilePreview, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SoftButton}" Content="{Binding PcFilePrintLabel}" Command="{Binding PrintPcFileCommand}" Padding="12,4"
                        Visibility="{Binding HasPcFilePreview, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <TextBlock Text="{Binding PcFileStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                          Visibility="{Binding HasPcFilePreview, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding PcFilePreview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding PcFilePreviewName}" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
