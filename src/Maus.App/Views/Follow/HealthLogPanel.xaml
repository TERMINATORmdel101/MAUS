<UserControl x:Class="Maus.App.Views.Follow.HealthLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Maus.App"
             xmlns:controls="clr-namespace:Maus.App.Controls">
    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
        <StackPanel>
            <TextBlock Text="{x:Static app:Ui.HealthLogTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelMintInk}" />
            <TextBlock Text="{x:Static app:Ui.HealthLogIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding HealthLogMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasHealthLogMessage, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding HealthLogRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Current}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding First}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Visibility="{Binding HasFirst, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Range}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Visibility="{Binding HasRange, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Variation}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Unread}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <controls:Sparkline Grid.Column="1" Width="180" Height="44" Margin="14,4,0,0" VerticalAlignment="Top" Maximum="0"
                                                Values="{Binding Values, Mode=OneWay}" Stroke="{StaticResource MausBlue}"
                                                Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Focusable="False" ItemsSource="{Binding HealthLogNotes}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding HealthLogLastLine}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
