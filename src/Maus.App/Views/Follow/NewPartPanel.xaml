<UserControl x:Class="Maus.App.Views.Follow.NewPartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Maus.App.ViewModels"
             Loaded="OnLoaded">
    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
        <StackPanel>
            <TextBlock Text="{x:Static vm:MainViewModel.NewPartTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelBlueInk}" />
            <TextBlock Text="{x:Static vm:MainViewModel.NewPartIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <ItemsControl Focusable="False" ItemsSource="{Binding NewPartChanges}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Guide}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasGuide, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding Checks}" Margin="0,4,0,0"
                                          Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource SoftButton}" Content="{Binding OpenFindingsLabel}" Command="{Binding OpenFindings}" Margin="0,6,8,0"
                                        Visibility="{Binding ShowFindings, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource SoftButton}" Content="{Binding OpenBenchmarkLabel}" Command="{Binding OpenBenchmark}" Margin="0,6,8,0"
                                        Visibility="{Binding ShowBenchmark, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding NewPartStatus}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding NewPartUnread}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasNewPartUnread, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding NewPartList}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasNewPartList, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding NewPartNotice}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasNewPartNotice, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{x:Static vm:MainViewModel.NewPartNeedsAuditText}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding NewPartNeedsAudit, Converter={StaticResource BoolToVisibility}}" />

            <WrapPanel Margin="0,4,0,0">
                <Button Style="{StaticResource SoftButton}" Content="{x:Static vm:MainViewModel.NewPartReadLabel}" Command="{Binding ReadNewPartCommand}" Margin="0,6,8,0" />
                <Button Style="{StaticResource SoftButton}" Content="{x:Static vm:MainViewModel.NewPartAuditLabel}" Command="{Binding RunAuditCommand}" Margin="0,6,8,0"
                        Visibility="{Binding NewPartNeedsAudit, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
