<UserControl x:Class="Maus.App.Views.Follow.BeforeAfterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Maus.App">
    <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
        <StackPanel>
            <TextBlock Text="{x:Static app:Ui.BeforeAfterTitle}" Style="{StaticResource CardTitle}" Foreground="{DynamicResource PastelBlueInk}" />
            <TextBlock Text="{x:Static app:Ui.BeforeAfterIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding BeforeAfterMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasBeforeAfterMessage, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding BeforeAfterRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Visibility="{Binding HasFigures, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Before}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding After}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding Conclusion}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Caution}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding HasCaution, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding BeforeAfterNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasBeforeAfterNote, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
