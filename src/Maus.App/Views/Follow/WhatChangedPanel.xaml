<UserControl x:Class="Maus.App.Views.Follow.WhatChangedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Maus.App"
             xmlns:vm="clr-namespace:Maus.App.ViewModels">
    <!-- « Qu'est-ce qui a changé ? » : entre deux audits gardés, sans rien relire sur le PC. -->
    <Border Style="{StaticResource SoftCard}">
        <StackPanel>
            <TextBlock Text="{x:Static app:Ui.WhatChangedTitle}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{x:Static app:Ui.WhatChangedIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding WhatChangedEmpty}" TextWrapping="Wrap"
                       Visibility="{Binding ShowWhatChangedEmpty, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Visibility="{Binding HasWhatChanged, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static app:Ui.WhatChangedCompareLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox AutomationProperties.Name="{x:Static app:Ui.WhatChangedCompareLabel}" ToolTip="{x:Static app:Ui.WhatChangedCompareLabel}" MinWidth="260" HorizontalAlignment="Left" Margin="0,0,0,8"
                          ItemsSource="{Binding WhatChangedOptions}" SelectedItem="{Binding WhatChangedChoice}" DisplayMemberPath="Label" />
                <TextBlock Text="{Binding WhatChangedSummary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="{Binding WhatChangedVersionNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="{Binding HasWhatChangedVersionNote, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding WhatChangedRows}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WhatChangedRow}">
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{StaticResource FontSizeSmall}" Margin="0,3,8,0" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding OpenLabel}" Command="{Binding Open}" Padding="10,2" FontSize="{StaticResource FontSizeSmall}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasOpen, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding When}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding WhatChangedLinkHint}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasWhatChangedLinkHint, Converter={StaticResource BoolToVisibility}}" />
                <Expander Header="{x:Static app:Ui.WhatChangedNotesTitle}" Margin="0,8,0,0"
                          Visibility="{Binding HasWhatChangedNotes, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl Focusable="False" ItemsSource="{Binding WhatChangedNotes}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WhatChangedNote}">
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeSmall}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.WhatChangedCopyLabel}" Command="{Binding WhatChangedCopyCommand}" />
                    <TextBlock Text="{Binding WhatChangedStatus}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
