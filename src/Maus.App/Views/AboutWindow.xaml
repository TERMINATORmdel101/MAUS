<Window x:Class="Maus.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        Title="{x:Static app:Ui.AboutTitle}"
        Width="760" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
        <Style x:Key="AboutSection" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,6" />
        </Style>
        <DataTemplate x:Key="Paragraph">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" />
        </DataTemplate>
        <DataTemplate x:Key="Bullet">
            <DockPanel Margin="0,0,0,6">
                <Border DockPanel.Dock="Left" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource MausAccent}" Margin="2,7,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{x:Static app:Ui.ReportProblem}" Padding="14,6" Margin="0,0,8,4" Click="OnReport" />
                <Button Content="{x:Static app:Ui.ProjectPage}" Padding="14,6" Margin="0,0,8,4" Click="OnProject" />
                <Button Content="{x:Static app:Ui.LicensesFolder}" Padding="14,6" Margin="0,0,8,4" Click="OnLicenses" />
                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.CloseWindow}" Padding="20,6" Margin="0,0,0,4" IsCancel="True" IsDefault="True" Click="OnClose" />
            </WrapPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Page" Margin="28,24,28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Logo entier du porteur (réduit, jamais redessiné) : coins arrondis et ombre. -->
                    <Border Width="176" Height="176" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            AutomationProperties.Name="MAUS">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/maus-logo-512.png" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.35" />
                        </Border.Effect>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MAUS" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text="{x:Static app:Ui.AboutVersion}" FontSize="14" Margin="0,2,0,0" />
                        <TextBlock Text="{x:Static app:Ui.NameMeaning}" Opacity="{DynamicResource MutedOpacity}" Margin="0,4,0,0" />
                        <UniformGrid Rows="1" Height="4" Width="180" HorizontalAlignment="Left" Margin="0,12,0,12">
                            <Border Background="{StaticResource MausBlue}" CornerRadius="2" Margin="0,0,3,0" />
                            <Border Background="{StaticResource MausRed}" CornerRadius="2" Margin="0,0,3,0" />
                            <Border Background="{StaticResource MausGreen}" CornerRadius="2" Margin="0,0,3,0" />
                            <Border Background="{StaticResource MausGold}" CornerRadius="2" />
                        </UniformGrid>
                        <TextBlock Text="{x:Static app:Ui.AboutMadeBy}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{x:Static app:Ui.AboutLicenseTitle}" Style="{StaticResource AboutSection}" />
                <TextBlock Text="{x:Static app:Ui.AboutLicense}" TextWrapping="Wrap" />

                <TextBlock Text="{x:Static app:Ui.AboutPrivacyTitle}" Style="{StaticResource AboutSection}" />
                <TextBlock Text="{x:Static app:Ui.AboutPrivacy}" TextWrapping="Wrap" />

                <TextBlock Text="{x:Static app:Ui.ShowDisclaimer}" Style="{StaticResource AboutSection}" />
                <ItemsControl ItemsSource="{x:Static app:Ui.DisclaimerParagraphs}" ItemTemplate="{StaticResource Paragraph}" />

                <TextBlock Text="{x:Static app:Ui.AboutComponentsTitle}" Style="{StaticResource AboutSection}" />
                <ItemsControl ItemsSource="{x:Static app:Ui.AboutComponents}" ItemTemplate="{StaticResource Bullet}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
