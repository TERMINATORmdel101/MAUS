<Window x:Class="Maus.App.Views.SoftwareUpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:views="clr-namespace:Maus.App.Views"
        Title="{x:Static app:Ui.SoftwareTitle}"
        Width="680" Height="560" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
    </Window.Resources>
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.SoftwareTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,12" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap" Text="{x:Static app:Ui.SoftwareIntro}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static app:Ui.Cancel}" Padding="16,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{x:Static app:Ui.SoftwareUpdateSelected}" Padding="16,6" IsDefault="True" Click="OnValidate" />
        </StackPanel>
        <ListBox x:Name="Choices" BorderThickness="0" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:SoftwareChoice}">
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanUpdate}" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Opacity="{DynamicResource MutedOpacity}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
