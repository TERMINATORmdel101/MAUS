<Window x:Class="Maus.App.Views.LaptopChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        Title="{x:Static app:Ui.LaptopTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/maus.ico">
    <StackPanel Margin="24">
        <TextBlock Text="{x:Static app:Ui.LaptopQuestion}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,16" Opacity="0.8" TextWrapping="Wrap"
                   Text="{x:Static app:Ui.LaptopIntro}" />

        <RadioButton x:Name="Performance" GroupName="Choice" IsChecked="True" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static app:Ui.LaptopPerformance}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static app:Ui.LaptopPerformanceDetail}" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="Everywhere" GroupName="Choice" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static app:Ui.LaptopEverywhere}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static app:Ui.LaptopEverywhereDetail}" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="Battery" GroupName="Choice" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{x:Static app:Ui.LaptopBattery}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static app:Ui.LaptopBatteryDetail}" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static app:Ui.Later}" Padding="16,6" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{x:Static app:Ui.Validate}" Padding="16,6" IsDefault="True" Click="OnValidate" />
        </StackPanel>
    </StackPanel>
</Window>
