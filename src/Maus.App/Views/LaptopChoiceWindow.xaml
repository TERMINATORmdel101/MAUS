<Window x:Class="Maus.App.Views.LaptopChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        Title="{x:Static app:Ui.LaptopTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="{x:Static app:Ui.LaptopQuestion}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,16" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap"
                   Text="{x:Static app:Ui.LaptopIntro}" />

        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}" Padding="14,12" Margin="0,0,0,10">
            <RadioButton x:Name="Performance" GroupName="Choice" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="{x:Static app:Ui.LaptopPerformance}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static app:Ui.LaptopPerformanceDetail}" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </Border>
        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}" Padding="14,12" Margin="0,0,0,10">
            <RadioButton x:Name="Everywhere" GroupName="Choice">
                <StackPanel>
                    <TextBlock Text="{x:Static app:Ui.LaptopEverywhere}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static app:Ui.LaptopEverywhereDetail}" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </Border>
        <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}" Padding="14,12" Margin="0,0,0,10">
            <RadioButton x:Name="Battery" GroupName="Choice">
                <StackPanel>
                    <TextBlock Text="{x:Static app:Ui.LaptopBattery}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static app:Ui.LaptopBatteryDetail}" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.Later}" Margin="0,0,8,0" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.Validate}" Padding="16,6" IsDefault="True" Click="OnValidate" />
        </StackPanel>
    </StackPanel>
</Window>
