<Window x:Class="Maus.App.Views.ScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:views="clr-namespace:Maus.App.Views"
        Title="{x:Static app:Ui.ScoreWindowTitle}"
        Width="640" Height="620" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.CloseWindow}" Padding="20,6" HorizontalAlignment="Right"
                    IsCancel="True" IsDefault="True" Click="OnClose" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Page" Margin="28,22,28,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ScoreValue" FontSize="40" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static app:Ui.HealthCaption}" Opacity="{DynamicResource MutedOpacity}" />
                        <TextBlock x:Name="ScoreWord" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,12,0,0" />
                <!-- Score partiel : modules en erreur ou en délai dépassé, qui ne retirent ni n'ajoutent de points. -->
                <Border x:Name="PartialPanel" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" BorderThickness="4,1,1,1" Visibility="Collapsed"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource MausGrey}">
                    <TextBlock x:Name="PartialNote" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{x:Static app:Ui.ScoreLostTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,8" />
                <TextBlock x:Name="NothingLost" Text="{x:Static app:Ui.ScoreNothingLost}" TextWrapping="Wrap" Visibility="Collapsed" />
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:ScoreRow}">
                            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="8" BorderThickness="4,1,1,1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{Binding Brush}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Points}" Width="44" FontSize="15" FontWeight="Bold" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="{DynamicResource MutedOpacity}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CapNote" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Visibility="Collapsed" />

                <TextBlock Text="{x:Static app:Ui.ScoreRulesTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8" />
                <ItemsControl ItemsSource="{x:Static app:Ui.ScoreRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource MausAccent}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
