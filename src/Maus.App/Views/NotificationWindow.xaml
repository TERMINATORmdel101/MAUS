<Window x:Class="Maus.App.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        Title="MAUS" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Topmost="True" ShowActivated="False"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="{x:Static app:Ui.NotificationTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" Margin="0,8,0,14" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SoftButton}" Content="{x:Static app:Ui.Later}" Margin="0,0,8,0" Click="OnLater" />
            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.OpenMaus}" Padding="14,5" IsDefault="True" Click="OnOpen" />
        </StackPanel>
    </StackPanel>
</Window>
