<Window x:Class="Maus.App.Views.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:ws="clr-namespace:Maus.App.ViewModels.Workshop"
        Title="{x:Static app:Ui.MonitorWindowTitle}"
        Width="520" Height="720" MinWidth="400" MinHeight="360"
        WindowStartupLocation="Manual"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Colonnes alignées d'un composant à l'autre : nom, actuelle, minimale, maximale. -->
        <Style x:Key="ValueCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <DockPanel x:Name="Page" Margin="16,14,16,12" Grid.IsSharedSizeScope="True">
        <!-- En-tête : depuis quand, remise à zéro, premier plan -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox DockPanel.Dock="Right" Content="{x:Static app:Ui.MonitorOnTop}" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.MonitorReset}" Command="{Binding ResetCommand}" Padding="12,4" Margin="12,0,0,0" />
            <StackPanel>
                <TextBlock Text="{x:Static app:Ui.MonitorTitle}" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding Since}" FontSize="12" Style="{StaticResource Muted}" />
            </StackPanel>
        </DockPanel>

        <!-- Erreurs depuis l'ouverture -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Banner}" BorderBrush="{Binding HardwareBrush}" Margin="0" ToolTip="{x:Static app:Ui.MonitorHardwareTip}">
                <StackPanel>
                    <TextBlock Text="{x:Static app:Ui.MonitorHardwareErrors}" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding HardwareErrors}" Style="{StaticResource MetricValue}" Foreground="{Binding HardwareBrush}" />
                    <TextBlock Text="{Binding HardwareDetail}" FontSize="12" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Banner}" BorderBrush="{Binding WindowsBrush}" Margin="0" ToolTip="{x:Static app:Ui.MonitorWindowsTip}">
                <StackPanel>
                    <TextBlock Text="{x:Static app:Ui.MonitorWindowsErrors}" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding WindowsErrors}" Style="{StaticResource MetricValue}" Foreground="{Binding WindowsBrush}" />
                    <TextBlock Text="{x:Static app:Ui.MonitorWindowsDetail}" FontSize="12" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </Grid>

        <Expander DockPanel.Dock="Top" Header="{x:Static app:Ui.MonitorEvents}" Margin="0,0,0,8"
                  Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Events}" MaxHeight="200" Margin="0,6,0,0">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ws:WatchedEventViewModel}">
                        <Border BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0" Padding="8,2" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <Run Text="{Binding Time, Mode=OneWay}" /> · <Run Text="{Binding Source, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorsStatus}" FontSize="11" Foreground="{StaticResource MausGold}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Status}" FontSize="11" Style="{StaticResource Muted}" />
        </StackPanel>

        <!-- Mesures par composant -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="4,0,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Min" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Max" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static app:Ui.MonitorSensor}" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="1" Text="{x:Static app:Ui.MonitorCurrent}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{x:Static app:Ui.MonitorMin}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="3" Text="{x:Static app:Ui.MonitorMax}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" Margin="12,0,0,0" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ws:MonitorGroupViewModel}">
                            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Component}" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ws:MonitorRowViewModel}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Min" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Max" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Style="{StaticResource ValueCell}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Min}" Opacity="0.7" Style="{StaticResource ValueCell}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Max}" Opacity="0.7" Style="{StaticResource ValueCell}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
