<Window x:Class="Maus.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:vm="clr-namespace:Maus.App.ViewModels"
        Title="{x:Static app:Ui.SettingsWindowTitle}"
        Width="620" Height="720" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
        <!-- Une option : son titre, son contrôle, une ligne d'explication et la valeur recommandée. -->
        <Style x:Key="OptionNote" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="OptionCard" TargetType="Border" BasedOn="{StaticResource SoftCard}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.CloseWindow}" Padding="20,6" IsCancel="True" IsDefault="True" Click="OnClose" />
                <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.ShowDisclaimer}" Padding="16,6" Margin="0,0,8,0" Click="OnDisclaimer" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MausRed}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <DockPanel x:Name="Page" Margin="24,20,24,0">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.SettingsTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.SettingsIntro}" Style="{StaticResource Muted}" Margin="0,4,0,12" />

            <!-- Trois onglets (0.8.6) : Apparence, Comportement, Droits administrateur ; chaque option dit sa valeur recommandée. -->
            <TabControl Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
                <TabItem Header="{x:Static app:Ui.SettingsTabAppearance}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.ZoomLabel}" Style="{StaticResource CardTitle}" />
                                    <ComboBox ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding Zoom}" DisplayMemberPath="Label"
                                              AutomationProperties.Name="{x:Static app:Ui.ZoomLabel}" />
                                    <TextBlock Text="{x:Static app:Ui.ZoomNote}" Style="{StaticResource OptionNote}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.ThemeLabel}" Style="{StaticResource CardTitle}" />
                                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label"
                                              AutomationProperties.Name="{x:Static app:Ui.ThemeLabel}" />
                                    <TextBlock Text="{x:Static app:Ui.ThemeNote}" Style="{StaticResource OptionNote}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.AccentLabel}" Style="{StaticResource CardTitle}" />
                                    <ListBox ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding Accent}" BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static app:Ui.AccentLabel}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AccentOptionViewModel}">
                                                <DockPanel ToolTip="{Binding Detail}">
                                                    <Grid DockPanel.Dock="Left" Width="36" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse Width="20" Height="20" HorizontalAlignment="Left" Fill="{Binding Primary}"
                                                                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                        <Ellipse Width="20" Height="20" HorizontalAlignment="Right" Fill="{Binding Secondary}"
                                                                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1"
                                                                 Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding Accent.Detail}" Style="{StaticResource OptionNote}"
                                               Visibility="{Binding Accent.HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{x:Static app:Ui.AccentNote}" Style="{StaticResource OptionNote}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.AnimationsTitle}" Style="{StaticResource CardTitle}" />
                                    <ComboBox ItemsSource="{Binding AnimationOptions}" SelectedItem="{Binding Animations}" DisplayMemberPath="Label"
                                              AutomationProperties.Name="{x:Static app:Ui.AnimationsTitle}" />
                                    <TextBlock Text="{x:Static app:Ui.AnimationsNote}" Style="{StaticResource OptionNote}" />
                                    <CheckBox Content="{x:Static app:Ui.HelpTipsOption}" IsChecked="{Binding HelpTips}" Margin="0,10,0,0" AutomationProperties.Name="{x:Static app:Ui.HelpTipsOption}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.HomeLayoutTitle}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static app:Ui.HomeLayoutNote}" Style="{StaticResource OptionNote}" Margin="0,0,0,10" />
                                    <TextBlock Text="{x:Static app:Ui.ShortcutsHint}" Style="{StaticResource OptionNote}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static app:Ui.SettingsTabBehavior}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.RefreshTitle}" Style="{StaticResource CardTitle}" />
                                    <ComboBox ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding Refresh}" DisplayMemberPath="Label"
                                              AutomationProperties.Name="{x:Static app:Ui.RefreshTitle}" />
                                    <TextBlock Text="{x:Static app:Ui.RefreshNote}" Style="{StaticResource OptionNote}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.MonitorTitle}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static app:Ui.MonitorIntro}" Style="{StaticResource OptionNote}" Margin="0,0,0,8" />
                                    <CheckBox Content="{x:Static app:Ui.MonitorOnTop}" IsChecked="{Binding MonitorOnTop}" />
                                    <TextBlock Text="{x:Static app:Ui.MonitorOnTopNote}" Style="{StaticResource OptionNote}" Margin="0,4,0,10" />
                                    <Button Content="{x:Static app:Ui.OpenMonitor}" Command="{Binding OpenMonitorCommand}" HorizontalAlignment="Left" Padding="16,6" />
                                </StackPanel>
                            </Border>

                            <!-- Mode technicien (0.8.6) -->
                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.TechnicianTitle}" Style="{StaticResource CardTitle}" />
                                    <CheckBox Content="{x:Static app:Ui.TechnicianOption}" IsChecked="{Binding TechnicianMode}" />
                                    <TextBlock Text="{x:Static app:Ui.TechnicianNote}" Style="{StaticResource OptionNote}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static app:Ui.OfferAllFeaturesTitle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource OptionCard}" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static app:Ui.OfferAllFeaturesTitle}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static app:Ui.OfferAllFeaturesIntro}" Style="{StaticResource OptionNote}" Margin="0,0,0,10" />
                                    <CheckBox Content="{x:Static app:Ui.OfferAllFeatures}" IsChecked="{Binding OfferAllFeatures}" />
                                    <TextBlock Text="{x:Static app:Ui.OfferAllFeaturesNote}" Style="{StaticResource OptionNote}" Margin="0,4,0,10" />
                                    <CheckBox Content="{x:Static app:Ui.AuditWhenElevatedOption}" IsChecked="{Binding AuditWhenElevated}" />
                                    <TextBlock Text="{x:Static app:Ui.AuditWhenElevatedNote}" Style="{StaticResource OptionNote}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
