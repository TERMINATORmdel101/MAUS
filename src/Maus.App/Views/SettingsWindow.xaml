<Window x:Class="Maus.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        xmlns:vm="clr-namespace:Maus.App.ViewModels"
        Title="{x:Static app:Ui.SettingsWindowTitle}"
        Width="600" Height="720" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.CloseWindow}" Padding="20,6" IsCancel="True" IsDefault="True" Click="OnClose" />
                <Button DockPanel.Dock="Right" Content="{x:Static app:Ui.ShowDisclaimer}" Padding="16,6" Margin="0,0,8,0" Click="OnDisclaimer" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MausRed}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Page" Margin="24,20,24,20">
                <TextBlock Text="{x:Static app:Ui.SettingsTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Static app:Ui.SettingsIntro}" Style="{StaticResource Muted}" Margin="0,4,0,16" />

                <!-- Apparence -->
                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelBlue}" BorderBrush="{DynamicResource PastelBlueStroke}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Ui.AppearanceTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{x:Static app:Ui.ThemeLabel}" Style="{StaticResource SectionLabel}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{x:Static app:Ui.ThemeLabel}" />

                        <TextBlock Text="{x:Static app:Ui.AccentLabel}" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                        <ListBox ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding Accent}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static app:Ui.AccentLabel}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AccentOptionViewModel}">
                                    <DockPanel ToolTip="{Binding Detail}">
                                        <Grid DockPanel.Dock="Left" Width="36" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse Width="20" Height="20" HorizontalAlignment="Left" Fill="{Binding Primary}"
                                                     Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                            <Ellipse Width="20" Height="20" HorizontalAlignment="Right" Fill="{Binding Secondary}"
                                                     Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1"
                                                     Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding Accent.Detail}" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Visibility="{Binding Accent.HasDetail, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Static app:Ui.AccentNote}" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Animations -->
                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelLilac}" BorderBrush="{DynamicResource PastelLilacStroke}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Ui.AnimationsTitle}" Style="{StaticResource CardTitle}" />
                        <ComboBox ItemsSource="{Binding AnimationOptions}" SelectedItem="{Binding Animations}" DisplayMemberPath="Label" Margin="0,6,0,0"
                                  AutomationProperties.Name="{x:Static app:Ui.AnimationsTitle}" />
                        <TextBlock Text="{x:Static app:Ui.AnimationsNote}" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Mesures en direct -->
                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelMint}" BorderBrush="{DynamicResource PastelMintStroke}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Ui.RefreshTitle}" Style="{StaticResource CardTitle}" />
                        <ComboBox ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding Refresh}" DisplayMemberPath="Label" Margin="0,6,0,0"
                                  AutomationProperties.Name="{x:Static app:Ui.RefreshTitle}" />
                        <TextBlock Text="{x:Static app:Ui.RefreshNote}" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Fenêtre de surveillance -->
                <Border Style="{StaticResource SoftCard}" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
                    <StackPanel>
                        <TextBlock Text="{x:Static app:Ui.MonitorTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{x:Static app:Ui.MonitorIntro}" FontSize="12" Style="{StaticResource Muted}" Margin="0,2,0,8" />
                        <CheckBox Content="{x:Static app:Ui.MonitorOnTop}" IsChecked="{Binding MonitorOnTop}" Margin="0,0,0,10" />
                        <Button Content="{x:Static app:Ui.OpenMonitor}" Command="{Binding OpenMonitorCommand}" HorizontalAlignment="Left" Padding="16,6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
