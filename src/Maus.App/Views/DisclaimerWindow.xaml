<Window x:Class="Maus.App.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Maus.App"
        Title="{x:Static app:Ui.DisclaimerTitle}"
        Width="640" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/maus.ico">
    <Window.Resources>
        <!-- Tous les textes de la fenêtre prennent la couleur de texte du thème (blanc en thème sombre), sauf couleur voulue. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource MausText}" />
    </Window.Resources>
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static app:Ui.DisclaimerTitle}" FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="{x:Static app:Ui.CloseWindow}" Padding="16,6" Margin="0,16,0,0"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True" />

        <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0" Background="{DynamicResource PastelSand}" BorderBrush="{DynamicResource PastelSandStroke}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                <ItemsControl Focusable="False" ItemsSource="{x:Static app:Ui.DisclaimerParagraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
