<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:appearance="clr-namespace:Maus.App.Appearance">
    <!-- Couleurs du logo. Les surfaces et le texte suivent le thème Fluent de Windows (clair ou sombre). -->
    <SolidColorBrush x:Key="MausBlue" Color="#1F4FBF" />
    <SolidColorBrush x:Key="MausRed" Color="#C8102E" />
    <SolidColorBrush x:Key="MausGreen" Color="#0A9A5B" />
    <SolidColorBrush x:Key="MausGold" Color="#D49A1E" />
    <!-- Fond du bouton d'arrêt : le rouge du logo, ou la couleur de sélection de Windows en contraste élevé (AppearanceManager). -->
    <SolidColorBrush x:Key="MausDangerFill" Color="#C8102E" />
    <SolidColorBrush x:Key="MausGrey" Color="#8A8F9C" />

    <!-- Couleur d'accentuation (boutons, sélection) : valeurs par défaut, remplacées au démarrage selon les paramètres
         (Appearance/AppearanceManager.cs). Elle ne sert jamais aux couleurs d'état ci-dessus. -->
    <SolidColorBrush x:Key="MausAccent" Color="#1F4FBF" />
    <SolidColorBrush x:Key="MausAccentStrong" Color="#1F4FBF" />
    <SolidColorBrush x:Key="MausAccentSoft" Color="#261F4FBF" />
    <SolidColorBrush x:Key="MausSidebarTint" Color="Transparent" />

    <!-- Opacité des textes secondaires (légendes, détails) : atténués en thème clair, blancs pleins en thème sombre
         (demande du porteur). Remplacée selon le thème par AppearanceManager. -->
    <sys:Double x:Key="MutedOpacity">0.72</sys:Double>

    <!-- Une seule échelle de tailles de texte (0.8.6) : note, petit, courant, intertitre de carte, titre de carte, titre de
         zone, titre de page, valeur mesurée. Toute taille de l'interface renvoie à l'une d'elles. -->
    <sys:Double x:Key="FontSizeNote">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeLead">15</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">20</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeMetric">26</sys:Double>

    <!-- Texte posé sur la couleur d'accentuation (boutons principaux, icônes de navigation) : blanc, ou la couleur de
         sélection de Windows en contraste élevé (AppearanceManager). -->
    <SolidColorBrush x:Key="OnAccentText" Color="White" />

    <!-- Texte d'un contrôle grisé : remplacé selon le thème (Pastel.Apply). -->
    <SolidColorBrush x:Key="MausDisabledText" Color="#5F6470" />

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Couleur de texte du thème, imposée : certaines pages héritaient sinon du noir par défaut de Windows (textes sombres
         en thème sombre, signalés par le porteur). Tous les styles de texte de MAUS en partent. -->
    <Style x:Key="MausText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <!-- Dans un contrôle grisé (case, bouton) : grisé aussi, mais lisible. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MausDisabledText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
        <Setter Property="Opacity" Value="{DynamicResource MutedOpacity}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <!-- Déjà gris : l'atténuer en plus le rendrait illisible. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="{DynamicResource MutedOpacity}" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMetric}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Navigation latérale : une entrée par onglet, surlignée quand elle est choisie. -->
    <!-- Contour de focus bien visible au clavier (0.8.4) : trait de 2 px de la couleur d'accentuation, à 3 px du contrôle. -->
    <Style x:Key="MausFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource MausAccentStrong}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Onglets en pastilles (sous-parties de l'atelier). -->
    <Style x:Key="PillTab" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" CornerRadius="15" Padding="14,5" Margin="0,0,6,0" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="Transparent">
                        <ContentPresenter x:Name="Content" ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MausAccentStrong}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccentStrong}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource OnAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seconde ligne d'onglets (sections d'une entrée de l'atelier) : plus discrète que la première. -->
    <Style x:Key="SubPillTab" TargetType="TabItem" BasedOn="{StaticResource PillTab}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>

    <!-- Carte cliquable (actions rapides de l'accueil) : fond et contour pastel donnés par Background / BorderBrush. -->
    <Style x:Key="ActionCard" TargetType="Button">
        <Setter Property="Padding" Value="16" />
        <Setter Property="appearance:WhyDisabled.Explain" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MausFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Se soulève au survol et s'enfonce à l'appui (coupé avec les animations). -->
        <Setter Property="appearance:Motion.Spotlight" Value="True" />
        <Setter Property="appearance:Motion.HoverGrow" Value="True" />
        <Setter Property="appearance:Motion.PopIcon" Value="True" />
        <Setter Property="appearance:Motion.Press" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <!-- Grisé par le fond, pas par la transparence : le texte reste lisible (4,5:1). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PastelGrey}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PastelGreyStroke}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Choix entre deux vues, en pastilles (« Par importance » / « Par module ») : la vue choisie prend la couleur d'accentuation. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="appearance:WhyDisabled.Explain" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MausFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="15" Padding="16,6" Margin="0,0,8,0" BorderThickness="1"
                            BorderBrush="{DynamicResource PastelGreyStroke}" Background="{DynamicResource PastelGrey}">
                        <ContentPresenter x:Name="Content" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MausAccentStrong}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccentStrong}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource OnAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dépliant discret (« Détails techniques ») : un simple lien avec une flèche, sans le grand cadre du thème Fluent. -->
    <Style x:Key="QuietExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand"
                                      AutomationProperties.Name="{TemplateBinding Header}" HorizontalAlignment="Left" Focusable="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       appearance:Motion.TurnWhen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <ContentPresenter TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextElement.FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="16,4,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pastille ronde de l'icône d'un test (Atelier > Tests), fond = contour pastel de la teinte du test. -->
    <Style x:Key="TestBadge" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Carte pastel : la teinte se donne par Background et BorderBrush (DynamicResource PastelX et PastelXStroke). -->
    <Style x:Key="SoftCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PastelGrey}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PastelGreyStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!-- Tuile d'une famille de tests : un seul choix à la fois, la tuile choisie garde un contour plus marqué. -->
    <Style x:Key="TestTile" TargetType="RadioButton">
        <Setter Property="appearance:WhyDisabled.Explain" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MausFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="appearance:Motion.Spotlight" Value="True" />
        <Setter Property="appearance:Motion.HoverGrow" Value="True" />
        <Setter Property="appearance:Motion.PopIcon" Value="True" />
        <Setter Property="appearance:Motion.Press" Value="True" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccentStrong}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Case de chargement : un reflet la traverse tant qu'elle se voit. -->
    <Style x:Key="Skeleton" TargetType="Border">
        <Setter Property="appearance:Motion.Shimmer" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PastelGrey}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Petit message d'aide au survol (demande du porteur du 1/11/2026) : arrondi, clair, jamais plus large que 320. -->
    <Style TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="10" MaxWidth="320">
                        <Border CornerRadius="10" Background="{DynamicResource ApplicationBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.3" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="10" BorderThickness="1" Padding="12,8" BorderBrush="{DynamicResource MausAccent}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Petite barre qui sépare deux zones d'une page (demande du porteur : pages plus légères, zones bien distinctes). -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="0,16" />
        <Setter Property="Background" Value="{DynamicResource PastelGreyStroke}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Titre d'une zone de page, avec une encre de couleur (Foreground = PastelXInk). -->
    <Style x:Key="ZoneTitle" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLead}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Bouton secondaire arrondi, fond pastel (Background / BorderBrush / Foreground donnés par la page). -->
    <Style x:Key="SoftButton" TargetType="Button">
        <Setter Property="appearance:WhyDisabled.Explain" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MausFocusVisual}" />
        <Setter Property="appearance:Motion.Press" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="{DynamicResource PastelGrey}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PastelGreyStroke}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <!-- Grisé par les couleurs, pas par la transparence : le texte reste lisible (4,5:1). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PastelGrey}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PastelGreyStroke}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource MausDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pastille de comptage (« 3 optimisations ») : fond pastel et encre de la même teinte, posés par la page. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Margin" Value="0,0,6,4" />
    </Style>

    <!-- Bouton principal (bleu du logo) et bouton d'arrêt (rouge). -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="appearance:WhyDisabled.Explain" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MausFocusVisual}" />
        <Setter Property="appearance:Motion.Press" Value="True" />
        <Setter Property="appearance:Motion.Sheen" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
        <Setter Property="Background" Value="{DynamicResource MausAccentStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Sheen" CornerRadius="8" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <!-- Grisé par les couleurs, pas par la transparence : le texte reste lisible (4,5:1). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PastelGrey}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource MausDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource MausDangerFill}" />
    </Style>

    <!-- Petite icône carrée colorée de la navigation (glyphe Segoe Fluent Icons). -->
    <Style x:Key="NavIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentText}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NavIconBox" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Onglet de la barre de gauche : Header = titre, Tag = glyphe, Background = fond de la pastille. -->
    <Style x:Key="NavTab" TargetType="TabItem">
        <Setter Property="appearance:Motion.HoverNudge" Value="True" />
        <Setter Property="appearance:Motion.PopIcon" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MausFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource NavIconBox}" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=TabItem}}">
                            <TextBlock Style="{StaticResource NavIcon}" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        </Border>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Le raccourci s'affiche sur l'entrée seule : posée sur le TabItem, l'infobulle passait aussi sur toute la page qu'il contient. -->
                    <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Margin="0,2" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                            ToolTip="{Binding Path=(AutomationProperties.AcceleratorKey), RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grande icône des cartes d'action. -->
    <Style x:Key="CardIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource MausText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- En-tête de carte : Header = titre, Content = glyphe, Foreground = encre, Tag = fond de la pastille. -->
    <Style x:Key="TestCardHeader" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource TestBadge}" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <TextBlock Style="{StaticResource NavIcon}" FontSize="{StaticResource FontSizeCardTitle}" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton rond à icône (paramètres, fenêtre de surveillance) : le contenu est un glyphe Segoe Fluent Icons. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MausAccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MausAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bandeau d'alerte (bordure gauche colorée). -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="4,1,1,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
</ResourceDictionary>
