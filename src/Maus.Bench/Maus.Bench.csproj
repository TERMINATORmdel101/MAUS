<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Benchmark visuel de MAUS (demande du porteur, 06/10/2026) : environ 8 minutes de carte graphique (scènes calculées
    image par image, DirectX 11 ou DirectX 12 au choix) puis 2 à 3 minutes de processeur (lancer de rayons sur tous les
    cœurs, simulation physique, un seul cœur). Lancé par MAUS.exe avec l'option benchmark, dans un processus séparé :
    un pilote graphique qui plante n'emporte pas MAUS. Vortice (Amer Koleci et contributeurs, licence MIT) donne accès
    à Direct3D 11 et 12, DXGI, Direct2D, DirectWrite et WIC.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Maus.Bench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maus.Core\Maus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- Shaders HLSL, compilés au lancement par le compilateur de Windows (d3dcompiler_47.dll) puis gardés en cache. -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="Maus.Bench.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Shaders\*.hlsli" LogicalName="Maus.Bench.Shaders.%(Filename)%(Extension)" />
    <!-- Logo de MAUS fourni par le porteur (écran de présentation du benchmark). -->
    <EmbeddedResource Include="..\Maus.App\Assets\maus-logo-512.png" LogicalName="Maus.Bench.logo.png" />
  </ItemGroup>

  <!--
    Scène « Matériaux » : modèles, textures et ciel HDR de Poly Haven (polyhaven.com, licence CC0 : utilisation et
    redistribution libres), livrés à côté de MAUS.exe. Liste et auteurs : THIRD-PARTY-NOTICES.md.
  -->
  <ItemGroup>
    <None Include="Assets\PolyHaven\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets\PolyHaven" />
  </ItemGroup>

  <!--
    Test « Galerie des glaces » (lancer de rayons matériel, DirectX Raytracing 1.1) : ses shaders utilisent le modèle 6.5,
    que le compilateur de Windows (d3dcompiler_47) ne connaît pas. Ils sont compilés pendant la fabrication de MAUS par le
    compilateur DXC de Microsoft (paquet NuGet Microsoft.Direct3D.DXC, utilisé comme outil de compilation : il n'est pas
    livré avec MAUS), puis embarqués dans Maus.Bench.dll. Sous Linux (sessions dans le nuage), dxc.exe ne tourne pas :
    le test est alors absent de la version compilée, qui le signale.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Direct3D.DXC" Version="1.9.2609.5" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <DxilShader Include="Shaders\Dxil\raytracing.hlsl" Entry="FullscreenVS" Profile="vs_6_5" ShaderName="raytracing.FullscreenVS" Defines="" />
    <DxilShader Include="Shaders\Dxil\raytracing.hlsl" Entry="TracePS" Profile="ps_6_5" ShaderName="raytracing.TracePS" Defines="" />
    <DxilShader Include="Shaders\Dxil\raytracing.hlsl" Entry="TracePS" Profile="ps_6_5" ShaderName="raytracing.TracePS.light" Defines="-D MAUS_LIGHT=1" />
  </ItemGroup>

  <Target Name="CompileDxilShaders" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'" Inputs="@(DxilShader);Shaders\common.hlsli" Outputs="$(IntermediateOutputPath)dxil\%(DxilShader.ShaderName).dxil">
    <MakeDir Directories="$(IntermediateOutputPath)dxil" />
    <Exec Command="&quot;$(PkgMicrosoft_Direct3D_DXC)\build\native\bin\x64\dxc.exe&quot; -nologo -HV 2018 -Zpr -O3 -Qstrip_debug -Qstrip_reflect -I Shaders %(DxilShader.Defines) -T %(DxilShader.Profile) -E %(DxilShader.Entry) -Fo &quot;$(IntermediateOutputPath)dxil\%(DxilShader.ShaderName).dxil&quot; &quot;%(DxilShader.FullPath)&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="EmbedDxilShaders" AfterTargets="CompileDxilShaders" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <EmbeddedResource Include="@(DxilShader->'$(IntermediateOutputPath)dxil\%(ShaderName).dxil')" LogicalName="Maus.Bench.Dxil.%(DxilShader.ShaderName).dxil" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Maus.Core.Tests" />
  </ItemGroup>

</Project>
