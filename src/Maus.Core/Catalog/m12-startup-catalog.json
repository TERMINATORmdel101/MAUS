    {
      "id": "helpers",
      "label": "Aides logicielles",
      "item": "aide logicielle",
      "advice": "DependsOnUse",
      "loses": "la vérification des mises à jour se fait au lancement de l'application plutôt qu'à l'ouverture de session",
      "recommendation": "À désactiver si vous utilisez ce logiciel de temps en temps seulement."
    },
    {
      "id": "cloud",
      "label": "Cloud et sauvegarde",
      "item": "cloud et sauvegarde",
      "advice": "KeepIfUsed",
      "loses": "la synchronisation et la sauvegarde s'arrêtent : risque de perdre des fichiers récents en cas de panne",
      "recommendation": "À garder si vous utilisez ce service pour vos fichiers. MAUS ne propose pas de le couper par défaut."
    },
    {
      "id": "peripherals",
      "label": "Périphériques",
      "item": "logiciel de périphérique",
      "advice": "DependsOnUse",
      "loses": "les macros, profils, l'éclairage et parfois la gestion des ventilateurs de vos périphériques",
      "recommendation": "Selon votre usage : à garder si vous utilisez des profils, macros ou réglages de ventilation."
    },
    {
      "id": "drivers",
      "label": "Pilotes et système",
      "item": "pilote ou outil système",
      "advice": "Keep",
      "loses": "les touches spéciales, les gestes du pavé tactile, le panneau audio ou les réglages de la carte graphique",
      "recommendation": "À garder : ce composant accompagne un pilote de votre matériel."
    },
    {
      "id": "security",
