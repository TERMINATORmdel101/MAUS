      "id": "messaging",
      "label": "Messagerie",
      "item": "messagerie",
      "advice": "DependsOnUse",
      "loses": "les messages et appels reçus n'arrivent qu'une fois l'application ouverte",
      "recommendation": "À désactiver si vous n'avez pas besoin d'être joignable dès l'ouverture de session."
    },
    {
      "id": "media",
      "label": "Médias",
      "item": "lecteur multimédia",
      "advice": "Disable",
