<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Maus.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalog\*.json" LogicalName="Maus.Core.Catalog.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\i18n\*.json" LogicalName="Maus.Core.Localization.i18n.%(Filename)%(Extension)" />
    <!-- Bannière du logo pour l'en-tête du rapport HTML (tirée du logo du porteur par tools/make-app-images.ps1). -->
    <EmbeddedResource Include="Reporting\maus-report-logo.jpg" LogicalName="Maus.Core.Reporting.maus-report-logo.jpg" />
    <!-- Modules officiels PawnIO.Modules 0.2.11 (LGPL-2.1), dont MAUS n'appelle que les fonctions de lecture : voir THIRD-PARTY-NOTICES.md. -->
    <EmbeddedResource Include="Workshop\Memory\PawnIo\*.bin" LogicalName="Maus.Core.PawnIo.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maus.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
